
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Документ = Параметры.Документ;
	
	ОписаниеОшибки = Справочники.ИСМППрисоединенныеФайлы.ТекстОшибкиИзПротокола(Параметры.Документ);
	
	Если ЗначениеЗаполнено(Параметры.ОписаниеОшибки) Тогда
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			ОписаниеОшибки = ОписаниеОшибки + Символы.ПС;
		КонецЕсли;
		ОписаниеОшибки = ОписаниеОшибки + Параметры.ОписаниеОшибки;
	КонецЕсли;
	
	Операция = Параметры.Операция;
	ЗаполнитьРекомендацииПользователю(ОписаниеОшибки, Операция);
	
	ОбщегоНазначенияСобытияФормИСПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьРекомендацииПользователю(ТекстОшибки, Операция)
	
	НеУказанаСертификация = НСтр("ru = '01: Не заполнено поле ""Вид документа, подтверждающего соответствие'");
	Если СтрНайти(ТекстОшибки, НСтр("ru = '31: Неверно указан тэг EXDA/EXCN'")) > 0 Тогда
		
		Элементы.ОписаниеОшибки.РасширеннаяПодсказка.Заголовок = НСтр(
			"ru = 'В Национальном каталоге в карточке товара указано, что требуется указание срока годности.
			|Поэтому в отчете о нанесении необходимо указать и передать в ГИС МТ срок годности.
			|Если в карточке номенклатуры установлен флаг ""Неограниченный срок годности"",
			|то необходимо отключить данный флаг и заполнить срок годности в документе.'");
		
	ИначеЕсли СтрНайти(ТекстОшибки, НеУказанаСертификация) > 0 Тогда
		
		Элементы.ОписаниеОшибки.РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Рекомендация:
			|Если в документе выбран режим ""Автоматизированная линия"", заполните поле ""Сертификация"" на закладке Товары.
			|Если в документе выбран режим ""Ручное сканирование"", то заполните поле ""Сертификация"" в строке табличной части Товары.'");
		
	ИначеЕсли Операция = ПредопределенноеЗначение("Перечисление.ВидыОперацийИСМП.ВводВОборотИмпортСФТС") Тогда
		НеУказанКодТНВЭД = НСтр("ru = '01: Не заполнено поле ""Код ТН ВЭД ЕАЭС'");
		НеУказанКодСтраныПроисхождения = НСтр("ru = '01: Не заполнено поле ""Код страны происхождения'");
		
		Если СтрНайти(ТекстОшибки, НеУказанКодТНВЭД) > 0
			Или СтрНайти(ТекстОшибки, НеУказанКодСтраныПроисхождения) > 0 Тогда
			
			Элементы.ОписаниеОшибки.РасширеннаяПодсказка.Заголовок = НСтр(
				"ru = 'Возможно, что товары в переданном сообщении относятся к закрытому сегменту ФТС.
				|Включите флаг Закрытый сегмент ФТС, заполните реквизиты (код ТН ВЭД, Страна происхождения) и повторите ввод в оборот'");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
