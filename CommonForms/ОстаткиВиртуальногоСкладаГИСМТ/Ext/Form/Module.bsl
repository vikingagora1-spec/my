
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ЗапроситьОстаткиВиртуальногоСклада();
	КонецЕсли;
	
	УстановитьОтборПоДатеПроизводства();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	ЗаполнитьНачальныеПараметрыПриСоздании();
	НастроитьЭлементыФормыПриСоздании();
	ОбщегоНазначенияСобытияФормИСПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Товары.Очистить();
	ЗапроситьОстаткиВиртуальногоСклада();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПроизводстваПриИзменении(Элемент)
	
	УстановитьОтборПоДатеПроизводства();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОчиститьСообщения();
	
	Если ОбщегоНазначенияИСКлиент.ВыборСтрокиСпискаКорректен(Элементы.Товары, Истина) Тогда
		ТекущиеДанные = Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
		Если Не ЗначениеЗаполнено(ТекущиеДанные.НомерПартии) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Невозможно выбрать строку без номера партии'"));
			Возврат;
		КонецЕсли;
		СтандартнаяОбработка = Ложь;
		ОповеститьОВыборе(ИнтеграцияИСМПКлиент.РезультатВыбораСтрокиОстаткаВиртуальногоСклада(ТекущиеДанные));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапроситьОстатки(Команда)
	ЗапроситьОстаткиВиртуальногоСклада();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапроситьОстаткиВиртуальногоСклада()
	
	ОчиститьСообщения();
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапросаДанных = Новый Структура("GTIN");
	Если ТипЗнч(GTIN) = Тип("Строка")
		И ЗначениеЗаполнено(GTIN) Тогда
		ПараметрыЗапросаДанных.GTIN = Новый Массив();
		ПараметрыЗапросаДанных.GTIN.Добавить(GTIN);
	ИначеЕсли ТипЗнч(GTIN) = Тип("Массив") Тогда
		ПараметрыЗапросаДанных.GTIN = GTIN;
	КонецЕсли;
	ПараметрыЗапроса = ИнтерфейсИСМПОбщегоНазначенияКлиент.ПараметрыЗапросаДанных();
	ПараметрыЗапроса.Организация             = Организация;
	ПараметрыЗапроса.УникальныйИдентификатор = УникальныйИдентификатор;
	ПараметрыЗапроса.Параметры               = ПараметрыЗапросаДанных;
	ПараметрыЗапроса.ОповещениеОЗавершении   = Новый ОписаниеОповещения(
		"ОстаткиВиртуальногоСкладаЗавершение", ЭтотОбъект);
	
	ИнтеграцияИСМПКлиент.ОстаткиВиртуальногоСклада(ПараметрыЗапроса);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоДатеПроизводства()
	
	Если ЗначениеЗаполнено(ДатаПроизводства) Тогда
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура("ДатаПроизводства", ДатаПроизводства);
	Иначе
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиВиртуальногоСкладаЗавершение(ДанныеРезультата, ДополнительныеПараметры) Экспорт
	
	Если ДанныеРезультата = Неопределено Тогда
		Возврат;
	ИначеЕсли ДанныеРезультата.ОтказОтАвторизации Тогда
		Возврат;
	ИначеЕсли ДанныеРезультата.ЕстьОшибки Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ДанныеРезультата.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеРезультата.Результат.ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ДанныеРезультата.Результат.ТекстОшибки);
	КонецЕсли;
	
	Товары.Очистить();
	НомерСтроки = 1;
	Для Каждого СтрокаДанных Из ДанныеРезультата.Результат.ОстаткиПоGTIN Цикл
		
		ДлинаНомераПартии = СтрДлина(СтрокаДанных.НомерПартии);
		Если Не РазборКодаМаркировкиИСМПСлужебныйКлиентСервер.СоответствуетПартионномуКодуПоДлине(ДлинаНомераПартии) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		НоваяСтрока.НомерСтроки = НомерСтроки;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	ОстаткиВиртуальногоСкладаЗавершениеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОстаткиВиртуальногоСкладаЗавершениеНаСервере()
	
	ИнтеграцияИСПереопределяемый.ЗаполнитьСлужебныеРеквизитыВКоллекции(ЭтотОбъект, Товары);
	
	Для Каждого СтрокаТаблицы Из Товары Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерПартии) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеРазбора = РазборКодаМаркировкиИСМПСлужебныйКлиентСервер.ДанныеРазбораПартионногоКода(
			СтрокаТаблицы.НомерПартии);
		Если Не ДанныеРазбора.Разобран Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.ДатаПроизводства = ДанныеРазбора.ДатаПроизводства;
		
	КонецЦикла;
	
	Товары.Сортировать("GTIN,ДатаПроизводства");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	СобытияФормИСПереопределяемый.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект,, "Товары.ХарактеристикиИспользуются");
	
	//
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыНоменклатура.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(Элементы.ТоварыНоменклатура.ПутьКДанным);
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Товары.ПредставлениеСопоставления");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<не сопоставлено>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаНеТребуетВниманияГосИС);
	
	//
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТоварыНоменклатура.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(Элементы.ТоварыНоменклатура.ПутьКДанным);
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Товары.ПредставлениеСопоставления");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст",      Новый ПолеКомпоновкиДанных("Товары.ПредставлениеСопоставления"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаНеТребуетВниманияГосИС);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачальныеПараметрыПриСоздании()
	
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.GTIN) Тогда
		GTIN = Параметры.GTIN;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ДатаПроизводства) Тогда
		ДатаПроизводства = Параметры.ДатаПроизводства;
	КонецЕсли;
	
	РежимВыбора = Параметры.РежимВыбора;
	Элементы.Товары.РежимВыбора = РежимВыбора;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормыПриСоздании()
	
	ХарактеристикиИспользуются              = ОбщегоНазначенияИС.ХарактеристикиИспользуются();
	Элементы.ТоварыХарактеристика.Видимость = ХарактеристикиИспользуются;
	
	Если ЗначениеЗаполнено(ДатаПроизводства) Тогда
		Элементы.ДатаПроизводства.ТолькоПросмотр = Истина;
		Элементы.ДатаПроизводства.КнопкаОчистки  = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти