#Область СлужебныеПроцедурыИФункции

Функция ИспользуетсяРаботаСНомерамиПартийИСМП() Экспорт
	
	Если Не ОбщегоНазначенияИС.ПодсистемаСуществует("ИСМП")
		Или Не ОбщегоНазначенияИС.ПодсистемаИспользуется("ИСМП") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульКонструкторИСОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("КонструкторИСОбщегоНазначенияКлиентСервер");
	Возврат МодульКонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииПартионногоУчета().Количество() > 0;
	
КонецФункции

Функция ОрганизацияПоХозяйствующемуСубъекту(ХозяйствующийСубъект) Экспорт
	
	ПредставленияСопоставлений = ИнтеграцияВЕТИСВызовСервера.ПредставленияСопоставлений(ХозяйствующийСубъект);
	Организация = Неопределено;
	Если ТипЗнч(ПредставленияСопоставлений.КонтрагентХозяйствующегоСубъекта.Ссылка) = Тип("СписокЗначений") Тогда
		Для Каждого ЭлементСпискаЗначений Из ПредставленияСопоставлений.КонтрагентХозяйствующегоСубъекта.Ссылка Цикл
			Если ЗначениеЗаполнено(ЭлементСпискаЗначений.Значение) Тогда
				Организация = ЭлементСпискаЗначений.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

Функция ДанныеДляЗаполненияИдентификаторовПартий(Объект) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Организация");
	ВозвращаемоеЗначение.Вставить("Товары", Новый Массив());
	ВозвращаемоеЗначение.Организация = ОрганизацияПоХозяйствующемуСубъекту(Объект.ХозяйствующийСубъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура                  КАК Номенклатура,
		|	Товары.Характеристика                КАК Характеристика,
		|	Товары.Серия                         КАК Серия,
		|	Товары.Продукция                     КАК Продукция,
		|	Товары.ДатаПроизводстваНачалоПериода КАК ДатаПроизводства,
		|	Товары.ИдентификаторПартии           КАК НомерПартии,
		|	Товары.КлючСтроки                    КАК КлючСтроки
		|ПОМЕСТИТЬ Товары
		|ИЗ
		|	&Товары КАК Товары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.Номенклатура                 КАК Номенклатура,
		|	Товары.Характеристика               КАК Характеристика,
		|	Товары.Серия                        КАК Серия,
		|	Товары.НомерПартии                  КАК НомерПартии,
		|	Товары.ДатаПроизводства             КАК ДатаПроизводства,
		|	Товары.КлючСтроки                   КАК КлючСтроки,
		|	ЕСТЬNULL(ПродукцияВЕТИС.GTIN, """") КАК GTIN
		|ИЗ
		|	Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераПартийГИСМТ КАК НомераПартийГИСМТ
		|		ПО Товары.НомерПартии = НомераПартийГИСМТ.НомерПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПродукцияВЕТИС КАК ПродукцияВЕТИС
		|		ПО Товары.Продукция = ПродукцияВЕТИС.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО Товары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|		И ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииГИСМТ В (&ВидыПродукцииПартионногоУчета)
		|ГДЕ
		|	НомераПартийГИСМТ.НомерПартии ЕСТЬ NULL";
	
	Товары = Объект.Товары.Выгрузить();
	Товары.Колонки.Добавить("КлючСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.КлючСтроки = ИндексСтроки;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("ВидыПродукцииПартионногоУчета", КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииПартионногоУчета());
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ПроверяемыеGTIN  = Новый Массив;
	СоответствиеEAN  = Новый Соответствие;
	СоответствиеGTIN = Новый Соответствие;
	
	ШтрихкодированиеИСПереопределяемый.ЗаполнитьПроверяемыеGTIN(Результат, ПроверяемыеGTIN, СоответствиеEAN);
	
	Для Каждого КлючИЗначение Из СоответствиеEAN Цикл
		СоответствиеGTIN.Вставить(
			ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(КлючИЗначение.Ключ),
			КлючИЗначение.Значение);
	КонецЦикла;
	
	Для Каждого СтрокаТовары Из Результат Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТовары.GTIN) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовары.GTIN = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.GTINПоШтрихкодуEAN(СтрокаТовары.GTIN);
		
		НайденоеСоответствие = СоответствиеGTIN[СтрокаТовары.GTIN];
		
		Если НайденоеСоответствие = Неопределено
			Или НайденоеСоответствие.Номенклатура <> СтрокаТовары.Номенклатура
			Или НайденоеСоответствие.Характеристика <> СтрокаТовары.Характеристика Тогда
			СтрокаТовары.GTIN = "";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТовары Из Результат Цикл
		
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("Номенклатура",     СтрокаТовары.Номенклатура);
		ДанныеСтроки.Вставить("Характеристика",   СтрокаТовары.Характеристика);
		ДанныеСтроки.Вставить("Серия",            СтрокаТовары.Серия);
		ДанныеСтроки.Вставить("ДатаПроизводства", СтрокаТовары.ДатаПроизводства);
		ДанныеСтроки.Вставить("НомерПартии",      СтрокаТовары.НомерПартии);
		ДанныеСтроки.Вставить("GTIN",             СтрокаТовары.GTIN);
		ДанныеСтроки.Вставить("КлючСтроки",       СтрокаТовары.КлючСтроки);
		ВозвращаемоеЗначение.Товары.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Процедура ЗаполнитьИдентификаторыПартийПоРеквизитамСерий(Объект, Товары) Экспорт
	
	Если Не ОбщегоНазначенияИС.ПодсистемаСуществует("ИСМП")
		Или Не ОбщегоНазначенияИС.ПодсистемаИспользуется("ИСМП") Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ОрганизацияПоХозяйствующемуСубъекту(Объект.ХозяйствующийСубъект);
	Если Организация = Неопределено Тогда
		Организация = ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("Организация");
	КонецЕсли;
	
	МодульИнтеграцияИСМП = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияИСМП");
	ПараметрыФормирования = МодульИнтеграцияИСМП.ПараметрыЗаполненияДанныхПоРеквизитамСерий();
	ПараметрыФормирования.Организация             = Организация;
	ПараметрыФормирования.Товары                  = Товары;
	ПараметрыФормирования.ИмяПоляНомерПартии      = "ИдентификаторПартии";
	ПараметрыФормирования.ИмяПоляСрокГодности     = "СрокГодностиНачалоПериода";
	ПараметрыФормирования.ИмяПоляДатаПроизводства = "ДатаПроизводстваНачалоПериода";
	МодульИнтеграцияИСМП.ЗаполнитьДанныеПоРеквизитамСерий(ПараметрыФормирования);
	
КонецПроцедуры

// Определяет, нужно ли заполнять номера производственных партий для документа:
// наличие табличной части "ШтрихкодыУпаковок" с реквизитом "НомерПартии" и заполненных номеров партий в её строках.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - ссылка на документ.
//
// Возвращаемое значение:
//  Булево - Истина, если в строках табличной части "ШтрихкодыУпаковок" есть номера партий.
//
Функция ДокументСодержитНомераПартий(ДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	ТабличнаяЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти("ШтрихкодыУпаковок");
	Если ТабличнаяЧасть = Неопределено
		Или ТабличнаяЧасть.Реквизиты.Найти("НомерПартии") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ШтрихкодыУпаковок.НомерПартии КАК НомерПартии
		|ИЗ
		|	" + МетаданныеДокумента.ПолноеИмя() + ".ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
		|ГДЕ
		|	ШтрихкодыУпаковок.Ссылка = &ДокументСсылка
		|	И ШтрихкодыУпаковок.НомерПартии <> НЕОПРЕДЕЛЕНО
		|	И ШтрихкодыУпаковок.НомерПартии <> """"";
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Формирует таблицу производственных партий продукции документа для подбора записей складского журнала.
// Номер партии определяется по данным дерева упаковок (реквизит НомерПартии табличной части "Штрихкоды упаковок").
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, содержащий номера партий в табличной части "ШтрихкодыУпаковок".
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица партий, проиндексированная по колонкам "Номенклатура, Характеристика, Серия":
//   * Номенклатура   - ОпределяемыйТип.Номенклатура - номенклатура.
//   * ВидПродукции   - СправочникСсылка.КлючиВидовПродукцииИС - вид продукции номенклатуры.
//   * ДатаНачалаПартионногоУчета - Дата - дата начала партионного учёта вида продукции номенклатуры.
//   * Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатуры - характеристика.
//   * Серия          - ОпределяемыйТип.СерияНоменклатуры - серия номенклатуры.
//   * НомерПартии    - ОпределяемыйТип.УникальныйИдентификаторИС - номер партии ГИС МТ.
//   * Количество     - Число - количество единиц продукции по партии.
//   * Заполнено      - Число - количество продукции по партии, уже подобранное в документе.
//
Функция ПартииДокументаОснованияДляПодбораЗаписейЖурнала(ДокументСсылка) Экспорт
	
	ТаблицаПартий = Новый ТаблицаЗначений;
	ТаблицаПартий.Колонки.Добавить("Номенклатура",   Метаданные.ОпределяемыеТипы.Номенклатура.Тип);
	ТаблицаПартий.Колонки.Добавить("ВидПродукции",   Новый ОписаниеТипов("СправочникСсылка.КлючиВидовПродукцииИС"));
	ТаблицаПартий.Колонки.Добавить("ДатаНачалаПартионногоУчета", Новый ОписаниеТипов("Дата"));
	ТаблицаПартий.Колонки.Добавить("Характеристика", Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип);
	ТаблицаПартий.Колонки.Добавить("Серия",          Метаданные.ОпределяемыеТипы.СерияНоменклатуры.Тип);
	ТаблицаПартий.Колонки.Добавить("НомерПартии",    Метаданные.ОпределяемыеТипы.УникальныйИдентификаторИС.Тип);
	ТаблицаПартий.Колонки.Добавить("Количество",     ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ТаблицаПартий.Колонки.Добавить("Заполнено",      ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ТаблицаПартий;
	КонецЕсли;
	
	ПараметрыСканирования = ШтрихкодированиеОбщегоНазначенияИС.ПараметрыСканирования(ДокументСсылка);
	Результат = ШтрихкодированиеИС.ВложенныеШтрихкодыУпаковокПоДокументу(ДокументСсылка, , , Истина, ПараметрыСканирования);
	
	Для Каждого СтрокаДерева Из Результат.ВложенныеШтрихкоды.ДеревоУпаковок.Строки Цикл
		ДобавитьПартииИзСтрокиДереваУпаковок(ТаблицаПартий, СтрокаДерева);
	КонецЦикла;
	
	// ВидПродукции и ДатаНачалаПартионногоУчета перечислены в группировке, а Заполнено - в списке агрегатов:
	// колонки, не вошедшие ни в один из списков, метод Свернуть удаляет.
	ТаблицаПартий.Свернуть("Номенклатура, ВидПродукции, ДатаНачалаПартионногоУчета, Характеристика, Серия, НомерПартии", "Количество, Заполнено");
	УдалитьНеподконтрольнуюВЕТИСНоменклатуру(ТаблицаПартий);
	ТаблицаПартий.Индексы.Добавить("Номенклатура, Характеристика, Серия");
	
	Возврат ТаблицаПартий;
	
КонецФункции

// Удаляет из таблицы партий строки номенклатуры, не подконтрольной ВетИС, и заполняет по описанию
// номенклатуры ИС колонки ВидПродукции и ДатаНачалаПартионногоУчета.
//
// Параметры:
//  ТаблицаПартий - ТаблицаЗначений - таблица партий.
//
Процедура УдалитьНеподконтрольнуюВЕТИСНоменклатуру(ТаблицаПартий)
	
	Если ТаблицаПартий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(ТаблицаПартий.ВыгрузитьКолонку("Номенклатура"));
	
	Для Индекс = ТаблицаПартий.Количество() - 1 По 0 Цикл
		
		СтрокаПартии = ТаблицаПартий[Индекс];
		
		ДанныеНоменклатуры = ОписаниеНоменклатуры.Получить(СтрокаПартии.Номенклатура);
		ВидПродукции = ?(ДанныеНоменклатуры = Неопределено, Неопределено, ДанныеНоменклатуры.КлючВидовПродукции);
		
		Если Не КонструкторИСМПОбщегоНазначенияКлиентСервер.ЭтоПродукцияВЕТИС(ВидПродукции)
			Или Не КонструкторИСМПКлиентСервер.ЭтоПродукцияПартионногоУчетаГИСМТ(ВидПродукции) Тогда
			ТаблицаПартий.Удалить(СтрокаПартии);
			Продолжить;
		КонецЕсли;
		
		СтрокаПартии.ВидПродукции = ВидПродукции;
		СтрокаПартии.ДатаНачалаПартионногоУчета = КонструкторИСМПОбщегоНазначенияКлиентСервер.ДатаНачалаПартионногоУчета(ВидПродукции);
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в таблицу партий данные строки дерева упаковок.
// Если в строке заполнен номер партии, берётся её количество, иначе выполняется спуск по дереву.
//
// Параметры:
//  ТаблицаПартий - ТаблицаЗначений - заполняемая таблица партий.
//  СтрокаДерева  - СтрокаДереваЗначений - обрабатываемая строка дерева упаковок.
//
Процедура ДобавитьПартииИзСтрокиДереваУпаковок(ТаблицаПартий, СтрокаДерева)
	
	Если ЗначениеЗаполнено(СтрокаДерева.НомерПартии) Тогда
		
		НоваяСтрока = ТаблицаПартий.Добавить();
		НоваяСтрока.Номенклатура   = СтрокаДерева.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаДерева.Характеристика;
		НоваяСтрока.Серия          = СтрокаДерева.Серия;
		НоваяСтрока.НомерПартии    = СтрокаДерева.НомерПартии;
		НоваяСтрока.Количество     = СтрокаДерева.Количество;
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
		ДобавитьПартииИзСтрокиДереваУпаковок(ТаблицаПартий, ПодчиненнаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет параметры выбора серий номером партии по идентификатору партии из строки таблицы.
// Выполняется только для продукции партионного учета ГИС МТ при включенной работе с номерами партий ИСМП.
//
// Параметры:
//   ПараметрыВыбораСерий - Структура - параметры выбора серий, в которые записывается номер партии
//   СтрокаТаблицы - СтрокаТаблицыЗначений - строка таблицы с номенклатурой и идентификатором партии
Процедура ЗаполнитьПараметрыВыбораСерийПоИдентификаторуПартии(ПараметрыВыбораСерий, СтрокаТаблицы) Экспорт
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторПартии)
		Или Не ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура)
		Или Не ИспользуетсяРаботаСНомерамиПартийИСМП() Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(СтрокаТаблицы.Номенклатура)[СтрокаТаблицы.Номенклатура];
	
	МодульКонструкторИСМПКлиентСервер = ОбщегоНазначения.ОбщийМодуль("КонструкторИСМПКлиентСервер");
	Если Не МодульКонструкторИСМПКлиентСервер.ЭтоПродукцияПартионногоУчетаГИСМТ(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
		Возврат;
	КонецЕсли;
	
	МодульРазборКодаМаркировкиИСМПСлужебныйКлиентСервер = ОбщегоНазначения.ОбщийМодуль("РазборКодаМаркировкиИСМПСлужебныйКлиентСервер");
	ДанныеРазбора = МодульРазборКодаМаркировкиИСМПСлужебныйКлиентСервер.ДанныеРазбораПартионногоКода(СтрокаТаблицы.ИдентификаторПартии);
	
	Если Не ДанныеРазбора.Разобран Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыбораСерий.НомерПартии = СтрокаТаблицы.ИдентификаторПартии;
	
КонецПроцедуры

#КонецОбласти
