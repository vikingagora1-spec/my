#Область СлужебныеПроцедурыИФункции

#Область ВыборНомераПартииГИСМТ

// Товары номер партии начало выбора.
// 
// Параметры:
//  Форма   - ФормаКлиентскогоПриложения
//  Элемент - ЭлементыФормы
//  СтандартнаяОбработка - Булево
Процедура ТоварыНомерПартииНачалоВыбора(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	Если Не ИспользуетсяРаботаСНомерамиПартийИСМП() Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Объект        = Форма.Объект;
	Элементы      = Форма.Элементы;
	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	МодульИнтеграцияИСМПКлиент         = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиент");
	ПараметрыОткрытия                  = МодульИнтеграцияИСМПКлиент.ПараметрыОткрытияФормыВыбораНомеровПартий();
	ПараметрыОткрытия.Организация      = ОрганизацияПоХозяйствующемуСубъекту(Объект.ХозяйствующийСубъект);
	ПараметрыОткрытия.Номенклатура     = ТекущиеДанные.Номенклатура;
	ПараметрыОткрытия.Характеристика   = ТекущиеДанные.Характеристика;
	ПараметрыОткрытия.Серия            = ТекущиеДанные.Серия;
	ПараметрыОткрытия.ДатаПроизводства = ТекущиеДанные.ДатаПроизводстваНачалоПериода;
	
	МодульИнтеграцияИСМПКлиент.ОткрытьФормуВыбораНомераПартии(ПараметрыОткрытия, Элемент, Форма);
	
КонецПроцедуры

#КонецОбласти

Функция ИспользуетсяРаботаСНомерамиПартийИСМП() Экспорт
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("ГосИС.ИСМП") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульКонструкторИСОбщегоНазначенияКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("КонструкторИСОбщегоНазначенияКлиентСервер");
	Возврат МодульКонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииПартионногоУчета().Количество() > 0;
	
КонецФункции

// Заполнить номер партии в товарах. Выполняет генерацию номера партии при необходимости.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Данные - Структура:
//           * Организация - ОпределяемыйТип.Организация
//           * Товары - Массив из Структура
Процедура ЗаполнитьИдентификаторыПартийПоТоварам(Форма, Данные) Экспорт
	
	МодульИнтеграцияИСМПКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиент");
	МодульИнтеграцияИСМПКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияИСМПКлиентСервер");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ПараметрыОткрытия = МодульИнтеграцияИСМПКлиент.ПараметрыОткрытияФормыРезервированияНомеровПартий();
	ПараметрыОткрытия.РедактироватьТовары = Ложь;
	ПараметрыОткрытия.Организация = Данные.Организация;
	ПараметрыОткрытия.ОповещениеОЗакрытии = Новый ОписаниеОповещения(
		"ЗаполнениеИдентификаторовПартийПоТоварамЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Для Каждого СтрокаТовары Из Данные.Товары Цикл
		ДанныеСтроки = МодульИнтеграцияИСМПКлиентСервер.НоваяСтрокаТоварыПараметровОткрытияФормыРезервированияНомеровПартий();
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТовары);
		ПараметрыОткрытия.Товары.Добавить(ДанныеСтроки);
	КонецЦикла;
	
	МодульИнтеграцияИСМПКлиент.ОткрытьФормуРезервированияНомеровПартий(ПараметрыОткрытия, Форма);
	
КонецПроцедуры

Процедура ЗаполнениеИдентификаторовПартийПоТоварамЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект = ДополнительныеПараметры.Форма.Объект;
	
	Для Каждого СтрокаТаблицы Из Результат.НомераПартий Цикл
		
		Если СтрокаТаблицы.КлючСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовары = Объект.Товары[СтрокаТаблицы.КлючСтроки];
		СтрокаТовары.ИдентификаторПартии = СтрокаТаблицы.НомерПартии;
		
	КонецЦикла;
	
	ДополнительныеПараметры.Форма.Модифицированность = Истина;
	
КонецПроцедуры

Функция ОрганизацияПоХозяйствующемуСубъекту(ХозяйствующийСубъект)
	
	ПредставленияСопоставлений = ИнтеграцияВЕТИСВызовСервера.ПредставленияСопоставлений(ХозяйствующийСубъект);
	Организация = Неопределено;
	Если ТипЗнч(ПредставленияСопоставлений.КонтрагентХозяйствующегоСубъекта.Ссылка) = Тип("СписокЗначений") Тогда
		Для Каждого ЭлементСпискаЗначений Из ПредставленияСопоставлений.КонтрагентХозяйствующегоСубъекта.Ссылка Цикл
			Если ЗначениеЗаполнено(ЭлементСпискаЗначений.Значение) Тогда
				Организация = ЭлементСпискаЗначений.Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

#КонецОбласти