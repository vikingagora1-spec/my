#Область СлужебныйПрограммныйИнтерфейс

// Возвращает результат проверки статуса места осуществления деятельности (МОД) в ГИС МТ.
//
// Параметры:
//   ПараметрыПроверки - см. МестаОсуществленияДеятельностиИСМП.ПараметрыПроверкиСтатусаМОД
//
// Возвращаемое значение:
//   Структура:
//     * СтатусПроверки - ФорматированнаяСтрока, Строка - содержит представление результат проверки статуса МОД
//     * ЦветФона - Неопределено
//
Функция СтатусПроверкиМОД(ПараметрыПроверки) Экспорт
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("СтатусПроверки", "");
	РезультатПроверки.Вставить("ЦветФона",       Неопределено);
	
	Если ПараметрыПроверки.ИспользуетсяМОД Тогда
		ПроверкаНеВыполнялась = Истина;
		МОДЗарегистрирован    = Ложь;
		ДоступнаРегистрация   = Ложь;

		Если ПараметрыПроверки.ВыбранДоступныйМОД Тогда
			МОДЗарегистрирован    = Истина;
			ПроверкаНеВыполнялась = Ложь;

		Иначе
			Если ЗначениеЗаполнено(ПараметрыПроверки.Организация) И ЗначениеЗаполнено(ПараметрыПроверки.ТоварнаяГруппа) Тогда
				ДоступнаРегистрация = ДоступнаРегистрацияМОДВГИСМТ(ПараметрыПроверки.ТоварнаяГруппа);
				ПроверкаДоступна    = Истина;

				КодФИАСОтбор = "";
				Если ЗначениеЗаполнено(ПараметрыПроверки.КодФИАС) Тогда
					КодФИАСОтбор = ПараметрыПроверки.КодФИАС;
				ИначеЕсли ЗначениеЗаполнено(ПараметрыПроверки.ДанныеАдреса) Тогда
					ИдентификаторАдреса = ОбщегоНазначенияИСМП.ИдентификаторФИАСПоДаннымАдреса(ПараметрыПроверки.ДанныеАдреса).Идентификатор;
					Если ИдентификаторАдреса <> Неопределено Тогда
						КодФИАСОтбор = ИдентификаторАдреса;
					КонецЕсли;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(ПараметрыПроверки.КПП) И Не ЗначениеЗаполнено(КодФИАСОтбор) Тогда
					ПроверкаДоступна = Ложь;
				ИначеЕсли ПараметрыПроверки.ПоискПоФИАС И Не ЗначениеЗаполнено(КодФИАСОтбор) Тогда
					ПроверкаДоступна = Ложь;
				КонецЕсли;

				Если ПроверкаДоступна Тогда
					ПроверкаНеВыполнялась = Ложь;

					СписокМОД = РегистрыСведений.МестаОсуществленияДеятельностиИСМП.СписокЗарегистрированныхМестОсуществленияДеятельности(
						ПараметрыПроверки.Организация, ПараметрыПроверки.ТоварнаяГруппа, ПараметрыПроверки.КПП,
						КодФИАСОтбор);

					Если СписокМОД.Количество() > 0 Тогда
						МОДЗарегистрирован = Истина;
					КонецЕсли;

				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

		Гиперссылка = Неопределено;

		Если ПроверкаНеВыполнялась Тогда
			ТекстСтатуса = НСтр("ru = 'Не проверен в ГИС МТ'");
			ЦветТекста   = ЦветаСтиля.ЦветГиперссылкиГосИС;
		ИначеЕсли МОДЗарегистрирован Тогда
			ТекстСтатуса = НСтр("ru = 'Проверен в ГИС МТ'");
			ЦветТекста   = ЦветаСтиля.ЦветГиперссылкиГосИС;
		ИначеЕсли Не ДоступнаРегистрация Тогда
			ТекстСтатуса = НСтр("ru = 'Отсутствует в ГИС МТ'");
			ЦветТекста   = ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС;
		Иначе
			ТекстСтатуса = НСтр("ru = 'Зарегистрировать в ГИС МТ'");
			ЦветТекста   = ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС;
			Гиперссылка  = "ЗарегистрироватьМОД";
		КонецЕсли;

		МассивСтатусаПроверкиМОД = Новый Массив;
		МассивСтатусаПроверкиМОД.Добавить(ТекстСтатуса);

		РезультатПроверки.СтатусПроверки = Новый ФорматированнаяСтрока(МассивСтатусаПроверкиМОД, , ЦветТекста, ,
			Гиперссылка);

	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции

// Возвращает структуру параметров для проверки статуса места осуществления деятельности (МОД) ИСМП
//
// Возвращаемое значение:
//   Структура:
//     * Организация - ОпределяемыйТип.ОрганизацияКонтрагентГосИС, Неопределено - организация для проверки
//     * ТоварнаяГруппа - СправочникСсылка.ТоварныеГруппыГИСМТ - товарная группа для проверки
//     * ИспользуетсяМОД - Булево - признак использования МОД
//     * ВыбранДоступныйМОД - Булево - признак выбора доступного МОД
//     * ПоискПоФИАС - Булево - признак поиска по ФИАС
//     * КПП - Строка - КПП организации
//     * ДанныеАдреса - Строка - данные адреса
//     * КодФИАС - Строка - код ФИАС адреса
//
Функция ПараметрыПроверкиСтатусаМОД() Экспорт
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("Организация",        Неопределено);
	ПараметрыПроверки.Вставить("ТоварнаяГруппа",     Справочники.ТоварныеГруппыГИСМТ.ПустаяСсылка());
	ПараметрыПроверки.Вставить("ИспользуетсяМОД",    Ложь);
	ПараметрыПроверки.Вставить("ВыбранДоступныйМОД", Ложь);
	ПараметрыПроверки.Вставить("ПоискПоФИАС",        Ложь);
	ПараметрыПроверки.Вставить("КПП",                "");
	ПараметрыПроверки.Вставить("ДанныеАдреса",       "");
	ПараметрыПроверки.Вставить("КодФИАС",            "");
	
	Возврат ПараметрыПроверки;
	
Конецфункции

// Возвращает список мест осуществления деятельности для выбора в форме.
//
// Параметры:
//   Организация       - СправочникСсылка.Организации - организация
//   ТоварнаяГруппа    - СправочникСсылка.ТоварныеГруппыГИСМТ - товарная группа
//   ПодразделениеКПП  - Строка - подразделение для КПП
//   ВыполнятьПроверку - Булево - Истина, возвращаются корректные адреса
//
// Возвращаемое значение:
//   СписокЗначений из Структура:
//     * ДанныеАдреса - Строка - данные адреса
//     * ПредставлениеАдреса - Строка - представление адреса
//     * КодФИАС - Строка - код ФИАС адреса
//     * Действие - Строка - действие для выбора: "ЗаполнитьАдрес" или "ОткрытьСписокМОД"
Функция ДоступныеАдресаМестОсуществленияДеятельности(Организация, ТоварнаяГруппа, ПодразделениеКПП, ВыполнятьПроверку=Ложь) Экспорт
	
	КоличествоМОДВСписке  = 3;
	ПодразделениеКППОтбор = "";
	СписокДоступныхМОД    = Новый СписокЗначений();

	Если Не КонструкторИСМПКлиентСервер.ЭтоСырьеГИСМТ(ТоварнаяГруппа) Тогда
		ПодразделениеКППОтбор = ПодразделениеКПП;
	КонецЕсли;

	СписокМОД = РегистрыСведений.МестаОсуществленияДеятельностиИСМП.СписокЗарегистрированныхМестОсуществленияДеятельности(
			Организация, ТоварнаяГруппа, ПодразделениеКППОтбор, , КоличествоМОДВСписке, ВыполнятьПроверку);

	Для Каждого ДанныеМОД Из СписокМОД Цикл
		Если ЗначениеЗаполнено(ДанныеМОД.ПредставлениеАдреса) Тогда
			ДанныеПодбора = Новый Структура;

			ДанныеПодбора.Вставить("ДанныеАдреса",        ДанныеМОД.ДанныеАдреса);
			ДанныеПодбора.Вставить("ПредставлениеАдреса", ДанныеМОД.ПредставлениеАдреса);
			ДанныеПодбора.Вставить("КодФИАС",             ДанныеМОД.КодФИАС);
			ДанныеПодбора.Вставить("Действие",            "ЗаполнитьАдрес");

			СписокДоступныхМОД.Добавить(ДанныеПодбора, ДанныеМОД.ПредставлениеАдреса);
		
		КонецЕсли;

	КонецЦикла;

	КомандаОткрытия = Новый Структура;
	КомандаОткрытия.Вставить("ДанныеАдреса",        "");
	КомандаОткрытия.Вставить("ПредставлениеАдреса", "");
	КомандаОткрытия.Вставить("КодФИАС",             "");
	КомандаОткрытия.Вставить("Действие",            "ОткрытьСписокМОД");
		
	//@skip-check new-font
	СписокДоступныхМОД.Добавить(КомандаОткрытия, Новый ФорматированнаяСтрока(
		НСтр("ru = 'Выбрать МОД из списка'"), Новый Шрифт(, , , , Истина), ЦветаСтиля.ЦветГиперссылкиГосИС, , ""));

	Возврат СписокДоступныхМОД;
	
КонецФункции 

Функция ДоступнаРегистрацияМОДВГИСМТ(ВидПродукцииТоварнаяГруппа) Экспорт
	
	Возврат КонструкторИСМПОбщегоНазначенияКлиентСервер.ЭлементКонструктораСодержитЗначение(
		ПредопределенноеЗначение(
			"Справочник.ЭлементыКонструктораВидовПродукцииИС.ДоступнаРегистрацияМОДВГИСМТ"),
		ВидПродукцииТоварнаяГруппа);
	
КонецФункции

Процедура ЗаполнитьСписокДоступныхМестОсуществленияДеятельности(Форма, ПараметрыОтбораМОД, ПараметрыЗаполненияМОД) Экспорт
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	СписокМОД = ДоступныеАдресаМестОсуществленияДеятельности(ПараметрыОтбораМОД.Организация,
		ПараметрыОтбораМОД.ТоварнаяГруппа, ПараметрыОтбораМОД.КПП, ПараметрыОтбораМОД.ВыполнятьПроверку);
	
	ИмяРеквизитаАдресСтрокой = СтрШаблон("%1Строкой", ПараметрыЗаполненияМОД.ИмяРеквизитаАдрес);
	
	Если ЗначениеЗаполнено(ПараметрыЗаполненияМОД.ИмяЭлементаАдрес) Тогда
		ИмяЭлементаАдрес = ПараметрыЗаполненияМОД.ИмяЭлементаАдрес;
	Иначе
		ИмяЭлементаАдрес = ИмяРеквизитаАдресСтрокой;
	КонецЕсли;
	
	Для Каждого ДоступныйМОД Из СписокМОД Цикл
		Элементы[ИмяЭлементаАдрес].СписокВыбора.Добавить(ДоступныйМОД.Значение, ДоступныйМОД.Представление);
	КонецЦикла;
	
	Если ПараметрыЗаполненияМОД.ЗаполнятьАдрес И СписокМОД.Количество() = 2 И Не ЗначениеЗаполнено(
		Объект[ИмяРеквизитаАдресСтрокой]) Тогда

		ДоступныйМОД = СписокМОД[0].Значение;

		Объект[ПараметрыЗаполненияМОД.ИмяРеквизитаАдрес]   = ДоступныйМОД.ДанныеАдреса;
		Объект[ИмяРеквизитаАдресСтрокой]                   = ДоступныйМОД.ПредставлениеАдреса;
		Объект[ПараметрыЗаполненияМОД.ИмяРеквизитаКодФИАС] = ДоступныйМОД.КодФИАС;

	КонецЕсли;

КонецПроцедуры

// Создает структуру параметров для отбора мест осуществления деятельности
//
// Возвращаемое значение:
//   Структура:
//     * Организация       - Неопределено, ОпределяемыйТип.ОрганизацияКонтрагентГосИС - владелец МОД
//     * ТоварнаяГруппа    - СправочникСсылка.ТоварныеГруппыГИСМТ
//     * КПП               - Строка - код причины постановки на учет
//     * ВыполнятьПроверку - Булево - Истина, возвращаются корректные адреса
Функция ИнициализироватьПараметрыОтбораМестОсуществленияДеятельности() Экспорт
	
	ПараметрыОтбораМОД = Новый Структура;
	
	ПараметрыОтбораМОД.Вставить("Организация",       Неопределено);
	ПараметрыОтбораМОД.Вставить("ТоварнаяГруппа",    Справочники.ТоварныеГруппыГИСМТ.ПустаяСсылка());
	ПараметрыОтбораМОД.Вставить("КПП",               "");
	ПараметрыОтбораМОД.Вставить("ВыполнятьПроверку", Ложь);
	
	Возврат ПараметрыОтбораМОД;
	
КонецФункции

// Создает структуру параметров для заполнения мест осуществления деятельности (МОД).
//
// Возвращаемое значение:
//   Структура:
//     * ЗаполнятьАдрес      - Булево - Истина, автоматически заполнять адрес при наличии единственного МОД
//     * ИмяРеквизитаАдрес   - Строка - имя реквизита для хранения адреса
//     * ИмяРеквизитаКодФИАС - Строка - имя реквизита для хранения кода ФИАС
//     * ИмяЭлементаАдрес    - Строка - имя реквизита для хранения кода ФИАС
Функция ИнициализироватьПараметрыЗаполненияМОД() Экспорт
	
	ПараметрыМОД = Новый Структура;
	
	ПараметрыМОД.Вставить("ЗаполнятьАдрес",      Истина);
	ПараметрыМОД.Вставить("ИмяРеквизитаАдрес",   "");
	ПараметрыМОД.Вставить("ИмяРеквизитаКодФИАС", "");
	ПараметрыМОД.Вставить("ИмяЭлементаАдрес",    "");
	
	Возврат ПараметрыМОД;
	
КонецФункции

#КонецОбласти