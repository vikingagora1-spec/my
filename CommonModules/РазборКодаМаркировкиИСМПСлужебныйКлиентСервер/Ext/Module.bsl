Функция ЭтоНеФормализованныйКодМаркировкиЗаводскойSN(ПараметрыРазбораКодаМаркировки, Настройки, ДанныеРезультата, РезультатБезФильтра)
	
	// В коде может присутствовать идентификатор 97 и следующий за ним ЗаводскойСерийныйНомер в формате base64
	// 0108717644098684215*bgJiJmK5qTm91FFD092dGVzdFjTvNy+LhiBjpXBVCnWQqs/wt7jWl3EK1aeUV8=97MTIz
	
	ШаблоныКодовМаркировки = ШаблоныНеФормализованныхКодовМаркировки(Настройки, "ИСМП", "ЗаводскойSN");
	
	Если ШаблоныКодовМаркировки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИсходныйКодМаркировки       = ПараметрыРазбораКодаМаркировки.КодМаркировки;
	ИсходнаяДлинаКодаМаркировки = ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки;
	ДанныеРезультата            = Неопределено;
	
	ЕстьСкобки = ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки Или ПараметрыРазбораКодаМаркировки.СодержитРазделительGS;
	
	Для Каждого ШаблонКодаМаркировки Из ШаблоныКодовМаркировки Цикл
		
		СтрокаШаблона = ШаблонКодаМаркировки.СтрокаШаблона;
		Если СтрокаШаблона = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьСкобки Тогда
			ДлинаКодаМаркировкиИзШаблона = СтрокаШаблона.ДлинаСоСкобкой;
		Иначе
			ДлинаКодаМаркировкиИзШаблона = СтрокаШаблона.Длина;
		КонецЕсли;
		
		Если ИсходнаяДлинаКодаМаркировки > ДлинаКодаМаркировкиИзШаблона Тогда
			
			ПолноеОкончаниеКода = Сред(ИсходныйКодМаркировки, ДлинаКодаМаркировкиИзШаблона + 1);
			Если ЕстьСкобки
				И Лев(ПолноеОкончаниеКода, 4) = "(97)" Тогда
				ОкончаниеКода = Сред(ПолноеОкончаниеКода, 5);
			ИначеЕсли Не ЕстьСкобки
				И Лев(ПолноеОкончаниеКода, 2) = "97" Тогда
				ОкончаниеКода = Сред(ПолноеОкончаниеКода, 3);
			Иначе
				ОкончаниеКода = "";
			КонецЕсли;
			
			Если ОкончаниеКода <> "" И Base64Значение(ОкончаниеКода) <> Неопределено Тогда
				
				ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = ДлинаКодаМаркировкиИзШаблона;
				ПараметрыРазбораКодаМаркировки.КодМаркировки = Лев(ИсходныйКодМаркировки, ДлинаКодаМаркировкиИзШаблона);
				
				ДанныеРезультата = РазборКодаМаркировкиИССлужебныйКлиентСервер.КодМаркировкиСоответствуетШаблону(
					ПараметрыРазбораКодаМаркировки, Настройки, СтрокаШаблона);
				
				Если ДанныеРезультата <> Неопределено Тогда
					
					ДанныеРезультата.КодМаркировки = ИсходныйКодМаркировки;
					Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация Тогда
						ДанныеРезультата.Детализация.ЭтоНеФормализованныйКодМаркировки = Истина;
					КонецЕсли;
					
					ПараметрыРазбораКодаМаркировки.КодМаркировки       = ИсходныйКодМаркировки;
					ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = ИсходнаяДлинаКодаМаркировки;
					
					Возврат Истина;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыРазбораКодаМаркировки.КодМаркировки       = ИсходныйКодМаркировки;
	ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = ИсходнаяДлинаКодаМаркировки;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоНеФормализованныйКодМаркировкиПроизвольныеAI(ПараметрыРазбораКодаМаркировки, Настройки, ДанныеРезультата, РезультатБезФильтра)
	
	// В коде может присутствовать идентификатор 93 и следующее за ним произвольное количество идентификаторов применения
	// 010460620310255621!MmNZo2800514900093Ij5E240FA075486.00
	
	ШаблоныКодовМаркировки = ШаблоныНеФормализованныхКодовМаркировки(Настройки, "ИСМП", "ПроизвольныеAI");
	
	Если ШаблоныКодовМаркировки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИсходныйКодМаркировки       = ПараметрыРазбораКодаМаркировки.КодМаркировки;
	ИсходнаяДлинаКодаМаркировки = ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки;
	ДанныеРезультата            = Неопределено;
	
	Для Каждого ШаблонКодаМаркировки Из ШаблоныКодовМаркировки Цикл
		
		СтрокаШаблона = ШаблонКодаМаркировки.СтрокаШаблона;
		Если СтрокаШаблона = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки Или ПараметрыРазбораКодаМаркировки.СодержитРазделительGS Тогда
			ДлинаКодаМаркировкиИзШаблона = СтрокаШаблона.ДлинаСоСкобкой;
		Иначе
			ДлинаКодаМаркировкиИзШаблона = СтрокаШаблона.Длина;
		КонецЕсли;
		
		Если ИсходнаяДлинаКодаМаркировки <= ДлинаКодаМаркировкиИзШаблона Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = ДлинаКодаМаркировкиИзШаблона;
		
		ПараметрыРазбораКодаМаркировки.КодМаркировки = Лев(ИсходныйКодМаркировки, ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки);
		
		ДанныеРезультата = РазборКодаМаркировкиИССлужебныйКлиентСервер.КодМаркировкиСоответствуетШаблону(
			ПараметрыРазбораКодаМаркировки, Настройки, СтрокаШаблона);
		
		Если ДанныеРезультата = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеРезультата.КодМаркировки = ИсходныйКодМаркировки;
		ДанныеРезультата.ВидУпаковки   = ШаблонКодаМаркировки.ВидУпаковки;
		
		Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация Тогда
			ДанныеРезультата.Детализация.ЭтоНеФормализованныйКодМаркировки = Истина;
		КонецЕсли;
		
		ПараметрыРазбораКодаМаркировки.КодМаркировки       = ИсходныйКодМаркировки;
		ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = ИсходнаяДлинаКодаМаркировки;
		
		Возврат Истина;
		
	КонецЦикла;
	
	ПараметрыРазбораКодаМаркировки.КодМаркировки       = ИсходныйКодМаркировки;
	ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = ИсходнаяДлинаКодаМаркировки;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоНеФормализованныйКодМаркировкиЛогистическойУпаковкиGS1128(ПараметрыРазбораКодаМаркировки, Настройки, ДанныеРезультата, РезультатБезФильтра)
	
	ВозможенКодОСУ = Ложь;
	Если РезультатБезФильтра.Количество() > 0 Тогда
		
		ВозможенКодОСУ = СтрНачинаетсяС(ПараметрыРазбораКодаМаркировки.КодМаркировки, "02")
			И Сред(ПараметрыРазбораКодаМаркировки.КодМаркировки, 17, 2) = "37";
		Если Не ВозможенКодОСУ Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтрНачинаетсяС(ПараметрыРазбораКодаМаркировки.КодМаркировки, "00")
		И ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = 20 Тогда
		КонтрольноеЧисло = РазборКодаМаркировкиИССлужебныйКлиентСервер.КонтрольноеЧислоSSCC(
			Лев(ПараметрыРазбораКодаМаркировки.КодМаркировки, ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки - 1));
		Если КонтрольноеЧисло <> Число(Прав(ПараметрыРазбораКодаМаркировки.КодМаркировки, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ФильтрПоВидуПродукции = ПараметрыРазбораКодаМаркировки.ФильтрПоВидуПродукции;
	Если Не ФильтрПоВидуПродукции.Использовать Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидыПродукции = Новый Массив;
	Для Каждого ВидПродукции Из ФильтрПоВидуПродукции.ВидыПродукции Цикл
		Если Не КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияИСМП(ВидПродукции, Истина) Тогда
			Продолжить;
		КонецЕсли;
		Если Настройки.ДоступныеВидыПродукции.Найти(ВидПродукции) <> Неопределено Тогда
			ВидыПродукции.Добавить(ВидПродукции);
		КонецЕсли;
	КонецЦикла;
	
	КодМаркировки = ПараметрыРазбораКодаМаркировки.КодМаркировки;
	
	ВидыПродукцииКУдалению = Новый Массив();
	Для Каждого ВидПродукции Из ВидыПродукции Цикл
		
		Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВалидироватьШтрихкодЛогистическойУпаковкиGS1128СОшибками
			И ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки < 18 Тогда
			ВидыПродукцииКУдалению.Добавить(ВидПродукции);
		ИначеЕсли ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки < КонструкторИСМПОбщегоНазначенияКлиентСервер.МинимальнаяДлинаКодаЛогистическойУпаковки(ВидПродукции) Тогда
			ВидыПродукцииКУдалению.Добавить(ВидПродукции);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ВидПродукции Из ВидыПродукцииКУдалению Цикл
		ИндексАТП = ВидыПродукции.Найти(ВидПродукции);
		Если ИндексАТП <> Неопределено Тогда
			ВидыПродукции.Удалить(ИндексАТП);
		КонецЕсли;
	КонецЦикла;
	
	Если ВидыПродукции.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидУпаковки  = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая");
	ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.GS1_128");
	
	ЗначениеИдентификатораGTIN = Неопределено;
	
	ПрисутствуетИдентификатор02               = Ложь;
	ПрисутствуетИдентификатор01               = Ложь;
	ЗначениеИдентификатора37                  = Неопределено; // КоличествоВложенныхЕдиниц
	ВозможныВариантыКоличестваВложенныхЕдиниц = Ложь;
	
	ДлинаКодаМаркировкиБезРазделителей = 0;
	ЭтоОбъемноСортовойКод              = Ложь;
	ЭтоКодПартионногоУчета             = Ложь;
	РазбиратьКакКодПартионногоУчета    = (ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ПартионныйУчет")
		Или Не ЗначениеЗаполнено(ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВидУпаковки));
		
	Если ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки Тогда
		
		Если ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки = 22 И СтрНачинаетсяС(КодМаркировки, "(00)") Тогда
			
			// Некорректный SSCC
			
			Если Не ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВалидироватьШтрихкодЛогистическойУпаковкиGS1128СОшибками Тогда
				Возврат Ложь;
			КонецЕсли;
			
			ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Неопределен");
			
		Иначе
			
			РезультатРазбора = РазборКодаМаркировкиИССлужебныйКлиентСервер.РазобратьСтрокуШтрихкодаGS1(КодМаркировки);
			Если РезультатРазбора.Разобран Тогда
				
				ЭлементКМ = РезультатРазбора.ДанныеШтрихкода["01"];
				Если ЭлементКМ = Неопределено Тогда
					ЭлементКМ = РезультатРазбора.ДанныеШтрихкода["02"];
					Если ЭлементКМ <> Неопределено Тогда
						ЗначениеИдентификатораGTIN = ЭлементКМ.Значение;
						Если РезультатРазбора.ДанныеШтрихкода["37"] <> Неопределено Тогда
							ЗначениеИдентификатора37    = СтрокаВЧисло(РезультатРазбора.ДанныеШтрихкода["37"].Значение);
							ПрисутствуетИдентификатор02 = (ЗначениеИдентификатора37 <> Неопределено);
						КонецЕсли;
					КонецЕсли;
				Иначе
					ЗначениеИдентификатораGTIN  = ЭлементКМ.Значение;
					ПрисутствуетИдентификатор01 = Истина;
				КонецЕсли;
				
				Для Каждого КлючЗначение Из РезультатРазбора.ДанныеШтрихкода Цикл
					Идентификатор          = КлючЗначение.Ключ;
					ЗначениеИдентификатора = КлючЗначение.Значение.Значение;
					Если ТипЗнч(ЗначениеИдентификатора) = Тип("Строка")
						И ПустаяСтрока(ЗначениеИдентификатора) Тогда
						РезультатРазбора.Разобран = Ложь;
						Возврат Ложь;
					КонецЕсли;
					ДлинаКодаМаркировкиБезРазделителей = ДлинаКодаМаркировкиБезРазделителей + СтрДлина(Идентификатор) + СтрДлина(ЗначениеИдентификатора);
				КонецЦикла;
				
			Иначе
				
				Если Не ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВалидироватьШтрихкодЛогистическойУпаковкиGS1128СОшибками Тогда
					Возврат Ложь;
				КонецЕсли;
				
				ИдентификаторGTIN = Лев(КодМаркировки, 4);
				Если ИдентификаторGTIN = "(01)" Тогда
					ЗначениеИдентификатораGTIN = Сред(КодМаркировки, 5, 14);
				ИначеЕсли ИдентификаторGTIN = "(02)" Тогда
					ПараметрыРазбораКодаМаркировки.МодульКонтекста.МодульОбщегоНазначения().СообщитьПользователю(РезультатРазбора.ОписаниеОшибки);
				КонецЕсли;
				
				Если Не РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ЭтоGTIN(ЗначениеИдентификатораGTIN) Тогда
					Возврат Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ПараметрыРазбораКодаМаркировки.СодержитРазделительGS Тогда
		
		РезультатРазбора = ПараметрыРазбораКодаМаркировки.РезультатРазбора;
		
		ЭлементКМ = РезультатРазбора.ДанныеШтрихкода["01"];
		Если ЭлементКМ = Неопределено Тогда
			ЭлементКМ = РезультатРазбора.ДанныеШтрихкода["02"];
			Если ЭлементКМ <> Неопределено Тогда
				ПрисутствуетИдентификатор02 = Истина;
				ЗначениеИдентификатораGTIN = ЭлементКМ.Значение;
				Если РезультатРазбора.ДанныеШтрихкода["37"] <> Неопределено Тогда
					ЗначениеИдентификатора37    = СтрокаВЧисло(РезультатРазбора.ДанныеШтрихкода["37"].Значение);
					ПрисутствуетИдентификатор02 = (ЗначениеИдентификатора37 <> Неопределено);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ПрисутствуетИдентификатор01 = Истина;
			ЗначениеИдентификатораGTIN = ЭлементКМ.Значение;
		КонецЕсли;
		
		Для Каждого КлючЗначение Из РезультатРазбора.ДанныеШтрихкода Цикл
			Идентификатор          = КлючЗначение.Ключ;
			ЗначениеИдентификатора = КлючЗначение.Значение.Значение;
			ДлинаКодаМаркировкиБезРазделителей = ДлинаКодаМаркировкиБезРазделителей + СтрДлина(Идентификатор) + СтрДлина(ЗначениеИдентификатора);
		КонецЦикла;
		
		ДлинаКодаМаркировкиДляПроверки = ДлинаКодаМаркировкиБезРазделителей + РезультатРазбора.ДанныеШтрихкода.Количество() * 2;
		Если ДлинаКодаМаркировкиДляПроверки <> СтрДлина(КодМаркировки) Тогда
			Возврат Ложь; // код маркировки предположительно содержит дубрирующие идентификаторы
		КонецЕсли;
		
	Иначе
		
		Если Не РазборКодаМаркировкиИССлужебныйКлиентСервер.КодСоответствуетАлфавиту(КодМаркировки, Настройки.Алфавит.БуквыЦифрыЗнаки) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если МенеджерОборудованияКлиентСервер.ПроверитьКорректностьGTIN(КодМаркировки) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ДлинаКодаМаркировкиБезРазделителей = ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки;
		
		ВариантыРазбораШтрихкодаGS1 = РазборКодаМаркировкиИССлужебныйКлиентСервер.ВариантыРазбораШтрихкодаGS1БезРазделителей(КодМаркировки);
		
		Если ВариантыРазбораШтрихкодаGS1 <> Неопределено Тогда
			ЕстьПоложительныеРезультаты = Ложь;
			Для Каждого ЭлементыВариантаРазбора Из ВариантыРазбораШтрихкодаGS1 Цикл
				Если ЭлементыВариантаРазбора.Значение.Приоритет >= 0 Тогда
					ЕстьПоложительныеРезультаты = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не ЕстьПоложительныеРезультаты Тогда
				ВариантыРазбораШтрихкодаGS1 = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Если ВариантыРазбораШтрихкодаGS1 = Неопределено Тогда
			
			Если Не ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВалидироватьШтрихкодЛогистическойУпаковкиGS1128СОшибками
				Или Не ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВалидироватьШтрихкодЛогистическойУпаковкиGS1128БезРазделителей Тогда
				Возврат Ложь;
			КонецЕсли;
			
			ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Неопределен");
			
		Иначе
			
			ПроверитьНаличиеВложенныхЕдиниц = Ложь;
			
			ИдентификаторGTIN = Лев(КодМаркировки, 2);
			Если ИдентификаторGTIN = "01" Или ИдентификаторGTIN = "02" Тогда
				ЗначениеИдентификатораGTIN = Сред(КодМаркировки, 3, 14);
				Если РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ЭтоGTIN(ЗначениеИдентификатораGTIN) Тогда
					ПроверитьНаличиеВложенныхЕдиниц = (ИдентификаторGTIN = "02");
				Иначе
					ЗначениеИдентификатораGTIN = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			ВариантыКоличестваВложенныхЕдиницПоЗначению   = Новый СписокЗначений;
			ВариантыКоличестваВложенныхЕдиницПоПриоритету = Новый СписокЗначений;
			
			Если ПроверитьНаличиеВложенныхЕдиниц Тогда
				
				ПрисутствуетИдентификатор01 = Ложь;
				
				Для Каждого КлючИЗначение Из ВариантыРазбораШтрихкодаGS1 Цикл
					
					ИдентификаторВарианта = КлючИЗначение.Ключ;
					ВариантРазбора        = КлючИЗначение.Значение;
					
					Если ВариантРазбора.Приоритет < 0 Тогда
						Продолжить;
					КонецЕсли;
					
					Если ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["01"] <> Неопределено Тогда
						
						ВариантРазбора.Вставить("Значение", 0);
						ВариантРазбора.Вставить("ПрисутствуетИдентификатор02", Ложь);
						ВариантРазбора.Вставить("ПрисутствуетИдентификатор01", Истина);
						ПрисутствуетИдентификатор01 = Истина;
						
						Если ЗначениеИдентификатораGTIN <> ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["01"].Значение Тогда
							Продолжить;
						КонецЕсли;
						
					ИначеЕсли ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["02"] <> Неопределено Тогда
						
						ВариантРазбора.Вставить("Значение", 0);
						ВариантРазбора.Вставить("ПрисутствуетИдентификатор02", Истина);
						ВариантРазбора.Вставить("ПрисутствуетИдентификатор01", Ложь);
						
						Если ЗначениеИдентификатораGTIN <> ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["02"].Значение Тогда
							Продолжить;
						ИначеЕсли ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["37"] = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						
						ЗначениеИдентификатора37 = СтрокаВЧисло(ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["37"].Значение);
						
						Если ЗначениеИдентификатора37 <> Неопределено Тогда
							
							ВариантыКоличестваВложенныхЕдиницПоЗначению.Добавить(ЗначениеИдентификатора37, ИдентификаторВарианта);
							ВариантыКоличестваВложенныхЕдиницПоПриоритету.Добавить(ВариантРазбора.Приоритет, ИдентификаторВарианта);
							
							ВариантРазбора.Значение = ЗначениеИдентификатора37;
							ПрисутствуетИдентификатор02 = Истина;
							
						КонецЕсли;
						
						ЗначениеИдентификатора37 = Неопределено;
						
					КонецЕсли;
					
				КонецЦикла;
				
				ВариантыКоличестваВложенныхЕдиницПоЗначению.СортироватьПоЗначению(НаправлениеСортировки.Возр);
				ВариантыКоличестваВложенныхЕдиницПоПриоритету.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
				ВариантыКоличестваВложенныхЕдиницПоЗначениюСвертка = ВариантыКоличестваВложенныхЕдиницПоЗначению.ВыгрузитьЗначения();
				Если ВариантыКоличестваВложенныхЕдиницПоЗначениюСвертка.Количество() > 1 Тогда
					ВариантыКоличестваВложенныхЕдиницПоЗначениюСвертка = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ВариантыКоличестваВложенныхЕдиницПоЗначениюСвертка);
				КонецЕсли;
				
				Если ВариантыКоличестваВложенныхЕдиницПоЗначениюСвертка.Количество() = 0 Тогда
					
					ЗначениеИдентификатораGTIN = Неопределено;
					
				ИначеЕсли ВариантыКоличестваВложенныхЕдиницПоЗначениюСвертка.Количество() = 1 Тогда
					
					Если ПрисутствуетИдентификатор02 Тогда
						ЗначениеИдентификатора37 = ВариантыКоличестваВложенныхЕдиницПоЗначениюСвертка[0];
					КонецЕсли;
					
					Если ЗначениеИдентификатора37 <> Неопределено Тогда
						
						Для Каждого ЭлементСписка Из ВариантыКоличестваВложенныхЕдиницПоПриоритету Цикл
							
							ВариантРазбора = ВариантыРазбораШтрихкодаGS1[ЭлементСписка.Представление];
							Если ВариантРазбора = Неопределено Тогда
								Продолжить;
							КонецЕсли;
							
							Если ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["37"] <> Неопределено
								И СтрокаВЧисло(ВариантРазбора.РезультатРазбора.ДанныеШтрихкода["37"].Значение) = ЗначениеИдентификатора37 Тогда
								РезультатРазбора = ВариантРазбора.РезультатРазбора;
								Прервать;
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;
					
				Иначе
					
					КоличествоПредполагаемыхКоличеств = 0;
					Для Каждого ЭлементСписка Из ВариантыКоличестваВложенныхЕдиницПоПриоритету Цикл
						
						Если ЭлементСписка.Значение < 0 Тогда
							Продолжить;
						КонецЕсли;
						
						ВариантРазбора = ВариантыРазбораШтрихкодаGS1[ЭлементСписка.Представление];
						Если ВариантРазбора = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						
						КоличествоПредполагаемыхКоличеств = КоличествоПредполагаемыхКоличеств + 1;
						
						Если ВариантРазбора.ПрисутствуетИдентификатор02 Тогда
							Если ЗначениеИдентификатора37 = Неопределено Тогда
								ЗначениеИдентификатора37 = ВариантРазбора.Значение;
							КонецЕсли;
						ИначеЕсли ВариантРазбора.ПрисутствуетИдентификатор01 Тогда
							ПрисутствуетИдентификатор01 = Истина;
						КонецЕсли;
						
						Если РезультатРазбора = Неопределено Тогда
							РезультатРазбора = ВариантРазбора.РезультатРазбора;
						КонецЕсли;
						
						Если РазбиратьКакКодПартионногоУчета Тогда
							
							Если ЭтоДанныеРазбораПартионногоУчета02(ВариантРазбора.РезультатРазбора) Тогда
								РезультатРазбора = ВариантРазбора.РезультатРазбора;
								ЭтоКодПартионногоУчета = Истина;
							ИначеЕсли ЭтоДанныеРазбораПартионногоУчета01(ВариантРазбора.РезультатРазбора) Тогда
								РезультатРазбора = ВариантРазбора.РезультатРазбора;
								ЭтоКодПартионногоУчета = Истина;
							ИначеЕсли ЭтоДанныеРазбораОСУ(ВариантРазбора.РезультатРазбора) Тогда
								РезультатРазбора = ВариантРазбора.РезультатРазбора;
								ЭтоОбъемноСортовойКод = Истина;
							КонецЕсли;
						
						КонецЕсли;
						
					КонецЦикла;
					
					Если ЗначениеИдентификатора37 = Неопределено И ПрисутствуетИдентификатор02 Тогда
						ЗначениеИдентификатораGTIN = Неопределено;
					КонецЕсли;
					
					ВозможныВариантыКоличестваВложенныхЕдиниц = (КоличествоПредполагаемыхКоличеств > 1);
					
				КонецЕсли;
				
				ПрисутствуетИдентификатор02 = ЗначениеЗаполнено(ЗначениеИдентификатораGTIN) И ЗначениеЗаполнено(ЗначениеИдентификатора37);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	GTIN = "";
	Если ЗначениеЗаполнено(ЗначениеИдентификатораGTIN)
		И ТипЗнч(ЗначениеИдентификатораGTIN) = Тип("Строка")
		И СтрДлина(ЗначениеИдентификатораGTIN) = 14
		И РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ЭтоGTIN(ЗначениеИдентификатораGTIN) Тогда
		
		GTIN = ЗначениеИдентификатораGTIN;
		
	КонецЕсли;
	
	Коэффициент = Неопределено;
	
	Если РазбиратьКакКодПартионногоУчета
		И ЗначениеЗаполнено(GTIN) Тогда
		
		Если ПрисутствуетИдентификатор02 Тогда
			
			Если ЭтоДанныеРазбораПартионногоУчета02(РезультатРазбора) Тогда
				ЭтоКодПартионногоУчета = Истина;
			ИначеЕсли ЭтоДанныеРазбораОСУ(РезультатРазбора) Тогда
				ЭтоОбъемноСортовойКод = Истина;
			КонецЕсли;
		
		ИначеЕсли ПрисутствуетИдентификатор01
			И ЭтоДанныеРазбораПартионногоУчета01(РезультатРазбора) Тогда
				
			ЭтоКодПартионногоУчета = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоОбъемноСортовойКод Тогда
		ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ОбъемноСортовойУчет");
		Индекс = ВидыПродукции.ВГраница();
		Пока Индекс >= 0 Цикл
			Если Не ОбщегоНазначенияИСКлиентСерверПовтИсп.ВидПродукцииИспользуетОбъемноСортовойУчет(ВидыПродукции[Индекс]) Тогда
				ВидыПродукции.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		Если ВидыПродукции.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ВозможенКодОСУ Тогда
		Возврат Ложь;
	ИначеЕсли ЭтоКодПартионногоУчета тогда
		ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ПартионныйУчет");
		Индекс = ВидыПродукции.ВГраница();
		Пока Индекс >= 0 Цикл
			Если Не ОбщегоНазначенияИСКлиентСерверПовтИсп.ВидПродукцииИспользуетПартионныйУчет(ВидыПродукции[Индекс]) Тогда
				ВидыПродукции.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		Если ВидыПродукции.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ДлинаКодаМаркировкиБезРазделителей > 0 Тогда
		
		ВидыПродукцииКУдалению = Новый Массив();
		Для Каждого ВидПродукции Из ВидыПродукции Цикл
			
			Если ДлинаКодаМаркировкиБезРазделителей > КонструкторИСМПОбщегоНазначенияКлиентСервер.МаксимальнаяДлинаКодаЛогистическойУпаковки(ВидПродукции) Тогда
				ВидыПродукцииКУдалению.Добавить(ВидПродукции);
			КонецЕсли;
			
			Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.ВалидироватьШтрихкодЛогистическойУпаковкиGS1128СОшибками
				И ДлинаКодаМаркировкиБезРазделителей < 18 Тогда
				ВидыПродукцииКУдалению.Добавить(ВидПродукции);
			ИначеЕсли ДлинаКодаМаркировкиБезРазделителей < КонструкторИСМПОбщегоНазначенияКлиентСервер.МинимальнаяДлинаКодаЛогистическойУпаковки(ВидПродукции) Тогда
				ВидыПродукцииКУдалению.Добавить(ВидПродукции);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ВидПродукции Из ВидыПродукцииКУдалению Цикл
			ИндексЭлемента = ВидыПродукции.Найти(ВидПродукции);
			Если ИндексЭлемента <> Неопределено Тогда
				ВидыПродукции.Удалить(ИндексЭлемента);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВидыПродукции.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипШтрихкодаИВидУпаковки = РазборКодаМаркировкиИССлужебныйКлиентСервер.ТипШтрихкодаИВидУпаковки();
	ТипШтрихкодаИВидУпаковки.ТипШтрихкода = ТипШтрихкода;
	ТипШтрихкодаИВидУпаковки.ВидУпаковки  = ВидУпаковки;
	
	СоставКодаМаркировки = НовыйСоставКодаМаркировки(ТипШтрихкодаИВидУпаковки);
	
	Если ТипШтрихкодаИВидУпаковки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ОбъемноСортовойУчет") Тогда
		
		СоставКодаМаркировки.GTIN                             = GTIN;
		СоставКодаМаркировки.EAN                              = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(СоставКодаМаркировки.GTIN);
		СоставКодаМаркировки.ВключаетИдентификаторыПрименения = Истина;
		ЗаполнитьСоставКодаМаркировкиПоДаннымРазбора(РезультатРазбора, СоставКодаМаркировки);
		
	ИначеЕсли ТипШтрихкодаИВидУпаковки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ПартионныйУчет") Тогда
		
		СоставКодаМаркировки.GTIN      = GTIN;
		СоставКодаМаркировки.EAN       = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(СоставКодаМаркировки.GTIN);
		СоставКодаМаркировки.ЭтоGTIN01 = ПрисутствуетИдентификатор01;
		ЗаполнитьСоставКодаМаркировкиПоДаннымРазбора(РезультатРазбора, СоставКодаМаркировки);
		
	ИначеЕсли ТипШтрихкодаИВидУпаковки.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.GS1_128") Тогда
		
		СоставКодаМаркировки.GTIN = GTIN;
		
		Если ЗначениеЗаполнено(СоставКодаМаркировки.GTIN) Тогда
			СоставКодаМаркировки.EAN = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(СоставКодаМаркировки.GTIN);
			СоставКодаМаркировки.ВключаетИдентификаторыПрименения = Истина;
		КонецЕсли;
		
		СоставКодаМаркировки.Коэффициент                               = Коэффициент;
		СоставКодаМаркировки.ВозможныВариантыКоличестваВложенныхЕдиниц = ВозможныВариантыКоличестваВложенныхЕдиниц;
		ЗаполнитьСоставКодаМаркировкиПоДаннымРазбора(РезультатРазбора, СоставКодаМаркировки);
	
	КонецЕсли;
	
	ДанныеРезультата = РазборКодаМаркировкиИССлужебныйКлиентСервер.НовыйРезультатРазбораКодаМаркировки(ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация);
	ДанныеРезультата.КодМаркировки        = КодМаркировки;
	ДанныеРезультата.ТипШтрихкода         = ТипШтрихкодаИВидУпаковки.ТипШтрихкода;
	ДанныеРезультата.ВидУпаковки          = ТипШтрихкодаИВидУпаковки.ВидУпаковки;
	ДанныеРезультата.ВидыПродукции        = ВидыПродукции;
	ДанныеРезультата.СоставКодаМаркировки = СоставКодаМаркировки;
	
	Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация Тогда
		ДанныеРезультата.Детализация.НачинаетсяСоСкобки                = ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки;
		ДанныеРезультата.Детализация.СодержитРазделительGS             = ПараметрыРазбораКодаМаркировки.СодержитРазделительGS;
		ДанныеРезультата.Детализация.ЭтоНеФормализованныйКодМаркировки = Истина;
	КонецЕсли;
	
	Для Каждого ВидПродукции Из ВидыПродукции Цикл
		ДанныеРезультата.ВидыУпаковокПоВидамПродукции[ВидПродукции] =
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипШтрихкодаИВидУпаковки.ВидУпаковки);
	КонецЦикла;
	
	Если РезультатРазбора <> Неопределено
		И СтрНачинаетсяС(РезультатРазбора.ПредставлениеШтрихкода, "(")
		И ТипШтрихкодаИВидУпаковки.ВидУпаковки = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая")
		И (ВариантыРазбораШтрихкодаGS1 = Неопределено Или ВариантыРазбораШтрихкодаGS1.Количество() = 1) Тогда
		НормализованныйКодМаркировки = РезультатРазбора.ПредставлениеШтрихкода;
	Иначе
		НормализованныйКодМаркировки = РазборКодаМаркировкиИССлужебныйКлиентСервер.НормализоватьКодМаркировки(
			ДанныеРезультата, ВидыПродукции[0]); // Тут вид продукции не имеет значения
	КонецЕсли;
	
	ДанныеРезультата.НормализованныйКодМаркировки = НормализованныйКодМаркировки;
	
	Возврат ДанныеРезультата.ТипШтрихкода <> ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Неопределен");
	
КонецФункции

Функция ЭтоНеФормализованныйКодМаркировкиЛогистическойУпаковкиCode128(ПараметрыРазбораКодаМаркировки, Настройки, ДанныеРезультата, РезультатБезФильтра)
	
	Если ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки
		Или ПараметрыРазбораКодаМаркировки.СодержитРазделительGS Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Ограничение согласно документации СУЗ
	МинимальнаяДлинаКодаТранспортнойУпаковки  = 18; // В ЦРПТ логистическая упаковка не может быть меньше 18 символов
	МаксимальнаяДлинаКодаТранспортнойУпаковки = 74;

	Если ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки < МинимальнаяДлинаКодаТранспортнойУпаковки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки > МаксимальнаяДлинаКодаТранспортнойУпаковки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФильтрПоВидуПродукции = ПараметрыРазбораКодаМаркировки.ФильтрПоВидуПродукции;
	Если Не ФильтрПоВидуПродукции.Использовать Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидыПродукции = Новый Массив;
	Для Каждого ВидПродукции Из ФильтрПоВидуПродукции.ВидыПродукции Цикл
		Если Не КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияИСМП(ВидПродукции, Истина) Тогда
			Продолжить;
		КонецЕсли;
		Если Настройки.ДоступныеВидыПродукции.Найти(ВидПродукции) <> Неопределено Тогда
			ВидыПродукции.Добавить(ВидПродукции);
		КонецЕсли;
	КонецЦикла;
	
	КодМаркировки = ПараметрыРазбораКодаМаркировки.КодМаркировки;
	
	Если ВидыПродукции.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоCODE128 = Истина;
	Для Счетчик = 1 По ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки Цикл
		ВремКодСимвола = КодСимвола(КодМаркировки, Счетчик);
		Если (ВремКодСимвола > 127) Тогда
			ЭтоCODE128 = Ложь;
		Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Если Не ЭтоCODE128 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипШтрихкодаИВидУпаковки = РазборКодаМаркировкиИССлужебныйКлиентСервер.ТипШтрихкодаИВидУпаковки();
	ТипШтрихкодаИВидУпаковки.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128");
	ТипШтрихкодаИВидУпаковки.ВидУпаковки  = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.Логистическая");
	
	СоставКодаМаркировки = НовыйСоставКодаМаркировки(ТипШтрихкодаИВидУпаковки);
	
	ДанныеРезультата = РазборКодаМаркировкиИССлужебныйКлиентСервер.НовыйРезультатРазбораКодаМаркировки(ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация);
	ДанныеРезультата.КодМаркировки        = КодМаркировки;
	ДанныеРезультата.ТипШтрихкода         = ТипШтрихкодаИВидУпаковки.ТипШтрихкода;
	ДанныеРезультата.ВидУпаковки          = ТипШтрихкодаИВидУпаковки.ВидУпаковки;
	ДанныеРезультата.ВидыПродукции        = ВидыПродукции;
	ДанныеРезультата.СоставКодаМаркировки = СоставКодаМаркировки;
	
	Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация Тогда
		ДанныеРезультата.Детализация.НачинаетсяСоСкобки                = ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки;
		ДанныеРезультата.Детализация.СодержитРазделительGS             = ПараметрыРазбораКодаМаркировки.СодержитРазделительGS;
		ДанныеРезультата.Детализация.ЭтоНеФормализованныйКодМаркировки = Истина;
	КонецЕсли;
	
	Для Каждого ВидПродукции Из ВидыПродукции Цикл
		ДанныеРезультата.ВидыУпаковокПоВидамПродукции[ВидПродукции] =
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипШтрихкодаИВидУпаковки.ВидУпаковки);
	КонецЦикла;
	
	ДанныеРезультата.НормализованныйКодМаркировки = КодМаркировки;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоИдентификаторСырья(ПараметрыРазбораКодаМаркировки, Настройки, ДанныеРезультата, РезультатБезФильтра)
	
	Если ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки
		Или ПараметрыРазбораКодаМаркировки.СодержитРазделительGS Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДлинаИдентификатораСырья = 14;

	Если ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки <> ДлинаИдентификатораСырья Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФильтрПоВидуПродукции = ПараметрыРазбораКодаМаркировки.ФильтрПоВидуПродукции;
	Если Не ФильтрПоВидуПродукции.Использовать Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоСырьеГИСМТ(ФильтрПоВидуПродукции.ВидыПродукции) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеПрефиксов = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ПрефиксыВидовПродукцииИдентификационногоКодаСырья();
	КодМаркировки   = ПараметрыРазбораКодаМаркировки.КодМаркировки;
	ВидыПродукции   = Новый Массив;
	
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Или МобильноеПриложениеСервер Тогда
	Если ЗначениеЗаполнено(ДанныеПрефиксов.РегулярноеВыражениеВсе)
		И Не СтрПодобнаПоРегулярномуВыражению(КодМаркировки, ДанныеПрефиксов.РегулярноеВыражениеВсе) Тогда
		Возврат Ложь;
	КонецЕсли;
	#КонецЕсли
	
	Для Каждого КлючИЗначение Из ДанныеПрефиксов.ПрефиксыПоВидуПродукции Цикл
		Префиксы     = КлючИЗначение.Значение;
		ВидПродукции = КлючИЗначение.Ключ;
		Для Каждого Префикс Из Префиксы Цикл
			Если СтрНачинаетсяС(КодМаркировки, Префикс) Тогда
				ВидыПродукции.Добавить(ВидПродукции);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ВидыПродукции.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипШтрихкодаИВидУпаковки = РазборКодаМаркировкиИССлужебныйКлиентСервер.ТипШтрихкодаИВидУпаковки();
	ТипШтрихкодаИВидУпаковки.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128");
	ТипШтрихкодаИВидУпаковки.ВидУпаковки  = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.НеЯвляетсяУпаковкой");
	
	СоставКодаМаркировки = НовыйСоставКодаМаркировки(ТипШтрихкодаИВидУпаковки);
	
	ДанныеРезультата = РазборКодаМаркировкиИССлужебныйКлиентСервер.НовыйРезультатРазбораКодаМаркировки(ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация);
	ДанныеРезультата.КодМаркировки        = КодМаркировки;
	ДанныеРезультата.ТипШтрихкода         = ТипШтрихкодаИВидУпаковки.ТипШтрихкода;
	ДанныеРезультата.ВидУпаковки          = ТипШтрихкодаИВидУпаковки.ВидУпаковки;
	ДанныеРезультата.ВидыПродукции        = ВидыПродукции;
	ДанныеРезультата.СоставКодаМаркировки = СоставКодаМаркировки;
	
	Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация Тогда
		ДанныеРезультата.Детализация.НачинаетсяСоСкобки                = ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки;
		ДанныеРезультата.Детализация.СодержитРазделительGS             = ПараметрыРазбораКодаМаркировки.СодержитРазделительGS;
		ДанныеРезультата.Детализация.ЭтоНеФормализованныйКодМаркировки = Истина;
	КонецЕсли;
	
	Для Каждого ВидПродукции Из ВидыПродукции Цикл
		ДанныеРезультата.ВидыУпаковокПоВидамПродукции[ВидПродукции] =
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипШтрихкодаИВидУпаковки.ВидУпаковки);
	КонецЦикла;
	
	ДанныеРезультата.НормализованныйКодМаркировки = КодМаркировки;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоКодПартионногоУчета(ПараметрыРазбораКодаМаркировки, Настройки, ДанныеРезультата, РезультатБезФильтра)
	
	Если ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки
		Или ПараметрыРазбораКодаМаркировки.СодержитРазделительGS Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не СоответствуетПартионномуКодуПоДлине(ПараметрыРазбораКодаМаркировки.ДлинаКодаМаркировки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ФильтрПоВидуПродукции = ПараметрыРазбораКодаМаркировки.ФильтрПоВидуПродукции;
	Если Не ФильтрПоВидуПродукции.Использовать Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не КонструкторИСОбщегоНазначенияКлиентСервер.ЭтоПродукцияПартионногоУчетаГИСМТ(ФильтрПоВидуПродукции.ВидыПродукции) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КодМаркировки                = ПараметрыРазбораКодаМаркировки.КодМаркировки;
	ДанныеРазбораПартионногоКода = ДанныеРазбораПартионногоКода(КодМаркировки, Ложь);
	
	Если Не ДанныеРазбораПартионногоКода.Разобран Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипШтрихкодаИВидУпаковки = РазборКодаМаркировкиИССлужебныйКлиентСервер.ТипШтрихкодаИВидУпаковки();
	ТипШтрихкодаИВидУпаковки.ТипШтрихкода = ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.Code128");
	ТипШтрихкодаИВидУпаковки.ВидУпаковки  = ПредопределенноеЗначение("Перечисление.ВидыУпаковокИС.ПартионныйУчет");
	
	ВидыПродукции        = КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииПартионногоУчета();
	СоставКодаМаркировки = НовыйСоставКодаМаркировки(ТипШтрихкодаИВидУпаковки);
	
	СоставКодаМаркировки.GTIN             = ДанныеРазбораПартионногоКода.GTIN;
	СоставКодаМаркировки.ДатаПроизводства = ДанныеРазбораПартионногоКода.ДатаПроизводстваСтрокой;
	СоставКодаМаркировки.НомерПартии      = ДанныеРазбораПартионногоКода.НомерПартии;
	СоставКодаМаркировки.EAN              = РазборКодаМаркировкиИССлужебныйКлиентСерверПовтИсп.ШтрихкодEANИзGTIN(СоставКодаМаркировки.GTIN);
	
	ДанныеРезультата = РазборКодаМаркировкиИССлужебныйКлиентСервер.НовыйРезультатРазбораКодаМаркировки(ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация);
	ДанныеРезультата.КодМаркировки        = КодМаркировки;
	ДанныеРезультата.ТипШтрихкода         = ТипШтрихкодаИВидУпаковки.ТипШтрихкода;
	ДанныеРезультата.ВидУпаковки          = ТипШтрихкодаИВидУпаковки.ВидУпаковки;
	ДанныеРезультата.ВидыПродукции        = ВидыПродукции;
	ДанныеРезультата.СоставКодаМаркировки = СоставКодаМаркировки;
	
	Если ПараметрыРазбораКодаМаркировки.ПользовательскиеПараметры.РасширеннаяДетализация Тогда
		ДанныеРезультата.Детализация.НачинаетсяСоСкобки                = ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки;
		ДанныеРезультата.Детализация.СодержитРазделительGS             = ПараметрыРазбораКодаМаркировки.СодержитРазделительGS;
		ДанныеРезультата.Детализация.ЭтоНеФормализованныйКодМаркировки = Истина;
	КонецЕсли;
	
	Для Каждого ВидПродукции Из ВидыПродукции Цикл
		ДанныеРезультата.ВидыУпаковокПоВидамПродукции[ВидПродукции] =
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипШтрихкодаИВидУпаковки.ВидУпаковки);
	КонецЦикла;
	
	ДанныеРезультата.НормализованныйКодМаркировки = КодМаркировки;
	
	Возврат Истина;
	
КонецФункции

Функция МинимальнаяДлинаПартионногоКода() Экспорт
	Возврат 21;
КонецФункции

Функция МаксимальнаяДлинаПартионногоКода() Экспорт
	Возврат 32;
КонецФункции

Функция СоответствуетПартионномуКодуПоДлине(ДлинаКодаМаркировки) Экспорт
	
	МинимальнаяДлина = МинимальнаяДлинаПартионногоКода();
	МаксимальнаяДлина = МаксимальнаяДлинаПартионногоКода();
	
	Возврат (ДлинаКодаМаркировки >= МинимальнаяДлина
		И ДлинаКодаМаркировки <= МаксимальнаяДлина);
	
КонецФункции

Функция СтрокаВЧисло(ЗначениеСтрокой, ПоложениеДесятичнойТочки = 0)
	
	ЗначениеЧислом = Неопределено;
	
	Если ТипЗнч(ЗначениеСтрокой) = Тип("Строка")
		И Не ПустаяСтрока(ЗначениеСтрокой)
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ЗначениеСтрокой) Тогда
		
		Значение = ЗначениеСтрокой;
		
		Если ПоложениеДесятичнойТочки > 0 Тогда
			Для Индекс = 0 По ПоложениеДесятичнойТочки - СтрДлина(Значение) Цикл
				Значение = "0" + Значение;
			КонецЦикла;
			Значение = Лев(Значение, СтрДлина(Значение) - ПоложениеДесятичнойТочки) + "." + Прав(Значение, ПоложениеДесятичнойТочки);
		КонецЕсли;
		
		ОписаниеТипаЧисла = Новый ОписаниеТипов("Число");
		ЗначениеЧислом = ОписаниеТипаЧисла.ПривестиЗначение(Значение);
		
	КонецЕсли;
	
	Возврат ЗначениеЧислом;
	
КонецФункции

Функция ЭтоДанныеРазбораПартионногоУчета01(РезультатРазбора)
	
	Если РезультатРазбора = Неопределено
		Или РезультатРазбора.ДанныеШтрихкода = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыПроверки = ПараметрыПроверкиДанныхРазбораПартионногоКода("01");
	ПараметрыПроверки.ДополнительныеИдентификаторы.Вставить("21",  Ложь);  // Серийный номер
	ПараметрыПроверки.ДополнительныеИдентификаторы.Вставить("310", Ложь);  // Вес в килограммах
	
	Возврат ЭтоДанныеРазбораПартионногоУчета(
		РезультатРазбора.ДанныеШтрихкода, ПараметрыПроверки);
	
КонецФункции

Функция ЭтоДанныеРазбораПартионногоУчета02(РезультатРазбора)
	
	Если РезультатРазбора = Неопределено
		Или РезультатРазбора.ДанныеШтрихкода = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыПроверки = ПараметрыПроверкиДанныхРазбораПартионногоКода("02");
	ПараметрыПроверки.ОбязательныеИдентификаторы.Вставить("37", Ложь); // Количество единиц
	ПараметрыПроверки.ДополнительныеИдентификаторы.Вставить("310", Ложь);  // Вес в килограммах
	
	Возврат ЭтоДанныеРазбораПартионногоУчета(
		РезультатРазбора.ДанныеШтрихкода,ПараметрыПроверки);
	
КонецФункции

Функция ПараметрыПроверкиДанныхРазбораПартионногоКода(ИдентификаторGTIN)
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИдентификаторGTIN",             ИдентификаторGTIN);
	ПараметрыПроверки.Вставить("ИдентификаторНомерПартии",      "10");
	ПараметрыПроверки.Вставить("ИдентификаторДатаПроизводства", "11");
	ПараметрыПроверки.Вставить("ОбязательныеИдентификаторы",   Новый Соответствие());
	ПараметрыПроверки.Вставить("ДополнительныеИдентификаторы", Новый Соответствие());
	
	ПараметрыПроверки.ОбязательныеИдентификаторы.Вставить(ПараметрыПроверки.ИдентификаторGTIN,             Ложь);
	ПараметрыПроверки.ОбязательныеИдентификаторы.Вставить(ПараметрыПроверки.ИдентификаторНомерПартии,      Ложь);
	ПараметрыПроверки.ОбязательныеИдентификаторы.Вставить(ПараметрыПроверки.ИдентификаторДатаПроизводства, Ложь);
	
	Возврат ПараметрыПроверки;
	
КонецФункции

Функция ЭтоДанныеРазбораПартионногоУчета(ДанныеШтрихкода, ПараметрыПроверки)
	
	Для Каждого КлючИЗначение Из ДанныеШтрихкода Цикл
		
		Если ПараметрыПроверки.ОбязательныеИдентификаторы[КлючИЗначение.Ключ] = Неопределено
			И ПараметрыПроверки.ИдентификаторGTIN <> КлючИЗначение.Ключ
			И ПараметрыПроверки.ИдентификаторНомерПартии <> КлючИЗначение.Ключ
			И ПараметрыПроверки.ИдентификаторДатаПроизводства <> КлючИЗначение.Ключ Тогда
			Если ПараметрыПроверки.ДополнительныеИдентификаторы[КлючИЗначение.Ключ] = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			ПараметрыПроверки.ОбязательныеИдентификаторы[КлючИЗначение.Ключ] = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ПараметрыПроверки.ОбязательныеИдентификаторы Цикл
		Если Не КлючИЗначение.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	НомераПартии = СтрШаблон(
		"%1%2%3",
		ДанныеШтрихкода[ПараметрыПроверки.ИдентификаторGTIN].Значение,
		ДанныеШтрихкода[ПараметрыПроверки.ИдентификаторДатаПроизводства].Значение,
		ДанныеШтрихкода[ПараметрыПроверки.ИдентификаторНомерПартии].Значение);
	Результат = ДанныеРазбораПартионногоКода(НомераПартии);
	Если Не Результат.Разобран Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЭтоДанныеРазбораОСУ(РезультатРазбора)
	
	Если РезультатРазбора = Неопределено
		Или РезультатРазбора.ДанныеШтрихкода = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбязательныеИдентификаторы   = Новый Соответствие();
	ДополнительныеИдентификаторы = Новый Соответствие();
	ОбязательныеИдентификаторы.Вставить("02", Ложь); // GTIN
	ОбязательныеИдентификаторы.Вставить("37", Ложь); // Количество единиц
	ДополнительныеИдентификаторы.Вставить("310", Ложь); // Вес в килограммах
	ДополнительныеИдентификаторы.Вставить("311", Ложь); // Длина в метрах
	ДополнительныеИдентификаторы.Вставить("335", Ложь); // Объем в литрах
	
	Для Каждого КлючИЗначение Из РезультатРазбора.ДанныеШтрихкода Цикл
		
		Если ОбязательныеИдентификаторы[КлючИЗначение.Ключ] = Неопределено Тогда
			Если ДополнительныеИдентификаторы[КлючИЗначение.Ключ] = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			ОбязательныеИдентификаторы[КлючИЗначение.Ключ] = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ОбязательныеИдентификаторы Цикл
		Если Не КлючИЗначение.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьСоставКодаМаркировкиПоДаннымРазбора(РезультатРазбора, СоставКодаМаркировки)
	
	Если РезультатРазбора = Неопределено
		Или РезультатРазбора.ДанныеШтрихкода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТипаЧисла = Новый ОписаниеТипов("Число");
	
	Если СоставКодаМаркировки.Свойство("ДатаПроизводства")
		И РезультатРазбора.ДанныеШтрихкода["11"] <> Неопределено Тогда
		СоставКодаМаркировки.ДатаПроизводства = РезультатРазбора.ДанныеШтрихкода["11"].Значение;
	КонецЕсли;
	
	Если СоставКодаМаркировки.Свойство("НомерПартии")
		И РезультатРазбора.ДанныеШтрихкода["10"] <> Неопределено Тогда
		СоставКодаМаркировки.НомерПартии = РезультатРазбора.ДанныеШтрихкода["10"].Значение;
	КонецЕсли;
	
	Если РезультатРазбора.ДанныеШтрихкода["37"] <> Неопределено Тогда
		СоставКодаМаркировки.КоличествоВложенныхЕдиниц = СтрокаВЧисло(РезультатРазбора.ДанныеШтрихкода["37"].Значение);
	КонецЕсли;
	
	Если СоставКодаМаркировки.Свойство("МассаНеттоВКг")
		И РезультатРазбора.ДанныеШтрихкода["310"] <> Неопределено Тогда
		СоставКодаМаркировки.МассаНеттоВКг = ОписаниеТипаЧисла.ПривестиЗначение(РезультатРазбора.ДанныеШтрихкода["310"].Значение);
	КонецЕсли;
	
	Если СоставКодаМаркировки.Свойство("ОбъемВЛитрах")
		И РезультатРазбора.ДанныеШтрихкода["335"] <> Неопределено Тогда
		СоставКодаМаркировки.ОбъемВЛитрах = ОписаниеТипаЧисла.ПривестиЗначение(РезультатРазбора.ДанныеШтрихкода["335"].Значение);
	КонецЕсли;
	
	Если СоставКодаМаркировки.Свойство("ДлинаВМетрах")
		И РезультатРазбора.ДанныеШтрихкода["311"] <> Неопределено Тогда
		СоставКодаМаркировки.ДлинаВМетрах = ОписаниеТипаЧисла.ПривестиЗначение(РезультатРазбора.ДанныеШтрихкода["311"].Значение);
	КонецЕсли;
	
КонецПроцедуры

Функция РегулярноеВыражениеПроверкиВнутреннегоНомераПартии() Экспорт
	Возврат "[A-Za-z0-9\/.,-]{1,12}";
КонецФункции

Процедура ЗаполнитьПроверитьДатуПроизводства(ДанныеРазбора, ТекущаяДата)
	
	КаноническаяСтрока = "20" + ДанныеРазбора.ДатаПроизводстваСтрокой;
	
	ПараметрыДаты    = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	ОписаниеТипаДата = Новый ОписаниеТипов("Дата",,, ПараметрыДаты);
	ДатаПроизводства = ОписаниеТипаДата.ПривестиЗначение(КаноническаяСтрока);
	
	Если Не ЗначениеЗаполнено(ДатаПроизводства) Тогда
		
		ДанныеРазбора.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Не является датой: %1'"),
			ДанныеРазбора.ДатаПроизводстваСтрокой);
		
	Иначе
		
		ГодДатыПроизводства = Год(ДатаПроизводства);
		
		Если ГодДатыПроизводства < 2025 Тогда
			
			ДанныеРазбора.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Год даты производства не может быть менее 2025: %1'"),
				ДанныеРазбора.ДатаПроизводстваСтрокой);
				
		ИначеЕсли ГодДатыПроизводства > Год(ТекущаяДата) + 1 Тогда
			
			ДанныеРазбора.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Год даты производства не может быть более %1: %2'"),
				Формат(Год(ТекущаяДата) + 1, "ЧГ=0;"),
				ДанныеРазбора.ДатаПроизводстваСтрокой);
				
		Иначе
			
			ДанныеРазбора.ДатаПроизводства = ДатаПроизводства;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

