////////////////////////////////////////////////////////////////////////////////
// Клиент-серверные процедуры и функции событий форм ИС
//  
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

#Область ДополнительныеСвойстваНоменклатуры

// Настраивает свойства для элементов формы, связанных с дополнительными свойствами номенклатуры.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения.
//   ИсточникДанных - ДанныеФормыЭлементКоллекции - коллекция данных на основании которых нужно настроить свойства элементов,
//                    Структура, Неопределено.
//
Процедура НастроитьЭлементыФормыПоДополнительнымСвойствамНоменклатуры(Форма, ИсточникДанных = Неопределено) Экспорт
	
	ОписаниеДополнительныхСвойствНоменклатуры = Форма[ИнтеграцияИСКлиентСервер.ИмяРеквизитаФормыДополнительныхСвойствНоменклатуры()];
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Для Каждого ОписаниеДСН Из ОписаниеДополнительныхСвойствНоменклатуры Цикл
		
		Если ОписаниеДСН.ДанныеФормыКоллекция
			Или ОписаниеДСН.ИмяЭлементаФормы = "" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОписаниеДСН.ПутьКДанным = Неопределено
			И ИсточникДанных = Неопределено Тогда
			ЭлементДоступен = Ложь;
		Иначе
			Если ОписаниеДСН.ПутьКДанным = Неопределено Тогда
				ДанныеФормы = ИсточникДанных;
			Иначе
				ДанныеФормы = ДанныеФормыПоПутиКДанным(Форма, ОписаниеДСН.ПутьКДанным);
			КонецЕсли;
			Если ОписаниеДСН.ТипЗначенияРеквизитаДСН = ТипБулево Тогда
				ЭлементДоступен = ДанныеФормы[ОписаниеДСН.ИмяРеквизитаДСН];
			Иначе
				ЭлементДоступен = ЗначениеЗаполнено(ДанныеФормы[ОписаниеДСН.ИмяРеквизитаДСН]);
			КонецЕсли;
		КонецЕсли;
		
		Форма.Элементы[ОписаниеДСН.ИмяЭлементаФормы].Видимость = ЭлементДоступен;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает начальное описание дополнительного свойства номенклатуры для формы.
//
// Возвращаемое значение:
//   Структура - из КлючИЗначение:
//    *ПутьКДанным - Строка - путь к источнику данных, например:
//                            "Объект.Товары" - данные находятся в реквизитах таблицы "Товары" реквизита формы "Объект",
//                            "Объект" - данные находятся в реквизитах реквизита формы "Объект",
//                            "Товары" - данные находятся в реквизитах таблицы формы "Товары",
//                            "" - данные находятся непосредственно в реквизитах формы.
//                   Неопределено - источник данных поставляется в отдельном свойстве.
//    *ДанныеФормыКоллекция - Булево - Истина, если данные находятся в коллекции / таблице.
//    *ИмяРеквизитаНоменклатура - Строка - имя реквизита в источнике данных, содержащего ссылку на номенклатуру.
//    *ИмяЭлементаФормы - Строка - имя элемента формы для условного оформления, если ДанныеФормыКоллекция = Истина,
//                                 для настройки элемента формы, если ДанныеФормыКоллекция = Ложь.
//    *ИмяРеквизитаФормы - Строка - имя реквизита с которым связано поле формы.
//                                  Указывается, если отличается от ИмяЭлементаФормы.
//    *ИмяРеквизитаДСН - Строка - для служебного использования.
//    *ТипЗначенияРеквизитаДСН - ОписаниеТипов - для служебного использования.
//    *ЭлементКонструктора - СправочникСсылка.ЭлементыКонструктораВидовПродукцииИС - элемент конструктора, для которого используется ДСН.
//
Функция ОписаниеДополнительногоСвойстваНоменклатурыФормы() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПутьКДанным",              "");
	Результат.Вставить("ДанныеФормыКоллекция",     Ложь);
	Результат.Вставить("ИмяРеквизитаНоменклатура", "Номенклатура");
	Результат.Вставить("ИмяЭлементаФормы",         "");
	Результат.Вставить("ИмяРеквизитаФормы",        "");
	Результат.Вставить("ИмяРеквизитаДСН",          "");
	Результат.Вставить("ТипЗначенияРеквизитаДСН",  Новый ОписаниеТипов("Булево"));
	Результат.Вставить("ЭлементКонструктора",      ПредопределенноеЗначение("Справочник.ЭлементыКонструктораВидовПродукцииИС.ПустаяСсылка"));
	
	Возврат Результат;
	
КонецФункции

// Дополняет описание дополнительных свойств номенклатуры данными элементов конструктора.
//
// Параметры:
//   ОписаниеДополнительныхСвойствНоменклатуры - Массив из см. ОписаниеДополнительногоСвойстваНоменклатурыФормы.
//
Процедура ДополнитьОписаниеДополнительныхСвойствНоменклатурыДаннымиКонструктора(ОписаниеДополнительныхСвойствНоменклатуры) Экспорт
	
	Если ОписаниеДополнительныхСвойствНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыКонструктораСДСН = ОбщегоНазначенияИСКлиентСерверПовтИсп.ЭлементыКонструктораСДополнительнымиСвойствамиНоменклатуры();
	ПрефиксДСН = ИнтеграцияИСКлиентСервер.ПрефиксДополнительногоСвойстваНоменклатуры();
	
	МаксимальныйИндекс = ОписаниеДополнительныхСвойствНоменклатуры.ВГраница();
	Для Индекс = 0 По МаксимальныйИндекс Цикл
		
		ТекущийИндекс = МаксимальныйИндекс - Индекс;
		ОписаниеДСН = ОписаниеДополнительныхСвойствНоменклатуры[ТекущийИндекс];
		
		ЗначениеЭлементаКонструктораСДСН = ЭлементыКонструктораСДСН[ОписаниеДСН.ЭлементКонструктора];
		Если ЗначениеЭлементаКонструктораСДСН = Неопределено Тогда
			ОписаниеДополнительныхСвойствНоменклатуры.Удалить(ТекущийИндекс);
		Иначе
			Если ОписаниеДСН.ИмяРеквизитаФормы = "" Тогда
				ОписаниеДСН.ИмяРеквизитаФормы = ОписаниеДСН.ИмяЭлементаФормы;
			КонецЕсли;
			ОписаниеДСН.ИмяРеквизитаДСН = СтрШаблон("%1%2", ПрефиксДСН, ЗначениеЭлементаКонструктораСДСН.Имя);
			ОписаниеДСН.ТипЗначенияРеквизитаДСН = ЗначениеЭлементаКонструктораСДСН.ТипЗначения;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает имя реквизита дополнительного свойства номенклатуры, связанного с указанным именем реквизита.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения.
//   ИмяРеквизита - Строка.
//
// Возвращаемое значение:
//  Строка - имя реквизита дополнительного свойства номенклатуры,
//  Неопределено - если имя реквизита не найдено.
//
Функция ИмяРеквизитаДополнительногоСвойстваФормы(Форма, ИмяРеквизита) Экспорт
	
	Описания = Форма[ИнтеграцияИСКлиентСервер.ИмяРеквизитаФормыДополнительныхСвойствНоменклатуры()];
	
	Для Каждого Описание Из Описания Цикл
		Если Описание.ИмяРеквизитаФормы = ИмяРеквизита Тогда
			Возврат Описание.ИмяРеквизитаДСН;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДополнительныеСвойстваНоменклатуры

Функция ДанныеФормыПоПутиКДанным(Форма, ПутьКДанным) Экспорт
	
	Если ПутьКДанным = "" Тогда
		Возврат Форма;
	Иначе
		ПозицияТочки = СтрНайти(ПутьКДанным, ".");
		Если ПозицияТочки = 0 Тогда
			Возврат Форма[ПутьКДанным];
		Иначе
			Возврат Форма[Лев(ПутьКДанным, ПозицияТочки - 1)][Сред(ПутьКДанным, ПозицияТочки + 1)];
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецОбласти
