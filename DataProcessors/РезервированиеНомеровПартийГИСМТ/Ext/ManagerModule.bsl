#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает текст запроса для расчета статусов указания серий
//	Параметры:
//	 ПараметрыУказанияСерий - Структура - состав полей задается в функции ПроверкаИПодборПродукцииИСМП.ПараметрыУказанияСерий
//	Возвращаемое значение:
//	 (См. ИнтеграцияИС.ТекстЗапросаЗаполненияСтатусовУказанияСерий).
Функция ТекстЗапросаЗаполненияСтатусовУказанияСерий(ПараметрыУказанияСерий) Экспорт
	
	Возврат ИнтеграцияИС.ТекстЗапросаЗаполненияСтатусовУказанияСерий(
		Метаданные.Обработки.РезервированиеНомеровПартийГИСМТ, ПараметрыУказанияСерий);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает параметры указания серий для товаров, указанных в документе.
//
// Параметры:
//  Объект - Структура - структура значений реквизитов объекта, необходимых для заполнения параметров указания серий.
// 
// Возвращаемое значение:
//  Произвольный - параметры указания серий
//
Функция ПараметрыУказанияСерий(Объект) Экспорт
	
	Возврат ИнтеграцияИС.ПараметрыУказанияСерий(Метаданные.Обработки.РезервированиеНомеровПартийГИСМТ, Объект);
	
КонецФункции

//Имена реквизитов, от значений которых зависят параметры указания серий
//
//	Возвращаемое значение:
//		Строка - имена реквизитов, перечисленные через запятую
//
Функция ИменаРеквизитовДляЗаполненияПараметровУказанияСерий() Экспорт
	
	Возврат ИнтеграцияИС.ИменаРеквизитовДляЗаполненияПараметровУказанияСерий(Метаданные.Обработки.РезервированиеНомеровПартийГИСМТ);
	
КонецФункции

// Запрос метода интерфейса с обработкой.
// 
// Параметры:
//  ПараметрыОбработки - см. ИнтерфейсИСМПОбщегоНазначенияКлиент.ПараметрыОбработкиЗапросаДанных
// Возвращаемое значение:
//  см. ДлительныеОперации.ВыполнитьВФоне
//  - Неопределено
Функция ЗапросМетодаИнтерфейсаСОбработкой(ПараметрыОбработки) Экспорт
	
	ДлительнаяОперация = Неопределено;
	ДоступныеМетодыИнтерфейса = ИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ДоступныеМетодыИнтерфейса();
	
	Если ПараметрыОбработки.ИмяОбработчика = ДоступныеМетодыИнтерфейса.ЗагрузитьНомераПартийГИСМТ Тогда
		
		ПараметрыОбработки.ВыполнениеВФоне = Истина;
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ПараметрыОбработки.УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Загрузка номеров партий ГИС МТ'");
		
		ПараметрыФоновогоЗадания = Новый Структура;
		ПараметрыФоновогоЗадания.Вставить("Организация",                      ПараметрыОбработки.Организация);
		ПараметрыФоновогоЗадания.Вставить("ПараметрыЛогированияЗапросовИСМП", ПараметрыСеанса.ПараметрыЛогированияЗапросовИСМП);
		ИнтеграцияИСПереопределяемый.НастроитьДлительнуюОперацию(ПараметрыФоновогоЗадания, ПараметрыВыполнения);
		
		ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
			"Обработки.РезервированиеНомеровПартийГИСМТ.ЗагрузитьЗарезервированныеНомераПартийДлительнаяОперация",
			ПараметрыФоновогоЗадания, ПараметрыВыполнения);
	
	ИначеЕсли ПараметрыОбработки.ИмяОбработчика = ДоступныеМетодыИнтерфейса.РезервироватьНомераПартийГИСМТ Тогда
		
		ПараметрыОбработки.ВыполнениеВФоне = Истина;
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ПараметрыОбработки.УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Генерация и резервирование номеров партий ГИС МТ'");
		
		ПараметрыФоновогоЗадания = Новый Структура;
		ПараметрыФоновогоЗадания.Вставить("Организация",                      ПараметрыОбработки.Организация);
		ПараметрыФоновогоЗадания.Вставить("ТоварнаяГруппа",                   ПараметрыОбработки.ТоварнаяГруппа);
		ПараметрыФоновогоЗадания.Вставить("ПараметрыЛогированияЗапросовИСМП", ПараметрыСеанса.ПараметрыЛогированияЗапросовИСМП);
		ПараметрыФоновогоЗадания.Вставить("ДанныеДляОбработки",               ПараметрыОбработки.Параметры);
		ИнтеграцияИСПереопределяемый.НастроитьДлительнуюОперацию(ПараметрыФоновогоЗадания, ПараметрыВыполнения);
		
		ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
			"Обработки.РезервированиеНомеровПартийГИСМТ.РезервированиеНомеровПартийДлительнаяОперация",
			ПараметрыФоновогоЗадания, ПараметрыВыполнения);
	
	ИначеЕсли ПараметрыОбработки.ИмяОбработчика = ДоступныеМетодыИнтерфейса.ОстаткиВиртуальногоСклада Тогда
		
		ПараметрыОбработки.ВыполнениеВФоне = Истина;
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ПараметрыОбработки.УникальныйИдентификатор);
		ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Загрузка номеров партий ГИС МТ'");
		
		ПараметрыФоновогоЗадания = Новый Структура;
		ПараметрыФоновогоЗадания.Вставить("Организация",                      ПараметрыОбработки.Организация);
		ПараметрыФоновогоЗадания.Вставить("GTIN",                             ПараметрыОбработки.Параметры.GTIN);
		ПараметрыФоновогоЗадания.Вставить("ПараметрыЛогированияЗапросовИСМП", ПараметрыСеанса.ПараметрыЛогированияЗапросовИСМП);
		ИнтеграцияИСПереопределяемый.НастроитьДлительнуюОперацию(ПараметрыФоновогоЗадания, ПараметрыВыполнения);
		
		ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
			"Обработки.РезервированиеНомеровПартийГИСМТ.ОстаткиВиртуальногоСкладаДлительнаяОперация",
			ПараметрыФоновогоЗадания, ПараметрыВыполнения);
			
	КонецЕсли;
	
	Возврат ДлительнаяОперация;
	
КонецФункции

Процедура ЗагрузитьЗарезервированныеНомераПартийДлительнаяОперация(ПараметрыФоновогоЗадания, АдресРезультата) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки",                     Ложь);
	ВозвращаемоеЗначение.Вставить("ТребуетсяОбновлениеКлючаСессии", Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",                    "");
	
	Организация                      = ПараметрыФоновогоЗадания.Организация;
	ПараметрыЛогированияЗапросовИСМП = ПараметрыФоновогоЗадания.ПараметрыЛогированияЗапросовИСМП;
	
	ЛогированиеЗапросовИСМП.УстановитьПараметрыЛогированияЗапросов(ПараметрыЛогированияЗапросовИСМП);
	ЛогированиеЗапросовИС.НастроитьПараметрыЛогированияВФоновомЗадании(ПараметрыЛогированияЗапросовИСМП);
	ЛогированиеЗапросовИСМП.УстановитьПараметрыЛогированияЗапросов(ПараметрыЛогированияЗапросовИСМП);
	
	РезультатЗапроса = ИнтерфейсИСМП.ЗарезервированныеНомераПартий(Организация);
	
	ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии = РезультатЗапроса.ТребуетсяОбновлениеКлючаСессии;
	ВозвращаемоеЗначение.ТекстОшибки                    = РезультатЗапроса.ТекстОшибки;
	ВозвращаемоеЗначение.ЕстьОшибки                     = ЗначениеЗаполнено(РезультатЗапроса.ТекстОшибки);
	
	ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
	
	Если ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии
		Или ВозвращаемоеЗначение.ЕстьОшибки Тогда
		ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
		Возврат;
	КонецЕсли;
	
	НомераПартий = РегистрыСведений.НомераПартийГИСМТ.СоздатьНаборЗаписей().Выгрузить();
	Для Каждого СтрокаДанных Из РезультатЗапроса.Данные Цикл
		НоваяСтрока                  = НомераПартий.Добавить();
		НоваяСтрока.НомерПартии      = СтрокаДанных.НомерПартии;
		НоваяСтрока.ДатаПроизводства = СтрокаДанных.ДатаПроизводства;
		НоваяСтрока.GTIN             = СтрокаДанных.GTIN;
		НоваяСтрока.Организация      = Организация;
		НоваяСтрока.Статус           = Перечисления.СтатусыНомеровПартийГИСМТ.Зарезервирован;
	КонецЦикла;
	
	СписокЗапросов = Новый СписокЗначений;
	Запрос         = Новый Запрос;
	
	ПустаяНоменклатура = ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("Номенклатура");
	Запрос.УстановитьПараметр("НомераПартий",          НомераПартий);
	Запрос.УстановитьПараметр("СтатусЗарезервирован",  Перечисления.СтатусыНомеровПартийГИСМТ.Зарезервирован);
	Запрос.УстановитьПараметр("СтатусЗарегистрирован", Перечисления.СтатусыНомеровПартийГИСМТ.Зарегистрирован);
	Запрос.УстановитьПараметр("ПустаяНоменклатура",    ПустаяНоменклатура);
	
	СписокЗапросов.Добавить(
		"ВЫБРАТЬ
		|	НомераПартий.Организация      КАК Организация,
		|	НомераПартий.НомерПартии      КАК НомерПартии,
		|	НомераПартий.GTIN             КАК GTIN,
		|	НомераПартий.Статус           КАК Статус,
		|	НомераПартий.ДатаПроизводства КАК ДатаПроизводства
		|ПОМЕСТИТЬ НомераПартий
		|ИЗ
		|	&НомераПартий КАК НомераПартий");
	
	СписокЗапросов.Добавить(
		"ВЫБРАТЬ
		|	НомераПартий.Организация         КАК Организация,
		|	НомераПартий.НомерПартии         КАК НомерПартии,
		|	НомераПартий.GTIN                КАК GTIN,
		|	НомераПартий.Статус              КАК Статус,
		|	НомераПартий.ДатаПроизводства    КАК ДатаПроизводства,
		|	ЕСТЬNULL(НомераПартийГИСМТ.Номенклатура, &ПустаяНоменклатура) КАК Номенклатура,
		|	НомераПартийГИСМТ.Характеристика КАК Характеристика,
		|	НомераПартийГИСМТ.Серия          КАК Серия
		|ИЗ
		|	НомераПартий КАК НомераПартий
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераПартийГИСМТ КАК НомераПартийГИСМТ
		|		ПО НомераПартийГИСМТ.НомерПартии = НомераПартий.НомерПартии
		|		И НомераПартийГИСМТ.Организация = НомераПартий.Организация
		|ГДЕ
		|	НомераПартийГИСМТ.НомерПартии ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НомераПартийГИСМТ.Организация      КАК Организация,
		|	НомераПартийГИСМТ.НомерПартии      КАК НомерПартии,
		|	НомераПартийГИСМТ.GTIN             КАК GTIN,
		|	&СтатусЗарегистрирован             КАК Статус,
		|	НомераПартийГИСМТ.ДатаПроизводства КАК ДатаПроизводства,
		|	НомераПартийГИСМТ.Номенклатура     КАК Номенклатура,
		|	НомераПартийГИСМТ.Характеристика   КАК Характеристика,
		|	НомераПартийГИСМТ.Серия            КАК Серия
		|ИЗ
		|	РегистрСведений.НомераПартийГИСМТ КАК НомераПартийГИСМТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ НомераПартий КАК НомераПартий
		|		ПО НомераПартийГИСМТ.НомерПартии = НомераПартий.НомерПартии
		|		И НомераПартийГИСМТ.Организация = НомераПартий.Организация
		|ГДЕ
		|	НомераПартий.НомерПартии ЕСТЬ NULL
		|	И НомераПартийГИСМТ.Статус = &СтатусЗарезервирован
		|",
		"ТаблицаНомеровПартий");
	
	НачатьТранзакцию();
	
	Попытка
		
		ПоляБлокировки = Новый Структура;
		ПоляБлокировки.Вставить("Организация", Организация);
		
		ОбщегоНазначенияИС.УстановитьУправляемуюБлокировку(
			Метаданные.РегистрыСведений.НомераПартийГИСМТ.ПолноеИмя(), ПоляБлокировки);
		
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = ОбщегоНазначенияИС.ВыполнитьПакетЗапросов(Запрос, СписокЗапросов);
		
		//@skip-warning
		НомераПартий = РезультатЗапроса["ТаблицаНомеровПартий"].Выгрузить();
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Номенклатура", ПустаяНоменклатура);
		СтрокиБезНоменклатуры = НомераПартий.НайтиСтроки(СтруктураПоиска);
		
		ЗаполнитьНоменклатуруПоGTIN(СтрокиБезНоменклатуры, ВозвращаемоеЗначение);
		
		Если НомераПартий.Количество()
			И Не ВозвращаемоеЗначение.ЕстьОшибки
			И Не ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии Тогда
			НаборЗаписей = РегистрыСведений.НомераПартийГИСМТ.СоздатьНаборЗаписей();
			НаборЗаписей.Загрузить(НомераПартий);
			НаборЗаписей.Записать(РежимЗамещения.Слияние);
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
	
КонецПроцедуры

Процедура РезервированиеНомеровПартийДлительнаяОперация(ПараметрыФоновогоЗадания, АдресРезультата) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки",                     Ложь);
	ВозвращаемоеЗначение.Вставить("ТребуетсяОбновлениеКлючаСессии", Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",                    "");
	ВозвращаемоеЗначение.Вставить("НомераПартий",                   Новый Массив);
	ВозвращаемоеЗначение.Вставить("КлючиЗаписей",                   Новый Массив);
	
	ПараметрыОбработки               = ПараметрыФоновогоЗадания.ДанныеДляОбработки;
	Организация                      = ПараметрыФоновогоЗадания.Организация;
	ТоварнаяГруппа                   = ПараметрыФоновогоЗадания.ТоварнаяГруппа;
	ПараметрыЛогированияЗапросовИСМП = ПараметрыФоновогоЗадания.ПараметрыЛогированияЗапросовИСМП;
	КлючиСтрок                       = Новый Соответствие();
	
	ЛогированиеЗапросовИСМП.УстановитьПараметрыЛогированияЗапросов(ПараметрыЛогированияЗапросовИСМП);
	ЛогированиеЗапросовИС.НастроитьПараметрыЛогированияВФоновомЗадании(ПараметрыЛогированияЗапросовИСМП);
	ЛогированиеЗапросовИСМП.УстановитьПараметрыЛогированияЗапросов(ПараметрыЛогированияЗапросовИСМП);
	
	ТаблицаГенерации = РегистрыСведений.НомераПартийГИСМТ.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаГенерации.Колонки.Добавить("КоличествоНомеровПартий", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	
	ТаблицаГенерации.Индексы.Добавить("GTIN,ДатаПроизводства");
	
	НаборЗаписейРезервирование = РегистрыСведений.НомераПартийГИСМТ.СоздатьНаборЗаписей();
	
	Для Каждого СтрокаДанных Из ПараметрыОбработки.СтрокиОбработки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДанных.ВнутреннийНомерПартии) Тогда
			
			НоваяСтрока = НаборЗаписейРезервирование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
			НомерПартии = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.НомерПартииПоШтрихкодуEAN(
				СтрокаДанных.GTIN, СтрокаДанных.ДатаПроизводства, СтрокаДанных.ВнутреннийНомерПартии);
			НоваяСтрока.НомерПартии = НомерПартии;
			
		ИначеЕсли СтрокаДанных.КоличествоНомеровПартий > 0 Тогда
			
			НоваяСтрока = ТаблицаГенерации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		Иначе
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.Статус      = Перечисления.СтатусыНомеровПартийГИСМТ.Зарезервирован;
		КлючиСтрок.Вставить(НоваяСтрока, СтрокаДанных.КлючСтроки);
		
	КонецЦикла;
	
	Если НаборЗаписейРезервирование.Количество() Тогда
		
		РезультатЗапроса = ИнтерфейсИСМП.ЗарезервироватьНомераПартий(
			Организация,
			ТоварнаяГруппа,
			НаборЗаписейРезервирование.ВыгрузитьКолонку("НомерПартии"));
		
		Если РезультатЗапроса.ТребуетсяОбновлениеКлючаСессии Тогда
			ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии = Истина;
			ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
			Возврат;
		ИначеЕсли ЗначениеЗаполнено(РезультатЗапроса.ТекстОшибки) Тогда
			ВозвращаемоеЗначение.ТекстОшибки = РезультатЗапроса.ТекстОшибки;
			ВозвращаемоеЗначение.ЕстьОшибки  = Истина;
			ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		НачатьТранзакцию();
	
		Попытка
			
			ПоляБлокировки = Новый Структура;
			ПоляБлокировки.Вставить("Организация", Организация);
			
			ОбщегоНазначенияИС.УстановитьУправляемуюБлокировку(
				Метаданные.РегистрыСведений.НомераПартийГИСМТ.ПолноеИмя(), ПоляБлокировки);
			
			УстановитьПривилегированныйРежим(Истина);
			НаборЗаписейРезервирование.Записать(РежимЗамещения.Слияние);
			УстановитьПривилегированныйРежим(Ложь);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			
			ВозвращаемоеЗначение.ЕстьОшибки  = Истина;
			ВозвращаемоеЗначение.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Ошибка при записи сгенерированных номеров партий ГИС МТ: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
			Возврат;
			
		КонецПопытки;
		
		Для Каждого СтрокаТаблицы Из НаборЗаписейРезервирование Цикл
			
			НоваяСтрока = СтрокаРезультатаРезервирования();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.КлючСтроки = КлючиСтрок[СтрокаТаблицы];
			ВозвращаемоеЗначение.НомераПартий.Добавить(НоваяСтрока);
			
			ПоляКлюча = Новый Структура;
			ПоляКлюча.Вставить("Организация");
			ПоляКлюча.Вставить("Номенклатура");
			ПоляКлюча.Вставить("Характеристика");
			ПоляКлюча.Вставить("Серия");
			ПоляКлюча.Вставить("НомерПартии");
			ЗаполнитьЗначенияСвойств(ПоляКлюча, НоваяСтрока);
			Ключ = РегистрыСведений.НомераПартийГИСМТ.СоздатьКлючЗаписи(ПоляКлюча);
			ВозвращаемоеЗначение.КлючиЗаписей.Добавить(Ключ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТаблицаГенерации.Количество() Тогда
	
		СвернутаяТаблица = ТаблицаГенерации.Скопировать();
		СвернутаяТаблица.Свернуть("GTIN,ДатаПроизводства", "КоличествоНомеровПартий");
	
		РезультатЗапроса = ИнтерфейсИСМП.СгенерироватьНомераПартий(
			Организация,
			ТоварнаяГруппа,
			СвернутаяТаблица);
		
		Если РезультатЗапроса.ТребуетсяОбновлениеКлючаСессии Тогда
			ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии = Истина;
			ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
			Возврат;
		ИначеЕсли ЗначениеЗаполнено(РезультатЗапроса.ТекстОшибки) Тогда
			ВозвращаемоеЗначение.ТекстОшибки = РезультатЗапроса.ТекстОшибки;
			ВозвращаемоеЗначение.ЕстьОшибки  = Истина;
			ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
			Возврат;
		КонецЕсли;
		
		ТаблицаДанных = РегистрыСведений.НомераПартийГИСМТ.СоздатьНаборЗаписей().Выгрузить();
		СтрокиБезНоменклатуры = Новый Массив;
		
		Для Каждого СтрокаРезультат Из РезультатЗапроса.Данные Цикл
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("GTIN",             СтрокаРезультат.GTIN);
			СтруктураПоиска.Вставить("ДатаПроизводства", СтрокаРезультат.ДатаПроизводства);
			
			СтрокиИсходнойТаблицы = ТаблицаГенерации.НайтиСтроки(СтруктураПоиска);
			Распределен           = Ложь;
			
			Для Каждого СтрокаИсходнойТаблицы Из СтрокиИсходнойТаблицы Цикл
				
				Если СтрокаИсходнойТаблицы.КоличествоНомеровПартий = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаДанных.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
				НоваяСтрока.НомерПартии = СтрокаРезультат.НомерПартии;
				КлючиСтрок.Вставить(НоваяСтрока, КлючиСтрок[СтрокаИсходнойТаблицы]);
				
				СтрокаИсходнойТаблицы.КоличествоНомеровПартий = СтрокаИсходнойТаблицы.КоличествоНомеровПартий - 1;
				Распределен = Истина;
				Прервать;
				
			КонецЦикла;
			
			Если Не Распределен Тогда
				
				НоваяСтрока = ТаблицаДанных.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультат);
				НоваяСтрока.Статус      = Перечисления.СтатусыНомеровПартийГИСМТ.Зарезервирован;
				НоваяСтрока.Организация = Организация;
				НоваяСтрока.НомерПартии = СтрокаРезультат.НомерПартии;
				
				СтрокиБезНоменклатуры.Добавить(НоваяСтрока);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаполнитьНоменклатуруПоGTIN(СтрокиБезНоменклатуры, ВозвращаемоеЗначение);
		НачатьТранзакцию();
		Попытка
			
			ПоляБлокировки = Новый Структура;
			ПоляБлокировки.Вставить("Организация", Организация);
			
			ОбщегоНазначенияИС.УстановитьУправляемуюБлокировку(
				Метаданные.РегистрыСведений.НомераПартийГИСМТ.ПолноеИмя(), ПоляБлокировки);
			
			НаборЗаписей = РегистрыСведений.НомераПартийГИСМТ.СоздатьНаборЗаписей();
			НаборЗаписей.Загрузить(ТаблицаДанных);
			УстановитьПривилегированныйРежим(Истина);
			НаборЗаписей.Записать(РежимЗамещения.Слияние);
			УстановитьПривилегированныйРежим(Ложь);
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			
			ВозвращаемоеЗначение.ЕстьОшибки  = Истина;
			ВозвращаемоеЗначение.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Ошибка при записи сгенерированных номеров партий ГИС МТ: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
			
		КонецПопытки;
		
		Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			
			НоваяСтрока = СтрокаРезультатаРезервирования();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.КлючСтроки = КлючиСтрок[СтрокаТаблицы];
			ВозвращаемоеЗначение.НомераПартий.Добавить(НоваяСтрока);
			
			ПоляКлюча = Новый Структура;
			ПоляКлюча.Вставить("Организация");
			ПоляКлюча.Вставить("Номенклатура");
			ПоляКлюча.Вставить("Характеристика");
			ПоляКлюча.Вставить("Серия");
			ПоляКлюча.Вставить("НомерПартии");
			ЗаполнитьЗначенияСвойств(ПоляКлюча, НоваяСтрока);
			Ключ = РегистрыСведений.НомераПартийГИСМТ.СоздатьКлючЗаписи(ПоляКлюча);
			ВозвращаемоеЗначение.КлючиЗаписей.Добавить(Ключ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
	ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
	
КонецПроцедуры

Функция СтрокаРезультатаРезервирования()
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Организация");
	ВозвращаемоеЗначение.Вставить("Номенклатура");
	ВозвращаемоеЗначение.Вставить("Характеристика");
	ВозвращаемоеЗначение.Вставить("Серия");
	ВозвращаемоеЗначение.Вставить("НомерПартии");
	ВозвращаемоеЗначение.Вставить("GTIN");
	ВозвращаемоеЗначение.Вставить("ДатаПроизводства");
	ВозвращаемоеЗначение.Вставить("Статус");
	ВозвращаемоеЗначение.Вставить("КлючСтроки");
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Процедура ОстаткиВиртуальногоСкладаДлительнаяОперация(ПараметрыФоновогоЗадания, АдресРезультата) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ЕстьОшибки",                     Ложь);
	ВозвращаемоеЗначение.Вставить("ТребуетсяОбновлениеКлючаСессии", Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",                    "");
	ВозвращаемоеЗначение.Вставить("ОстаткиПоGTIN",                  Новый Массив);
	
	Организация                      = ПараметрыФоновогоЗадания.Организация;
	GTIN                             = ПараметрыФоновогоЗадания.GTIN;
	ПараметрыЛогированияЗапросовИСМП = ПараметрыФоновогоЗадания.ПараметрыЛогированияЗапросовИСМП;
	
	ЛогированиеЗапросовИСМП.УстановитьПараметрыЛогированияЗапросов(ПараметрыЛогированияЗапросовИСМП);
	ЛогированиеЗапросовИС.НастроитьПараметрыЛогированияВФоновомЗадании(ПараметрыЛогированияЗапросовИСМП);
	ЛогированиеЗапросовИСМП.УстановитьПараметрыЛогированияЗапросов(ПараметрыЛогированияЗапросовИСМП);
	
	ПараметрыНавигации = Новый Структура;
	ПараметрыНавигации.Вставить("НомерСтраницы", 0);
	ПараметрыНавигации.Вставить("ЗаписейНаСтранице", 1000);
	
	ЕстьДанныеНаСтранице = Истина;
	
	Пока ЕстьДанныеНаСтранице Цикл
		
		РезультатПолученияДанных = ИнтерфейсИСМП.ОстатокGTINПоДаннымВиртуальногоБаланса(
			Организация,
			GTIN,
			Истина,
			ПараметрыНавигации);
		
		Если РезультатПолученияДанных.ТребуетсяОбновлениеКлючаСессии Тогда
			ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии = Истина;
			Прервать;
		ИначеЕсли ЗначениеЗаполнено(РезультатПолученияДанных.ТекстОшибки) Тогда
			ВозвращаемоеЗначение.ТекстОшибки = РезультатПолученияДанных.ТекстОшибки;
			ВозвращаемоеЗначение.ЕстьОшибки  = Истина;
			Прервать;
		КонецЕсли;
		
		ЕстьДанныеНаСтранице = Ложь;
			
		Для Каждого СтрокаОтвет Из РезультатПолученияДанных.ОстаткиПоGTIN Цикл
			
			СтрокаОтвет.Вставить("Номенклатура");
			СтрокаОтвет.Вставить("Характеристика");
			СтрокаОтвет.Вставить("ПредставлениеСопоставления");
			ЕстьДанныеНаСтранице = Истина;
			ВозвращаемоеЗначение.ОстаткиПоGTIN.Добавить(СтрокаОтвет);
			
		КонецЦикла;
		
		ПараметрыНавигации.НомерСтраницы = ПараметрыНавигации.НомерСтраницы + 1;
		Если ЕстьДанныеНаСтранице
			И ЗначениеЗаполнено(GTIN)
			И GTIN.Количество() <= ПараметрыНавигации.ЗаписейНаСтранице Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьНоменклатуруПоGTIN(ВозвращаемоеЗначение.ОстаткиПоGTIN, ВозвращаемоеЗначение);
	
	ЛогированиеЗапросовИСМП.ЗаполнитьВозвращаемыеДанныеФоновогоЗадания(ВозвращаемоеЗначение);
	
	ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресРезультата);
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	
	Методы.Вставить("ЗагрузитьЗарезервированныеНомераПартийДлительнаяОперация", Истина);
	Методы.Вставить("РезервированиеНомеровПартийДлительнаяОперация", Истина);
	Методы.Вставить("ОстаткиВиртуальногоСкладаДлительнаяОперация", Истина);
	
КонецПроцедуры

Процедура ЗаполнитьНоменклатуруПоGTIN(СтрокиБезНоменклатуры, ВозвращаемоеЗначение)
	
	ШтрихкодыEAN = Новый Массив;
	Для Каждого СтрокаТовары Из СтрокиБезНоменклатуры Цикл
		ШтрихкодыEAN.Добавить(СтрокаТовары.GTIN);
	КонецЦикла;
	
	Если ШтрихкодыEAN.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШтрихкодыEAN = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ШтрихкодыEAN);
	
	ДанныеПоШтрихкодамEANРезультат = ШтрихкодированиеОбщегоНазначенияИС.ДанныеПоШтрихкодамEAN(
		ШтрихкодыEAN,,, Истина);
	Если ДанныеПоШтрихкодамEANРезультат.ТребуетсяОбновлениеКлючаСессии Тогда
		ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии = Истина;
	ИначеЕсли ЗначениеЗаполнено(ДанныеПоШтрихкодамEANРезультат.ТекстОшибки) Тогда
		ВозвращаемоеЗначение.ТекстОшибки = ДанныеПоШтрихкодамEANРезультат.ТекстОшибки;
		ВозвращаемоеЗначение.ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ВозвращаемоеЗначение.ЕстьОшибки И Не ВозвращаемоеЗначение.ТребуетсяОбновлениеКлючаСессии Тогда
	
		ИнформацияПоШтрихкодамEAN = ДанныеПоШтрихкодамEANРезультат.ДанныеПоШтрихкодамEAN;
		ПараметрыОтбора = Новый Структура("ШтрихкодEAN", Неопределено);
		
		ЕстьКолонкаПредставлениеСопоставления = Неопределено;
		Для Каждого СтрокаПриемник Из СтрокиБезНоменклатуры Цикл
			ПараметрыОтбора.ШтрихкодEAN = СтрокаПриемник.GTIN;
			НайденныеСтроки = ИнформацияПоШтрихкодамEAN.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество() = 1 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаПриемник, НайденныеСтроки[0], "Номенклатура, Характеристика");
			ИначеЕсли НайденныеСтроки.Количество() > 1
				И ЕстьКолонкаПредставлениеСопоставления <> Ложь Тогда
				Если ЕстьКолонкаПредставлениеСопоставления = Неопределено Тогда
					ЕстьКолонкаПредставлениеСопоставления = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
						СтрокаПриемник, "ПредставлениеСопоставления");
					Если Не ЕстьКолонкаПредставлениеСопоставления Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				ДанныеПредставления = Новый Массив();
				ДанныеПредставления.Добавить(
					ОбщегоНазначенияИС.ПредставлениеНоменклатуры(
						НайденныеСтроки[0].Номенклатура, НайденныеСтроки[0].Характеристика));
				ДанныеПредставления.Добавить(СтрШаблон("(+ еще %1)", НайденныеСтроки.Количество() - 1));
				СтрокаПриемник.ПредставлениеСопоставления = СтрСоединить(ДанныеПредставления, " ");
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

