#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	НепроверяемыеРеквизиты.Добавить("Товары.Характеристика");
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		ОписаниеДанных = РегистрыСведений.НомераПартийГИСМТ.СоздатьНаборЗаписей();
		ОписаниеДанных.Отбор.Организация.Установить(Организация);
		ПроверяемаяТаблица = Товары.Выгрузить();
		ПроверяемаяТаблица.Колонки.Добавить("Организация", Метаданные.ОпределяемыеТипы.Организация.Тип);
		ПроверяемаяТаблица.ЗаполнитьЗначения(Организация, "Организация");
		ОписаниеДанных.Загрузить(ПроверяемаяТаблица);
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		ИзменениеРазрешено = МодульУправлениеДоступом.ИзменениеРазрешено(ОписаниеДанных);
		Если Не ИзменениеРазрешено Тогда
			ОбщегоНазначения.СообщитьПользователю(
				НСтр("ru = 'Отсутствуют права доступа на изменение номеров партий ГИС МТ. Обратитесь к администратору.'"),,
				"Организация",
				"Объект",
				Отказ);
		КонецЕсли;
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ИнтеграцияИСМППереопределяемый.ПриОпределенииОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли