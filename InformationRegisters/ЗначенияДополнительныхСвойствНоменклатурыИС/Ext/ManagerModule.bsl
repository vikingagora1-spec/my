// Возвращает значения дополнительных свойств номенклатуры.
//
// Параметры:
//  Номенклатура - ОпределяемыйТип.Номенклатура,
//                 Массив из ОпределяемыйТип.Номенклатура.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - ОпределяемыйТип.Номенклатура.
//   * Значение - Соответствие из КлючИЗначение:
//     * Ключ1     - СправочникСсылка.ЭлементыКонструктораВидовПродукцииИС - элемент конструктора.
//     * Значение1 - ОпределяемыйТип.ЗначениеЭлементаКонструктораВидовПродукцииИС - значение.
//
Функция ЗначенияПоНоменклатуре(Номенклатура) Экспорт
	
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		МассивНоменклатуры = Номенклатура;
	Иначе
		МассивНоменклатуры = Новый Массив;
		МассивНоменклатуры.Добавить(Номенклатура);
	КонецЕсли;
	
	Результат = Новый Соответствие;
	
	Для Каждого ТекущаяНоменклатура Из МассивНоменклатуры Цикл
		Результат.Вставить(ТекущаяНоменклатура, Новый Соответствие);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияДополнительныхСвойствНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЗначенияДополнительныхСвойствНоменклатуры.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ЗначенияДополнительныхСвойствНоменклатуры.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхСвойствНоменклатурыИС КАК ЗначенияДополнительныхСвойствНоменклатуры
	|ГДЕ
	|	ЗначенияДополнительныхСвойствНоменклатуры.Номенклатура В (&Номенклатура)";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат[Выборка.Номенклатура].Вставить(Выборка.ЭлементКонструктора, Выборка.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Записывает значения дополнительных свойств номенклатуры.
//
// Параметры:
//  Номенклатура - ОпределяемыйТип.Номенклатура.
//  Значения - Соответствие из КлючИЗначение:
//   * Ключ     - СправочникСсылка.ЭлементыКонструктораВидовПродукцииИС - элемент конструктора.
//   * Значение - ОпределяемыйТип.ЗначениеЭлементаКонструктораВидовПродукцииИС - значение.
//
Процедура ЗаписатьЗначенияПоНоменклатуре(Номенклатура, Значения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗначенияДополнительныхСвойствНоменклатурыИС");
	ЭлементБлокировки.УстановитьЗначение("Номенклатура", Номенклатура);
	
	НачатьТранзакцию();
	
	Попытка
		
		БлокировкаДанных.Заблокировать();
		
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Номенклатура.Установить(Номенклатура);
		
		Для Каждого ЭлементЗначения Из Значения Цикл
			Запись = НаборЗаписей.Добавить();
			Запись.Номенклатура = Номенклатура;
			Запись.ЭлементКонструктора = ЭлементЗначения.Ключ;
			Запись.Значение = ЭлементЗначения.Значение;
		КонецЦикла;
		
		НаборЗаписей.Записать();
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли