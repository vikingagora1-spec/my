#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Замещение Тогда
		ЭлементКонструктора = Отбор.ЭлементКонструктора.Значение;
		Если ЗначениеЗаполнено(ЭлементКонструктора) Тогда
			ПараметрыЭлемента = Справочники.ЭлементыКонструктораВидовПродукцииИС.ПараметрыЭлементаКонструктора(ЭлементКонструктора);
			Если ПараметрыЭлемента.КаждомуВидуПродукцииСоответствуетОдноЗначение Тогда
				ВидыПродукции = Новый Массив;
				Для Каждого Запись Из ЭтотОбъект Цикл
					Если ЗначениеЗаполнено(Запись.ВидПродукции) Тогда
						Если ВидыПродукции.Найти(Запись.ВидПродукции) <> Неопределено Тогда
							СообщитьОбОшибкеКонтроляУникальности(Запись.ВидПродукции, Отказ);
							Возврат;
						КонецЕсли;
						ВидыПродукции.Добавить(Запись.ВидПродукции);
					КонецЕсли;
				КонецЦикла;
				ВыполнитьПроверкуКонтроляУникальностиПоВидуПродукции(ЭлементКонструктора, ВидыПродукции, Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементКонструктора = Отбор.ЭлементКонструктора.Значение;
	Если ЗначениеЗаполнено(ЭлементКонструктора) Тогда
		ПараметрыЭлемента = Справочники.ЭлементыКонструктораВидовПродукцииИС.ПараметрыЭлементаКонструктора(ЭлементКонструктора);
		Если ПараметрыЭлемента.НастройкиДополнительногоСвойстваНоменклатуры <> Неопределено Тогда
			Колонки = "ЭлементКонструктора, ВидПродукции";
			ТаблицаДанных = Выгрузить(, Колонки);
			Если Количество() = 0 Тогда
				Если ЗначениеЗаполнено(Отбор.ВидПродукции.Значение) Тогда
					СтрокаТаблицыДанных = ТаблицаДанных.Добавить();
					СтрокаТаблицыДанных.ЭлементКонструктора = ЭлементКонструктора;
					СтрокаТаблицыДанных.ВидПродукции = Отбор.ВидПродукции.Значение;
				КонецЕсли;
			Иначе
				Для Каждого Запись Из ЭтотОбъект Цикл
					Если Запись.ПометкаУдаления Тогда
						СтрокаТаблицыДанных = ТаблицаДанных.Добавить();
						СтрокаТаблицыДанных.ЭлементКонструктора = Запись.ЭлементКонструктора;
						СтрокаТаблицыДанных.ВидПродукции = Запись.ВидПродукции;
					КонецЕсли;
				КонецЦикла;
				ТаблицаДанных.Свернуть(Колонки);
			КонецЕсли;
			Если ТаблицаДанных.Количество() > 0 Тогда
				ВыполнитьСинхронизациюДополнительныхСвойствНоменклатуры(ТаблицаДанных);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьПроверкуКонтроляУникальностиПоВидуПродукции(ЭлементКонструктора, ВидыПродукции, Отказ)
	
	Если ВидыПродукции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭлементКонструктора", ЭлементКонструктора);
	Запрос.УстановитьПараметр("ВидыПродукции", ВидыПродукции);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.ВидПродукции
	|ИЗ
	|	РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктораВидовПродукцииИС
	|ГДЕ
	|	ЗначенияЭлементовКонструктораВидовПродукцииИС.ЭлементКонструктора = &ЭлементКонструктора
	|	И ЗначенияЭлементовКонструктораВидовПродукцииИС.ВидПродукции В (&ВидыПродукции)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СообщитьОбОшибкеКонтроляУникальности(Выборка.ВидПродукции, Отказ);
	КонецЦикла;
	
КонецПроцедуры

Процедура СообщитьОбОшибкеКонтроляУникальности(ВидПродукции, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'Значение для вида продукции %1 должно быть уникально'"),
		ВидПродукции),,,, Отказ);
	
КонецПроцедуры

Процедура ВыполнитьСинхронизациюДополнительныхСвойствНоменклатуры(ТаблицаДанных)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.Текст = ТекстЗапросаДляСинхронизацииДополнительныхСвойствНоменклатуры();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПараметрыЗаписи = Новый Структура;
		ПараметрыЗаписи.Вставить("ЭлементКонструктора", Выборка.ЭлементКонструктора);
		ПараметрыЗаписи.Вставить("ВидПродукции", Выборка.ВидПродукции);
		ПараметрыЗаписи.Вставить("ПометкаУдаления", Истина);
		РегистрыСведений.НастройкиДополнительныхСвойствНоменклатурыИС.ЗаписатьНастройку(ПараметрыЗаписи);
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаДляСинхронизацииДополнительныхСвойствНоменклатуры()
	
	Возврат
	"ВЫБРАТЬ
	|	ТаблицаДанных.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ТаблицаДанных.ВидПродукции КАК ВидПродукции
	|ПОМЕСТИТЬ ПредварительнаяТаблицаДанных
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредварительнаяТаблицаДанных.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ПредварительнаяТаблицаДанных.ВидПродукции КАК ВидПродукции
	|ПОМЕСТИТЬ ТаблицаДанных
	|ИЗ
	|	ПредварительнаяТаблицаДанных КАК ПредварительнаяТаблицаДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиДополнительныхСвойствНоменклатурыИС КАК НастройкиДополнительныхСвойствНоменклатуры
	|		ПО ПредварительнаяТаблицаДанных.ЭлементКонструктора = НастройкиДополнительныхСвойствНоменклатуры.ЭлементКонструктора
	|			И ПредварительнаяТаблицаДанных.ВидПродукции = НастройкиДополнительныхСвойствНоменклатуры.ВидПродукции
	|			И (НЕ НастройкиДополнительныхСвойствНоменклатуры.ПометкаУдаления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияЭлементовКонструктораВидовПродукции.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ЗначенияЭлементовКонструктораВидовПродукции.ВидПродукции КАК ВидПродукции,
	|	ЗначенияЭлементовКонструктораВидовПродукции.Значение КАК Значение
	|ПОМЕСТИТЬ ЗначенияСистемные
	|ИЗ
	|	ТаблицаДанных КАК ТаблицаДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктораВидовПродукции
	|		ПО ТаблицаДанных.ЭлементКонструктора = ЗначенияЭлементовКонструктораВидовПродукции.ЭлементКонструктора
	|			И ТаблицаДанных.ВидПродукции = ЗначенияЭлементовКонструктораВидовПродукции.ВидПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияПользователяЭлементовКонструктораВидовПродукции.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ЗначенияПользователяЭлементовКонструктораВидовПродукции.ВидПродукции КАК ВидПродукции,
	|	ЗначенияПользователяЭлементовКонструктораВидовПродукции.Значение КАК Значение,
	|	ЗначенияПользователяЭлементовКонструктораВидовПродукции.ПометкаУдаления КАК ПометкаУдаления
	|ПОМЕСТИТЬ ЗначенияПользователя
	|ИЗ
	|	ТаблицаДанных КАК ТаблицаДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияПользователяЭлементовКонструктораВидовПродукции
	|		ПО ТаблицаДанных.ЭлементКонструктора = ЗначенияПользователяЭлементовКонструктораВидовПродукции.ЭлементКонструктора
	|			И ТаблицаДанных.ВидПродукции = ЗначенияПользователяЭлементовКонструктораВидовПродукции.ВидПродукции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗначенияСистемные.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ЗначенияСистемные.ВидПродукции КАК ВидПродукции
	|ПОМЕСТИТЬ ЗначенияДоступные
	|ИЗ
	|	ЗначенияСистемные КАК ЗначенияСистемные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияПользователя КАК ЗначенияПользователя
	|		ПО ЗначенияСистемные.ЭлементКонструктора = ЗначенияПользователя.ЭлементКонструктора
	|			И ЗначенияСистемные.ВидПродукции = ЗначенияПользователя.ВидПродукции
	|			И ЗначенияСистемные.Значение = ЗначенияПользователя.Значение
	|			И ЗначенияПользователя.ПометкаУдаления
	|ГДЕ
	|	ЗначенияПользователя.ЭлементКонструктора ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗначенияПользователя.ЭлементКонструктора,
	|	ЗначенияПользователя.ВидПродукции
	|ИЗ
	|	ЗначенияПользователя КАК ЗначенияПользователя
	|ГДЕ
	|	НЕ ЗначенияПользователя.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДанных.ЭлементКонструктора КАК ЭлементКонструктора,
	|	ТаблицаДанных.ВидПродукции КАК ВидПродукции
	|ИЗ
	|	ТаблицаДанных КАК ТаблицаДанных
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияДоступные КАК ЗначенияДоступные
	|		ПО ТаблицаДанных.ЭлементКонструктора = ЗначенияДоступные.ЭлементКонструктора
	|			И ТаблицаДанных.ВидПродукции = ЗначенияДоступные.ВидПродукции
	|ГДЕ
	|	ЗначенияДоступные.ЭлементКонструктора ЕСТЬ NULL";
		
КонецФункции

#КонецОбласти

#КонецЕсли