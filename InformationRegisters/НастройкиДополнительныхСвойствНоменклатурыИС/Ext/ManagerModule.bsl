#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Записывает в регистр настройку дополнительных свойств номенклатуры
//
// Параметры:
//  ПараметрыЗаписи - Структура - Данные для записи:
//   * ЭлементКонструктора - СправочникСсылка.ЭлементыКонструктораВидовПродукцииИС.
//   * ВидПродукции        - СправочникСсылка.ВидыПродукцииИС.
//   * ПометкаУдаления     - Булево.
Процедура ЗаписатьНастройку(ПараметрыЗаписи) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.НастройкиДополнительныхСвойствНоменклатурыИС");
	ЭлементБлокировки.УстановитьЗначение("ЭлементКонструктора", ПараметрыЗаписи.ЭлементКонструктора);
	ЭлементБлокировки.УстановитьЗначение("ВидПродукции",        ПараметрыЗаписи.ВидПродукции);
	
	НачатьТранзакцию();
	
	Попытка
		
		БлокировкаДанных.Заблокировать();
		
		Запись = СоздатьМенеджерЗаписи();
		Запись.ЭлементКонструктора = ПараметрыЗаписи.ЭлементКонструктора;
		Запись.ВидПродукции        = ПараметрыЗаписи.ВидПродукции;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Если Запись.Изменен
				И Запись.ПометкаУдаления = ПараметрыЗаписи.ПометкаУдаления Тогда
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли;
		ИначеЕсли ПараметрыЗаписи.ПометкаУдаления Тогда
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Запись, ПараметрыЗаписи);
		Запись.Изменен = Истина;
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Возвращает элементы конструктора, для которых заданы дополнительные свойства номенклатуры по видам продукции.
//
// Параметры:
//  ВидПродукции - СправочникСсылка.КлючиВидовПродукцииИС,
//                 СправочникСсылка.ВидыПродукцииИС,
//                 Массив из СправочникСсылка.ВидыПродукцииИС.
//  ВозвращатьДоступныеЗначения - Булево - Нужно ли возвращать значения, доступные для выбора.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - СправочникСсылка.ЭлементыКонструктораВидовПродукцииИС - элемент конструктора.
//   * Значение - Структура - настройки дополнительного свойства номенклатуры и значения, доступные для выбора.
//
Функция ЭлементыКонструктораНастроекДополнительныхСвойствНоменклатурыПоВидуПродукции(ВидПродукции, ВозвращатьДоступныеЗначения) Экспорт
	
	Результат = Новый Соответствие;
	
	ЭлементыКонструктораСДСН = ОбщегоНазначенияИСКлиентСерверПовтИсп.ЭлементыКонструктораСДополнительнымиСвойствамиНоменклатуры();
	
	ЭлементыКонструктора = Новый Массив;
	ЭлементыКонструктораИспользующиеЗначение = Новый Массив;
	
	Для Каждого ЭлементКонструктораСДСН Из ЭлементыКонструктораСДСН Цикл
		ЭлементыКонструктора.Добавить(ЭлементКонструктораСДСН.Ключ);
		Если ВозвращатьДоступныеЗначения
			И ЭлементКонструктораСДСН.Значение.ИспользоватьПараметризуемоеЗначение Тогда
			ЭлементыКонструктораИспользующиеЗначение.Добавить(ЭлементКонструктораСДСН.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	ТипВидаПродукции = ТипЗнч(ВидПродукции);
	Если ТипВидаПродукции = Тип("СправочникСсылка.КлючиВидовПродукцииИС") Тогда
		ВидыПродукцииДляЗапроса = КонструкторИСОбщегоНазначенияКлиентСервер.ВидыПродукцииКлюча(ВидПродукции);
	ИначеЕсли ТипВидаПродукции = Тип("СправочникСсылка.ВидыПродукцииИС") Тогда
		ВидыПродукцииДляЗапроса = Новый Массив;
		ВидыПродукцииДляЗапроса.Добавить(ВидПродукции);
	Иначе
		ВидыПродукцииДляЗапроса = ВидПродукции;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыПродукции", ВидыПродукцииДляЗапроса);
	Запрос.УстановитьПараметр("ЭлементыКонструктора", ЭлементыКонструктора);
	Если ВозвращатьДоступныеЗначения Тогда
		Запрос.УстановитьПараметр("ЭлементыКонструктораИспользующиеЗначение", ЭлементыКонструктораИспользующиеЗначение);
	КонецЕсли;
	Запрос.Текст = ТекстЗапросаДополнительныхСвойствНоменклатурыПоКлючуВидовПродукции(ВозвращатьДоступныеЗначения);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	ВГраница = ПакетЗапросов.ВГраница();
	
	Выборка = ПакетЗапросов[ВГраница].Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(
			Выборка.ЭлементКонструктора,
			ОбщегоНазначения.СкопироватьРекурсивно(ЭлементыКонструктораСДСН[Выборка.ЭлементКонструктора]));
	КонецЦикла;
	
	Если ВозвращатьДоступныеЗначения Тогда
		Выборка = ПакетЗапросов[ВГраница-1].Выбрать();
		Пока Выборка.Следующий() Цикл
			Настройки = Результат[Выборка.ЭлементКонструктора];
			Если Не Настройки.Свойство("Значения") Тогда
				Настройки.Вставить("Значения", Новый Массив);
			КонецЕсли;
			Настройки.Значения.Добавить(Выборка.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриЗагрузкеКлассификатора(ДанныеКлассификатора, ПараметрыЗагрузки, РезультатОбновления) Экспорт
	
	Блокировка = Новый БлокировкаДанных();
	Блокировка.Добавить(Метаданные.РегистрыСведений.НастройкиДополнительныхСвойствНоменклатурыИС.ПолноеИмя());
	
	Попытка
		Блокировка.Заблокировать();
		ОбновитьНастройкиДополнительныхСвойствНоменклатурыИСИзКлассификатора(ДанныеКлассификатора, ПараметрыЗагрузки, РезультатОбновления);
		
	Исключение
		ТекстОшибкиПодробно = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		РезультатОбновления.СообщениеОбОшибке = ТекстОшибкиПодробно;
		РезультатОбновления.УспешнаяЗагрузка  = Ложь;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьНастройкиДополнительныхСвойствНоменклатурыИСИзКлассификатора(ДанныеКлассификатора, ПараметрыЗагрузки, РезультатОбновления)
	
	Идентификаторы                = ПараметрыЗагрузки.Идентификаторы;
	ДанныеКЗагрузке               = ДанныеКлассификатора.НастройкиСвойствНоменклатуры;
	ЗагрузкаИзменений             = ПараметрыЗагрузки.ЗагрузкаИзменений;
	СбросИзменений                = ПараметрыЗагрузки.СбросИзменений;
	ИмяТаблицыВидовПродукции      = Метаданные.Справочники.ВидыПродукцииИС.ПолноеИмя();
	ПолноеИмяСправочникаЭлементов = Метаданные.Справочники.ЭлементыКонструктораВидовПродукцииИС.ПолноеИмя();

	ТаблицаКЗагрузке = Новый ТаблицаЗначений;
	ТаблицаКЗагрузке.Колонки.Добавить("ВидПродукции",       Новый ОписаниеТипов("СправочникСсылка.ВидыПродукцииИС"));
	ТаблицаКЗагрузке.Колонки.Добавить("Изменен",            Новый ОписаниеТипов("Булево"));
	ТаблицаКЗагрузке.Колонки.Добавить("ПометкаУдаления",    Новый ОписаниеТипов("Булево"));
	ТаблицаКЗагрузке.Колонки.Добавить("ЭлементКонструктора",Новый ОписаниеТипов(
		"СправочникСсылка.ЭлементыКонструктораВидовПродукцииИС"));

	Для Каждого СтрокаКЗагрузке Из ДанныеКЗагрузке Цикл
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ИмяТаблицы",   ПолноеИмяСправочникаЭлементов);
		СтруктураПоиска.Вставить("Наименование", СтрокаКЗагрузке.ЭлементКонструктора);

		НайденныеСтроки = Идентификаторы.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() Тогда
			ЭлементКонструктораСсылка = НайденныеСтроки[0].Ссылка;
		Иначе
			Если ПараметрыЗагрузки.РежимОтладки Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Внутренняя ошибка поиска элемента конструктора %1'"),
					СтрокаКЗагрузке.ЭлементКонструктора);
			Иначе
				РезультатОбновления.ДанныеЗагруженыЧастично = Истина;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("ИмяТаблицы",    ИмяТаблицыВидовПродукции);
		СтруктураПоиска.Вставить("Идентификатор", СтрокаКЗагрузке.ВидПродукцииИдентификатор);
		СтруктураПоиска.Вставить("Наименование",  СтрокаКЗагрузке.ВидПродукцииНаименование);

		НайденныеСтроки = Идентификаторы.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() Тогда
			ВидПродукцииСсылка = НайденныеСтроки[0].Ссылка;
		Иначе
			РезультатОбновления.ДанныеЗагруженыЧастично = Истина;
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ВидПродукцииСсылка) Тогда
			РезультатОбновления.ДанныеЗагруженыЧастично = Истина;
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаКЗагрузке.Добавить();

		НоваяСтрока.ЭлементКонструктора = ЭлементКонструктораСсылка;
		НоваяСтрока.ВидПродукции        = ВидПродукцииСсылка;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКЗагрузке, , "ЭлементКонструктора");

	КонецЦикла;

	Если ЗагрузкаИзменений Тогда
		Для Каждого СтрокаИзменений Из ТаблицаКЗагрузке Цикл
			НоваяЗапись = СоздатьМенеджерЗаписи();
			НоваяЗапись.ЭлементКонструктора = СтрокаИзменений.ЭлементКонструктора;
			НоваяЗапись.ВидПродукции        = СтрокаИзменений.ВидПродукции;

			НоваяЗапись.Прочитать();

			ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаИзменений);

			НоваяЗапись.Записать();

		КонецЦикла;

	ИначеЕсли СбросИзменений Тогда
		НаборЗаписей = СоздатьНаборЗаписей();

		Для Каждого СтрокаИзменений Из ТаблицаКЗагрузке Цикл
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаИзменений);
		КонецЦикла;

		НаборЗаписей.Записать();

	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
					|	ТаблицаКЗагрузке.ЭлементКонструктора КАК ЭлементКонструктора,
					|	ТаблицаКЗагрузке.ВидПродукции КАК ВидПродукции,
					|	ТаблицаКЗагрузке.Изменен КАК Изменен,
					|	ТаблицаКЗагрузке.ПометкаУдаления КАК ПометкаУдаления
					|ПОМЕСТИТЬ втЗагружаемыеДанные
					|ИЗ
					|	&ТаблицаКЗагрузке КАК ТаблицаКЗагрузке
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ЕСТЬNULL(НастройкиДополнительныхСвойствНоменклатурыИС.ЭлементКонструктора,
					|		НЕОПРЕДЕЛЕНО) КАК ЭлементКонструктора,
					|	НастройкиДополнительныхСвойствНоменклатурыИС.ВидПродукции КАК ВидПродукции,
					|	НастройкиДополнительныхСвойствНоменклатурыИС.Изменен КАК Изменен,
					|	НастройкиДополнительныхСвойствНоменклатурыИС.ПометкаУдаления КАК ПометкаУдаления,
					|	ЕСТЬNULL(втЗагружаемыеДанные.ЭлементКонструктора, НЕОПРЕДЕЛЕНО) КАК ЭлементКонструктораПоставляемый,
					|	втЗагружаемыеДанные.ВидПродукции КАК ВидПродукцииПоставляемый,
					|	втЗагружаемыеДанные.Изменен КАК ИзмененПоставляемый,
					|	втЗагружаемыеДанные.ПометкаУдаления КАК ПометкаУдаленияПоставляемый
					|ИЗ
					|	РегистрСведений.НастройкиДополнительныхСвойствНоменклатурыИС КАК
					|		НастройкиДополнительныхСвойствНоменклатурыИС
					|		ПОЛНОЕ СОЕДИНЕНИЕ втЗагружаемыеДанные КАК втЗагружаемыеДанные
					|		ПО НастройкиДополнительныхСвойствНоменклатурыИС.ЭлементКонструктора = втЗагружаемыеДанные.ЭлементКонструктора
					|			И НастройкиДополнительныхСвойствНоменклатурыИС.ВидПродукции = втЗагружаемыеДанные.ВидПродукции";
		Запрос.УстановитьПараметр("ТаблицаКЗагрузке", ТаблицаКЗагрузке);

		РезультатЗапроса = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

		НаборЗаписей = СоздатьНаборЗаписей();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ЭлементКонструктора = Неопределено Тогда
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.ЭлементКонструктора = ВыборкаДетальныеЗаписи.ЭлементКонструктораПоставляемый;
				НоваяЗапись.ВидПродукции        = ВыборкаДетальныеЗаписи.ВидПродукцииПоставляемый;
				НоваяЗапись.Изменен             = ВыборкаДетальныеЗаписи.ИзмененПоставляемый;
				НоваяЗапись.ПометкаУдаления     = ВыборкаДетальныеЗаписи.ПометкаУдаленияПоставляемый;
			Иначе
				Если ВыборкаДетальныеЗаписи.ЭлементКонструктораПоставляемый = Неопределено Тогда
					Если ВыборкаДетальныеЗаписи.Изменен И Не ВыборкаДетальныеЗаписи.ПометкаУдаления Тогда
						НоваяЗапись = НаборЗаписей.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
					ИначеЕсли ВыборкаДетальныеЗаписи.Изменен И ВыборкаДетальныеЗаписи.ПометкаУдаления Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					НоваяЗапись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
					Если ВыборкаДетальныеЗаписи.Изменен И Не ВыборкаДетальныеЗаписи.ПометкаУдаления Тогда
						НоваяЗапись.Изменен = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		НаборЗаписей.Записать();

	КонецЕсли;

КонецПроцедуры

Функция ТекстЗапросаДополнительныхСвойствНоменклатурыПоКлючуВидовПродукции(ВозвращатьДоступныеЗначения)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	НастройкиДополнительныхСвойствНоменклатуры.ЭлементКонструктора КАК ЭлементКонструктора,
	|	НастройкиДополнительныхСвойствНоменклатуры.ВидПродукции КАК ВидПродукции
	|ПОМЕСТИТЬ ДоступныеНастройки
	|ИЗ
	|	РегистрСведений.НастройкиДополнительныхСвойствНоменклатурыИС КАК НастройкиДополнительныхСвойствНоменклатуры
	|ГДЕ
	|	НастройкиДополнительныхСвойствНоменклатуры.ЭлементКонструктора В (&ЭлементыКонструктора)
	|	И НастройкиДополнительныхСвойствНоменклатуры.ВидПродукции В (&ВидыПродукции)
	|	И НЕ НастройкиДополнительныхСвойствНоменклатуры.ПометкаУдаления";
	
	Если ВозвращатьДоступныеЗначения Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|;
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗначенияЭлементовКонструктора.ЭлементКонструктора КАК ЭлементКонструктора,
		|	ЗначенияЭлементовКонструктора.Значение КАК Значение
		|ИЗ
		|	ДоступныеНастройки КАК ДоступныеНастройки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияЭлементовКонструктораВидовПродукцииИС КАК ЗначенияЭлементовКонструктора
		|		ПО ДоступныеНастройки.ЭлементКонструктора = ЗначенияЭлементовКонструктора.ЭлементКонструктора
		|		И ДоступныеНастройки.ВидПродукции = ЗначенияЭлементовКонструктора.ВидПродукции
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияПользователяЭлементовКонструктора
		|		ПО ЗначенияЭлементовКонструктора.ЭлементКонструктора = ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора
		|		И ЗначенияЭлементовКонструктора.ВидПродукции = ЗначенияПользователяЭлементовКонструктора.ВидПродукции
		|		И ЗначенияЭлементовКонструктора.Значение = ЗначенияПользователяЭлементовКонструктора.Значение
		|ГДЕ
		|	ЗначенияЭлементовКонструктора.ЭлементКонструктора В (&ЭлементыКонструктораИспользующиеЗначение)
		|	И ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора КАК ЭлементКонструктора,
		|	ЗначенияПользователяЭлементовКонструктора.Значение КАК Значение
		|ИЗ
		|	ДоступныеНастройки КАК ДоступныеНастройки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПользователяЭлементовКонструктораВидовПродукцииИС КАК ЗначенияПользователяЭлементовКонструктора
		|		ПО ДоступныеНастройки.ЭлементКонструктора = ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора
		|		И ДоступныеНастройки.ВидПродукции = ЗначенияПользователяЭлементовКонструктора.ВидПродукции
		|ГДЕ
		|	ЗначенияПользователяЭлементовКонструктора.ЭлементКонструктора В (&ЭлементыКонструктораИспользующиеЗначение)
		|	И НЕ ЗначенияПользователяЭлементовКонструктора.ПометкаУдаления";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоступныеНастройки.ЭлементКонструктора КАК ЭлементКонструктора
	|ИЗ
	|	ДоступныеНастройки КАК ДоступныеНастройки";
	
	Возврат ТекстЗапроса;
	
КонецФункции

