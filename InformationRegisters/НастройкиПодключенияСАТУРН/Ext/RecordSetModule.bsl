#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Это удаление записи
	Если Замещение И Количество() = 0 И Модифицированность() Тогда
		
		ИдентификаторХранилища = ИдентификаторХранилища(Отбор.Организация.Значение, Отбор.Пользователь.Значение);
		Если ЗначениеЗаполнено(ИдентификаторХранилища) Тогда
			ДополнительныеСвойства.Вставить("ИдентификаторХранилищаДляУдаления", ИдентификаторХранилища);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторХранилищаДляУдаления = Неопределено;
	
	Если ДополнительныеСвойства.Свойство("ИдентификаторХранилищаДляУдаления", ИдентификаторХранилищаДляУдаления) Тогда
		ИнтеграцияСАТУРН.УдалитьДанныеКлючейАвторизации(ИдентификаторХранилищаДляУдаления);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИдентификаторХранилища(Организация, Пользователь)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиПодключенияСАТУРН.ИдентификаторХранилища КАК ИдентификаторХранилища
		|ИЗ
		|	РегистрСведений.НастройкиПодключенияСАТУРН КАК НастройкиПодключенияСАТУРН
		|ГДЕ
		|	НастройкиПодключенияСАТУРН.Пользователь = &Пользователь
		|	И НастройкиПодключенияСАТУРН.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ИдентификаторХранилища;
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#КонецЕсли
