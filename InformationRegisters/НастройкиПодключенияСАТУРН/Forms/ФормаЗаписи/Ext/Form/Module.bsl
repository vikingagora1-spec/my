#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.ИсходныйКлючЗаписи) Тогда
		ЕстьПравоРедактирования       = ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.НастройкиПодключенияСАТУРН);
		Запись.ИдентификаторХранилища = ИнтеграцияСАТУРН.НовыйИдентификаторВладельцаХранилища();
		ЗаполнитьДанныеКлючаАвторизации();
		ЗаполнитьДанныеКлючаОбновления();
	КонецЕсли;
	
	УправлениеЭлементамиФормы();
	ОбщегоНазначенияСобытияФормИСПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	КлючАвторизации = Неопределено;
	КлючОбновления  = Неопределено;
	ЕстьПравоРедактирования = ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.НастройкиПодключенияСАТУРН);
	ДанныеКлючейАвторизации = ИнтеграцияСАТУРН.ДанныеКлючейАвторизации(Запись.ИдентификаторХранилища);
	Если ДанныеКлючейАвторизации <> Неопределено Тогда
		КлючАвторизации = ДанныеКлючейАвторизации.КлючАвторизации;
		КлючОбновления  = ДанныеКлючейАвторизации.КлючОбновления;
	КонецЕсли;
	
	ЗаполнитьДанныеКлючаАвторизации(КлючАвторизации);
	ЗаполнитьДанныеКлючаОбновления(КлючОбновления);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ОшибкаКлючаАвторизации
		Или Не ЗначениеЗаполнено(СрокДействияКлючаАвторизации) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Ошибка заполнения ключа авторизации'"),,,
			"КлючАвторизацииПредставление", Отказ);
		
	Иначе
		
		ПроверятьСоответствиеИНН = (Не ПолучитьФункциональнуюОпцию("РежимРаботыСТестовымКонтуромСАТУРН")
			И ЗначениеЗаполнено(Запись.Организация));
		
		Если ПроверятьСоответствиеИНН Тогда
		
			ТаблицаОрганизаций = ИнтеграцияСАТУРН.НоваяТаблицаОрганизацияКонтрагент();
			НоваяСтрока                       = ТаблицаОрганизаций.Добавить();
			НоваяСтрока.ОрганизацияКонтрагент = Запись.Организация;
			ИнтеграцияСАТУРНВызовСервера.РеквизитыОрганизацийКонтрагентов(ТаблицаОрганизаций);
			
			Если ИННКлючаАвторизации <> НоваяСтрока.ИНН Тогда
				ОбщегоНазначения.СообщитьПользователю(
					НСтр("ru = 'ИНН в токене авторизации не соответствует ИНН организации'"),,
					"КлючАвторизацииПредставление",,
					Отказ);
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОшибкаКлючаОбновления Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Ошибка заполнения ключа обновления'"),,,
			"КлючОбновленияПредставление", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ВведенныйКлючАвторизации <> Неопределено
		Или ВведенныйКлючОбновления <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ВведенныйКлючОбновления) Тогда
			ПроверитьДублированиеКлючейОбновления(Отказ);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		ДанныеКлючейАвторизации = ИнтеграцияСАТУРН.ДанныеКлючейАвторизации(ТекущийОбъект.ИдентификаторХранилища);
	
		Если ВведенныйКлючАвторизации <> Неопределено Тогда
			ДанныеКлючейАвторизации.КлючАвторизации = ВведенныйКлючАвторизации;
		КонецЕсли;
		
		Если ВведенныйКлючОбновления <> Неопределено Тогда
			ДанныеКлючейАвторизации.КлючОбновления = ВведенныйКлючОбновления;
		КонецЕсли;
		
		ИнтеграцияСАТУРН.ЗаписатьДанныеКлючаАвторизации(
			ТекущийОбъект.ИдентификаторХранилища,
			ДанныеКлючейАвторизации.КлючАвторизации,
			ДанныеКлючейАвторизации.КлючОбновления);
		
	КонецЕсли;
	
	ВведенныйКлючОбновления  = Неопределено;
	ВведенныйКлючАвторизации = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КлючАвторизацииПредставлениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ВвестиКлючАвторизации" Тогда
		СтандартнаяОбработка = Ложь;
		ВвестиКлючДоступа();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлючОбновленияПредставлениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ВвестиКлючОбновления" Тогда
		СтандартнаяОбработка = Ложь;
		ВвестиКлючДоступа(Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьКлючАвторизации(Команда)
	
	ОчиститьСообщения();
	
	Если Модифицированность Тогда
		
		ОписаниеОповещенияВопрос = Новый ОписаниеОповещения("ВопросЗаписатьНастройкуПодключенияЗавершение",
		                                                    ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Перед обновлением ключа авторизации необходимо записать настройку подключения. Записать?'");
		ПоказатьВопрос(ОписаниеОповещенияВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьОбновлениеКлючаАвторизации();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВФормуАвторизации(Команда)
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://api.fgis-saturn.ru/login");
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВФормуАвторизацииТестовыйКонтур(Команда)
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://demo-hs.fgis-saturn.ru/login");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВвестиКлючДоступа(ЭтоКлючОбновления = Ложь)
	
	Если ЭтоКлючОбновления Тогда
		ПодсказкаВвода = НСтр("ru = 'Введите ключ обновления'");
	Иначе
		ПодсказкаВвода = НСтр("ru = 'Введите ключ авторизации'");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЭтоКлючОбновления", ЭтоКлючОбновления);
	
	ВводКлючаДоступаЗавершение = Новый ОписаниеОповещения(
		"ВводКлючаДоступаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВводСтроки(ВводКлючаДоступаЗавершение,, ПодсказкаВвода);
	
КонецПроцедуры

&НаКлиенте
Процедура ВводКлючаДоступаЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ЭтоКлючОбновления Тогда
		ВведенныйКлючОбновления = Значение;
		ЗаполнитьДанныеКлючаОбновления(Значение);
	Иначе
		ВведенныйКлючАвторизации = Значение;
		ЗаполнитьДанныеКлючаАвторизации(Значение, Истина);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаписатьНастройкуПодключенияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		Если Записать() Тогда
			ОбновитьКлючАвторизацииНаСервере();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновлениеКлючаАвторизации()
	
	ОбновитьКлючАвторизацииНаСервере();
	Прочитать();
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ОбновитьКлючАвторизации.Доступность = ЗначениеЗаполнено(СрокДействияКлючаОбновления)
		И ЕстьПравоРедактирования;
	
	Элементы.ПерейтиВФормуАвторизации.Видимость = Не ПолучитьФункциональнуюОпцию("РежимРаботыСТестовымКонтуромСАТУРН");
	Элементы.ПерейтиВФормуАвторизацииТестовыйКонтур.Видимость = ПолучитьФункциональнуюОпцию("РежимРаботыСТестовымКонтуромСАТУРН");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеКлючаАвторизации(КлючАвторизации = Неопределено, ЭтоИзменениеТокена = Ложь)
	
	СрокДействияКлючаАвторизации = Неопределено;
	ОшибкаКлючаАвторизации       = Ложь;
	ДанныеПредставления          = Новый Массив;
	ЛогинКлючаАвторизации        = Неопределено;
	ИННКлючаАвторизации          = Неопределено;
	
	Если ЗначениеЗаполнено(КлючАвторизации) Тогда
		
		РезультатДекодирования = ИнтеграцияСАТУРНСлужебный.ДекодироватьТокенJWT(КлючАвторизации);
		ОшибкаКлючаАвторизации = РезультатДекодирования.ОшибкаДекодирования;
		
		Если ОшибкаКлючаАвторизации Тогда
			
			Если ЕстьПравоРедактирования Тогда
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						НСтр("ru = 'Ошибка декодирования токена JWT'"),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС,,
						"ВвестиКлючАвторизации"));
				
			Иначе
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						НСтр("ru = 'Ошибка декодирования токена JWT'"),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС));
				
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(РезультатДекодирования.Тип)
			И НРег(РезультатДекодирования.Тип) <> НРег("Bearer") Тогда
			
			ОшибкаКлючаАвторизации = Истина;
			
			Если ЕстьПравоРедактирования Тогда
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						СтрШаблон(
							НСтр("ru = 'Токен %1 не является ключем авторизации Bearer'"),
						РезультатДекодирования.Тип),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС,,
						"ВвестиКлючАвторизации"));
			Иначе
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						СтрШаблон(
							НСтр("ru = 'Токен %1 не является ключем авторизации Bearer'"),
						РезультатДекодирования.Тип),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС));
				
			КонецЕсли;
			
		Иначе
			
			СрокДействияКлючаАвторизации = РезультатДекодирования.ДействуетДо;
			ЛогинКлючаАвторизации        = РезультатДекодирования.Логин;
			ИННКлючаАвторизации          = РезультатДекодирования.ИНН;
			
			ДанныеПредставленияСрока = ОбщегоНазначенияИСКлиентСервер.ДанныеПредставленияСрокаГодности(
				СрокДействияКлючаАвторизации, ТекущаяДатаСеанса(), Истина);
			
			Если ДанныеПредставленияСрока.Истек Тогда
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						ДанныеПредставленияСрока.Представление,,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС));
			
			Иначе
				
				ДанныеПредставления.Добавить(НСтр("ru = 'действует до'"));
				ДанныеПредставления.Добавить(" ");
				ДанныеПредставления.Добавить(Строка(СрокДействияКлючаАвторизации));
				ДанныеПредставления.Добавить(" (");
				ДанныеПредставления.Добавить(ДанныеПредставленияСрока.Представление);
				ДанныеПредставления.Добавить(")");
				
			КонецЕсли;
			
			Если ЕстьПравоРедактирования Тогда
				
				ДанныеПредставления.Добавить(" ");
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						НСтр("ru = 'ввести ключ'"),,,,
						"ВвестиКлючАвторизации"));
						
			КонецЕсли;
			
		КонецЕсли;
	
	ИначеЕсли ЕстьПравоРедактирования Тогда
		
		ДанныеПредставления.Добавить(
			Новый ФорматированнаяСтрока(
				НСтр("ru = 'отсутствует'"),,
				ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС,,
				"ВвестиКлючАвторизации"));
	
	Иначе
		
		ДанныеПредставления.Добавить(
			Новый ФорматированнаяСтрока(
				НСтр("ru = 'отсутствует'"),,
				ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС));
		
	КонецЕсли;
	
	Если ЭтоИзменениеТокена Тогда
		Запись.Логин = ЛогинКлючаАвторизации;
	КонецЕсли;
	
	КлючАвторизацииПредставление = Новый ФорматированнаяСтрока(ДанныеПредставления);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеКлючаОбновления(КлючОбновления = Неопределено)
	
	СрокДействияКлючаОбновления = Неопределено;
	ОшибкаКлючаОбновления       = Ложь;
	ДанныеПредставления         = Новый Массив;
	
	Если ЗначениеЗаполнено(КлючОбновления) Тогда
		
		РезультатДекодирования = ИнтеграцияСАТУРНСлужебный.ДекодироватьТокенJWT(КлючОбновления);
		ОшибкаКлючаОбновления  = РезультатДекодирования.ОшибкаДекодирования;
		
		Если ОшибкаКлючаОбновления Тогда
			
			Если ЕстьПравоРедактирования Тогда
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						НСтр("ru = 'Ошибка декодирования токена JWT'"),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС,,
						"ВвестиКлючОбновления"));
			
			Иначе
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						НСтр("ru = 'Ошибка декодирования токена JWT'"),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС));
				
			КонецЕсли;
			
			
		ИначеЕсли ЗначениеЗаполнено(РезультатДекодирования.Тип)
				И НРег(РезультатДекодирования.Тип) <> НРег("Refresh") Тогда
			
			ОшибкаКлючаОбновления = Истина;
			
			Если ЕстьПравоРедактирования Тогда
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						СтрШаблон(
							НСтр("ru = 'Токен %1 не является ключем обновления Refresh'"),
						РезультатДекодирования.Тип),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС,,
						"ВвестиКлючОбновления"));
				
			Иначе
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						СтрШаблон(
							НСтр("ru = 'Токен %1 не является ключем обновления Refresh'"),
						РезультатДекодирования.Тип),,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС));
				
			КонецЕсли;
			
		Иначе
			
			СрокДействияКлючаОбновления = РезультатДекодирования.ДействуетДо;
			ДанныеПредставленияСрока = ОбщегоНазначенияИСКлиентСервер.ДанныеПредставленияСрокаГодности(
				СрокДействияКлючаОбновления, ТекущаяДатаСеанса(), Истина);
			
			Если ДанныеПредставленияСрока.Истек Тогда
				
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						ДанныеПредставленияСрока.Представление,,
						ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС));
			
			Иначе
				
				ДанныеПредставления.Добавить(НСтр("ru = 'действует до'"));
				ДанныеПредставления.Добавить(" ");
				ДанныеПредставления.Добавить(Строка(СрокДействияКлючаОбновления));
				ДанныеПредставления.Добавить(" (");
				ДанныеПредставления.Добавить(ДанныеПредставленияСрока.Представление);
				ДанныеПредставления.Добавить(")");
				
			КонецЕсли;
			
			Если ЕстьПравоРедактирования Тогда
				
				ДанныеПредставления.Добавить(" ");
				ДанныеПредставления.Добавить(
					Новый ФорматированнаяСтрока(
						НСтр("ru = 'ввести ключ'"),,,,
						"ВвестиКлючОбновления"));
			
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ЕстьПравоРедактирования Тогда
		
		ДанныеПредставления.Добавить(
			Новый ФорматированнаяСтрока(
				НСтр("ru = 'отсутствует'"),,,,
				"ВвестиКлючОбновления"));
				
	Иначе
		
		ДанныеПредставления.Добавить(
			Новый ФорматированнаяСтрока(
				НСтр("ru = 'отсутствует'")));
		
	КонецЕсли;
	
	КлючОбновленияПредставление = Новый ФорматированнаяСтрока(ДанныеПредставления);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКлючАвторизацииНаСервере()
	
	ТекущиеДанные = ИнтеграцияСАТУРН.РезультатПодбораКлючаАвторизации();
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, Запись);
	ДанныеКлючейАвторизации = ИнтеграцияСАТУРН.ДанныеКлючейАвторизации(ТекущиеДанные.ИдентификаторХранилища);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеКлючейАвторизации);
	ПараметрыОптимизации = ИнтеграцияСАТУРНСлужебный.ПараметрыОптимизации();
	РезультатОбновления  = ИнтеграцияСАТУРН.ОбновитьКлючСессии(ТекущиеДанные, ПараметрыОптимизации);
	
	Если Не РезультатОбновления.Успешно Тогда
		ОбщегоНазначения.СообщитьПользователю(РезультатОбновления.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДублированиеКлючейОбновления(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкиПодключенияСАТУРН.Пользователь           КАК Пользователь,
		|	НастройкиПодключенияСАТУРН.Организация            КАК Организация,
		|	НастройкиПодключенияСАТУРН.ИдентификаторХранилища КАК ИдентификаторХранилища
		|ИЗ
		|	РегистрСведений.НастройкиПодключенияСАТУРН КАК НастройкиПодключенияСАТУРН
		|ГДЕ
		|	НастройкиПодключенияСАТУРН.ИдентификаторХранилища <> &ИдентификаторХранилища";
	
	Запрос.УстановитьПараметр("ИдентификаторХранилища", Запись.ИдентификаторХранилища);
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Идентификаторы = ТаблицаДанных.ВыгрузитьКолонку("ИдентификаторХранилища");
	
	ДанныеКлючейПоВладельцам = ИнтеграцияСАТУРН.ДанныеКлючейАвторизацииПоВладельцам(Идентификаторы);
	
	НайденныеДубли = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		ДанныеКлюча = ДанныеКлючейПоВладельцам.Получить(СтрокаТаблицы.ИдентификаторХранилища);
		Если ДанныеКлюча = Неопределено
			Или Не ЗначениеЗаполнено(ДанныеКлюча.КлючОбновления) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДанныеКлюча.КлючОбновления <> ВведенныйКлючОбновления Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеДубли.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	Если НайденныеДубли.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСообщения = Новый Массив;
	ДанныеСообщения.Добавить(НСтр("ru = 'Этот ключ обновления задан для:'"));
	
	ОписанияСтрок = Новый Массив();
	
	Для Каждого СтрокаДанных Из НайденныеДубли Цикл
		
		ОписаниеСтроки = Новый Массив();
		ОписаниеСтроки.Добавить(СтрокаДанных.Организация);
		Если ЗначениеЗаполнено(СтрокаДанных.Пользователь) Тогда
			ОписаниеСтроки.Добавить(СтрокаДанных.Пользователь);
		Иначе
			ОписаниеСтроки.Добавить(НСтр("ru = '<для всех пользователей>'"));
		КонецЕсли;
		
		ОписанияСтрок.Добавить(СтрСоединить(ОписаниеСтроки, ", "));
		
	КонецЦикла;
	
	ДанныеСообщения.Добавить(СтрСоединить(ОписанияСтрок, "; "));
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрСоединить(ДанныеСообщения, " "),,,
		"КлючОбновленияПредставление",
		Отказ);
	
КонецПроцедуры

#КонецОбласти