// Возвращает данные номеров партий по ключам записей регистра.
// 
// Параметры:
//  КлючиЗаписей - Массив из РегистрСведенийКлючЗаписи.НомераПартийГИСМТ - ключи записей регистра.
// 
// Возвращаемое значение:
//  Массив из Структура:
//   * Организация         - ОпределяемыйТип.Организация                  - организация.
//   * Номенклатура        - ОпределяемыйТип.Номенклатура                 - номенклатура.
//   * Характеристика      - ОпределяемыйТип.ХарактеристикаНоменклатуры   - характеристика.
//   * Серия               - ОпределяемыйТип.СерияНоменклатуры            - серия.
//   * НомерПартии         - ОпределяемыйТип.УникальныйИдентификаторИС    - номер партии.
//   * GTIN                - ОпределяемыйТип.GTIN                         - GTIN.
//   * ДатаПроизводства    - Дата                                         - дата производства.
//   * СтатусУказанияСерий - Число                                        - статус указания серий.
//   * ТоварнаяГруппа      - Неопределено, СправочникСсылка.ТоварныеГруппыГИСМТ - товарная группа.
Функция ДанныеНомеровПартийПоКлючамЗаписей(КлючиЗаписей) Экспорт
	
	ДанныеПартий = Новый Массив;
	
	ИсточникДанных = СоздатьНаборЗаписей().Выгрузить();
	Для Каждого КлючЗаписи Из КлючиЗаписей Цикл
		НоваяСтрока = ИсточникДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КлючЗаписи);
	КонецЦикла;
	
	Если ИсточникДанных.Количество() = 0 Тогда
		Возврат ДанныеПартий;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ИсточникДанных.Организация    КАК Организация,
	|	ИсточникДанных.Номенклатура   КАК Номенклатура,
	|	ИсточникДанных.Характеристика КАК Характеристика,
	|	ИсточникДанных.Серия          КАК Серия,
	|	ИсточникДанных.НомерПартии    КАК НомерПартии
	|ПОМЕСТИТЬ ИсточникДанных
	|ИЗ
	|	&ИсточникДанных КАК ИсточникДанных
	|
	|;
	|/////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	НомераПартийГИСМТ.Организация         КАК Организация,
	|	НомераПартийГИСМТ.Номенклатура        КАК Номенклатура,
	|	НомераПартийГИСМТ.Характеристика      КАК Характеристика,
	|	НомераПартийГИСМТ.Серия               КАК Серия,
	|	НомераПартийГИСМТ.НомерПартии         КАК НомерПартии,
	|	НомераПартийГИСМТ.GTIN                КАК GTIN,
	|	НомераПартийГИСМТ.ДатаПроизводства    КАК ДатаПроизводства,
	|	НомераПартийГИСМТ.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	ЕСТЬNULL(ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииГИСМТ, НЕОПРЕДЕЛЕНО) КАК ВидПродукцииГИСМТ
	|ИЗ
	|	РегистрСведений.НомераПартийГИСМТ КАК НомераПартийГИСМТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсточникДанных КАК ИсточникДанных
	|		ПО НомераПартийГИСМТ.Организация   = ИсточникДанных.Организация
	|		И НомераПартийГИСМТ.Номенклатура   = ИсточникДанных.Номенклатура
	|		И НомераПартийГИСМТ.Характеристика = ИсточникДанных.Характеристика
	|		И НомераПартийГИСМТ.Серия          = ИсточникДанных.Серия
	|		И НомераПартийГИСМТ.НомерПартии    = ИсточникДанных.НомерПартии
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО НомераПартийГИСМТ.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	ОписаниеНоменклатурыИС.КлючВидовПродукции.ВидПродукцииГИСМТ <> ЗНАЧЕНИЕ(Справочник.ВидыПродукцииИС.ПустаяСсылка)");
	
	Запрос.УстановитьПараметр("ИсточникДанных", ИсточникДанных);
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		ДанныеПартии = Новый Структура;
		ДанныеПартии.Вставить("Организация",         СтрокаТаблицы.Организация);
		ДанныеПартии.Вставить("Номенклатура",        СтрокаТаблицы.Номенклатура);
		ДанныеПартии.Вставить("Характеристика",      СтрокаТаблицы.Характеристика);
		ДанныеПартии.Вставить("Серия",               СтрокаТаблицы.Серия);
		ДанныеПартии.Вставить("НомерПартии",         СтрокаТаблицы.НомерПартии);
		ДанныеПартии.Вставить("GTIN",                СтрокаТаблицы.GTIN);
		ДанныеПартии.Вставить("ДатаПроизводства",    СтрокаТаблицы.ДатаПроизводства);
		ДанныеПартии.Вставить("ВидПродукцииГИСМТ",   СтрокаТаблицы.ВидПродукцииГИСМТ);
		ДанныеПартии.Вставить("СтатусУказанияСерий", СтрокаТаблицы.СтатусУказанияСерий);
		
		ДанныеПартий.Добавить(ДанныеПартии);
		
	КонецЦикла;
	
	Возврат ДанныеПартий;
	
КонецФункции

// Записать номера партий при проверке поступления.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - организация
//  ТаблицаПодобраннойПродукции - см. ПроверкаИПодборПродукцииИС.ПустаяТаблицаПодобраннойПровереннойПродукции
Процедура ЗаписатьНомераПартийПриПроверкеПоступления(Организация, ТаблицаПодобраннойПродукции) Экспорт
	
	ТаблицаПоСериям = ТаблицаПодобраннойПродукции.СкопироватьКолонки();
	
	Для Каждого СтрокаТаблицы Из ТаблицаПодобраннойПродукции Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Серия)
			Или Не ЗначениеЗаполнено(СтрокаТаблицы.НомерПартии) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПоСериям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
	КонецЦикла;
	
	Если ТаблицаПоСериям.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПоСериям.Свернуть("Номенклатура,Характеристика,Серия,НомерПартии,GTIN,ДатаПроизводства");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПоСериям", ТаблицаПоСериям);
	Запрос.УстановитьПараметр("Организация",     Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаПоСериям.Номенклатура     КАК Номенклатура,
	|	ТаблицаПоСериям.Характеристика   КАК Характеристика,
	|	ТаблицаПоСериям.Серия            КАК Серия,
	|	ТаблицаПоСериям.НомерПартии      КАК НомерПартии,
	|	ТаблицаПоСериям.GTIN             КАК GTIN,
	|	ТаблицаПоСериям.ДатаПроизводства КАК ДатаПроизводства
	|ПОМЕСТИТЬ ТаблицаПоСериям
	|ИЗ
	|	&ТаблицаПоСериям КАК ТаблицаПоСериям
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Организация                     КАК Организация,
	|	ТаблицаПоСериям.Номенклатура     КАК Номенклатура,
	|	ТаблицаПоСериям.Характеристика   КАК Характеристика,
	|	ТаблицаПоСериям.Серия            КАК Серия,
	|	ТаблицаПоСериям.НомерПартии      КАК НомерПартии,
	|	ТаблицаПоСериям.GTIN             КАК GTIN,
	|	ТаблицаПоСериям.ДатаПроизводства КАК ДатаПроизводства
	|ИЗ
	|	ТаблицаПоСериям КАК ТаблицаПоСериям
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераПартийГИСМТ КАК НомераПартийГИСМТ
	|		ПО НомераПартийГИСМТ.Организация   = &Организация
	|		И НомераПартийГИСМТ.Номенклатура   = ТаблицаПоСериям.Номенклатура
	|		И НомераПартийГИСМТ.Характеристика = ТаблицаПоСериям.Характеристика
	|		И НомераПартийГИСМТ.Серия          = ТаблицаПоСериям.Серия
	|		И НомераПартийГИСМТ.НомерПартии    = ТаблицаПоСериям.НомерПартии
	|ГДЕ
	|	НомераПартийГИСМТ.НомерПартии ЕСТЬ NULL";
	
	НачатьТранзакцию();
	
	Попытка
		
		ПоляБлокировки = Новый Структура;
		ПоляБлокировки.Вставить("Организация", Организация);
		
		ОбщегоНазначенияИС.УстановитьУправляемуюБлокировку(
			Метаданные.РегистрыСведений.НомераПартийГИСМТ.ПолноеИмя(), ПоляБлокировки);
		
		УстановитьПривилегированныйРежим(Истина);
		НомераПартий = Запрос.Выполнить().Выгрузить();
		
		Если НомераПартий.Количество() Тогда
			
			НомераПартий.Колонки.Добавить("Статус", Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыНомеровПартийГИСМТ"));
			НомераПартий.ЗаполнитьЗначения(Перечисления.СтатусыНомеровПартийГИСМТ.Зарегистрирован, "Статус");
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Загрузить(НомераПартий);
			НаборЗаписей.Записать(РежимЗамещения.Добавление);
			
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

// Возвращает массив дальнейших действий с документом, требующих участия пользователя
// 
