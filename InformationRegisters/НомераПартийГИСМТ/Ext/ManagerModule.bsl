#Область СлужебныеПроцедурыИФункции

// Возвращает параметры указания серий для товаров, указанных в документе.
//
// Параметры:
//  Объект - Структура - структура значений реквизитов объекта, необходимых для заполнения параметров указания серий.
// 
// Возвращаемое значение:
//  Произвольный - параметры указания серий
//
Функция ПараметрыУказанияСерий(Объект) Экспорт
	
	Возврат ИнтеграцияИС.ПараметрыУказанияСерий(Метаданные.РегистрыСведений.НомераПартийГИСМТ, Объект);
	
КонецФункции

//Имена реквизитов, от значений которых зависят параметры указания серий
//
//	Возвращаемое значение:
//		Строка - имена реквизитов, перечисленные через запятую
//
Функция ИменаРеквизитовДляЗаполненияПараметровУказанияСерий() Экспорт
	
	Возврат ИнтеграцияИС.ИменаРеквизитовДляЗаполненияПараметровУказанияСерий(Метаданные.РегистрыСведений.НомераПартийГИСМТ);
	
КонецФункции

// Удаляет номера партий с истекшим сроком хранения.
//
Процедура УдалениеНомеровПартийПоСрокуХранения() Экспорт
	
	СрокХранения = Константы.СрокХраненияНомеровПартийГИСМТ.Получить();
	Если СрокХранения = 0 Тогда
		Возврат; // 0 = хранить бессрочно
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СрокХранения", СрокХранения);
	Запрос.УстановитьПараметр("ТекущаяДата",  НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ПустаяСерия",  ОбщегоНазначенияИС.ПустоеЗначениеОпределяемогоТипа("СерияНоменклатуры"));
	
	Запрос.Текст = "ВЫБРАТЬ
		|	НомераПартийГИСМТ.Организация    КАК Организация,
		|	НомераПартийГИСМТ.Номенклатура   КАК Номенклатура,
		|	НомераПартийГИСМТ.Характеристика КАК Характеристика,
		|	НомераПартийГИСМТ.Серия          КАК Серия,
		|	НомераПартийГИСМТ.НомерПартии    КАК НомерПартии
		|ПОМЕСТИТЬ НомераПартийКУдалению
		|ИЗ
		|	РегистрСведений.НомераПартийГИСМТ КАК НомераПартийГИСМТ
		|ГДЕ
		|	НомераПартийГИСМТ.ДатаПроизводства < ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, -&СрокХранения)
		|ИНДЕКСИРОВАТЬ ПО
		|	НомераПартийГИСМТ.Серия";
	
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
		|	НомераПартийГИСМТ.Организация    КАК Организация,
		|	НомераПартийГИСМТ.Номенклатура   КАК Номенклатура,
		|	НомераПартийГИСМТ.Характеристика КАК Характеристика,
		|	НомераПартийГИСМТ.Серия          КАК Серия,
		|	НомераПартийГИСМТ.НомерПартии    КАК НомерПартии
		|ИЗ
		|	НомераПартийКУдалению КАК НомераПартийГИСМТ";
	
	ИнтеграцияИСМППереопределяемый.ПриОпределенииЗапросаУдаленияНомеровПартийГИСМТРегламентнымЗаданием(Запрос);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Попытка
		
		Пока Выборка.Следующий() Цикл
			
			МенеджерЗаписи = СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
			МенеджерЗаписи.Удалить();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

