// 	Массив из ПеречислениеСсылка.СтатусыНомеровПартийГИСМТ - дальнейшие действия
//
Функция ВсеТребующиеОжидания() Экспорт
	
	МассивДействий = Новый Массив;
	
	Возврат МассивДействий;
	
КонецФункции

#КонецОбласти

#КонецЕсли
