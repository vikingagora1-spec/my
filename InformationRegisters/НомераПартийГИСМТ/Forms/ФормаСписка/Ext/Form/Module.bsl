&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	
	Отказ = Истина;
	
	ПараметрыОткрытия = ИнтеграцияИСМПКлиент.ПараметрыОткрытияФормыРезервированияНомеровПартий();
	ПараметрыОткрытия.ВидПродукции        = ВидПродукции;
	ПараметрыОткрытия.Организация         = Организация;
	ПараметрыОткрытия.ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОткрытиеФормыРезервированияЗавершение", ЭтотОбъект);
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		СтрокаТовары = ИнтеграцияИСМПКлиентСервер.НоваяСтрокаТоварыПараметровОткрытияФормыРезервированияНомеровПартий();
		СтрокаТовары.Номенклатура     = Номенклатура;
		СтрокаТовары.Характеристика   = Характеристика;
		СтрокаТовары.Серия            = Серия;
		СтрокаТовары.ДатаПроизводства = ДатаПроизводства;
		СтрокаТовары.GTIN             = GTIN;
		ПараметрыОткрытия.Товары.Добавить(СтрокаТовары);
	КонецЕсли;
	
	ИнтеграцияИСМПКлиент.ОткрытьФормуРезервированияНомеровПартий(ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ОбщегоНазначенияИСКлиент.ВыборСтрокиСпискаКорректен(Элементы.Список, Истина) Тогда
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		ОповеститьОВыборе(ИнтеграцияИСМПКлиент.РезультатВыбораНомерПартии(ТекущиеДанные));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьЗарезервированныеНомераПартий(Команда)
	
	ПараметрыЗапросаДанных = ИнтерфейсИСМПОбщегоНазначенияКлиент.ПараметрыЗапросаДанных();
	ПараметрыЗапросаДанных.Организация             = Организация;
	ПараметрыЗапросаДанных.УникальныйИдентификатор = УникальныйИдентификатор;
	
	ПараметрыЗапросаДанных.ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ЗагрузкаЗарезервированныхНомеровПартийЗавершение", ЭтотОбъект);
		
	ИнтеграцияИСМПКлиент.ЗагрузитьНомераПартийГИСМТ(ПараметрыЗапросаДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПечати = ПараметрыПечатиТекущейСтроки(Элементы.Список.ВыделенныеСтроки[0]);
	ОбработкаКомандыПечатиВыделенныхСтрок(ПараметрыПечати);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьGTINКороба(Команда)
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПечати = ПараметрыПечатиТекущейСтроки(Элементы.Список.ВыделенныеСтроки[0], Истина);
	
	Если Не ЗначениеЗаполнено(ПараметрыПечати.Штрихкод) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Отсутствует GTIN логистической упаковки'"));
		Возврат;
	КонецЕсли;
	ОбработкаКомандыПечатиВыделенныхСтрок(ПараметрыПечати);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработкаКомандыПечатиВыделенныхСтрок(ПараметрыПечати)
	
	ДоступныеТипы = Новый СписокЗначений();
	ДоступныеТипы.Добавить("GS1128");
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ДоступныеТипыШтрихкодовСтрокой", ДоступныеТипы);
	ПараметрыОткрытия.Вставить("ТипУпаковки",    ПредопределенноеЗначение("Перечисление.ТипыУпаковок.МонотоварнаяУпаковка"));
	ПараметрыОткрытия.Вставить("ТипШтрихкода",   ПредопределенноеЗначение("Перечисление.ТипыШтрихкодов.GS1_128"));
	ПараметрыОткрытия.Вставить("РежимГрупповойГенерации", Истина);
	ПараметрыОткрытия.Вставить("ПроверятьЗаполнениеКоличестваВложенныхЕдиниц", Истина);
	
	ПараметрыОткрытия.Вставить("Номенклатура",              ПараметрыПечати.Номенклатура);
	ПараметрыОткрытия.Вставить("Характеристика",            ПараметрыПечати.Характеристика);
	ПараметрыОткрытия.Вставить("ВидимостьШаблонаЭтикетки",  ПараметрыПечати.ВидимостьШаблонаЭтикетки);
	ПараметрыОткрытия.Вставить("Упаковка",                  ПараметрыПечати.Упаковка);
	ПараметрыОткрытия.Вставить("КоличествоВложенныхЕдиниц", ПараметрыПечати.КоличествоВложенныхЕдиниц);
	ПараметрыОткрытия.Вставить("Штрихкод",                  ПараметрыПечати.Штрихкод);
	
	ОткрытьФорму("Обработка.ГенерацияШтрихкодовУпаковок.Форма",
		ПараметрыОткрытия, ЭтотОбъект,,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыПечатиТекущейСтроки(КлючЗаписи, ИспользоватьGTINКороба = Ложь)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить(
		"ВидимостьШаблонаЭтикетки",
		РегистрыСведений.ПулКодовМаркировкиСУЗ.ВидимостьШаблонаЭтикетки());
	ВозвращаемоеЗначение.Вставить("Номенклатура");
	ВозвращаемоеЗначение.Вставить("Характеристика");
	ВозвращаемоеЗначение.Вставить("Упаковка");
	ВозвращаемоеЗначение.Вставить("КоличествоВложенныхЕдиниц");
	ВозвращаемоеЗначение.Вставить("Штрихкод");
	
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, КлючЗаписи);
	
	Если ИспользоватьGTINКороба Тогда
		
		Если ЗначениеЗаполнено(ВозвращаемоеЗначение.Номенклатура) Тогда
			
			ШтрихкодыНоменклатуры = ШтрихкодированиеИС.ШтрихкодыНоменклатуры(ВозвращаемоеЗначение);
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ВидУпаковкиИС", Перечисления.ВидыУпаковокИС.Логистическая);
			НайденныеСтроки = ШтрихкодыНоменклатуры.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() Тогда
				ДатаПроизводства      = Сред(КлючЗаписи.НомерПартии, 15, 6);
				ВнутреннийНомерПартии = Сред(КлючЗаписи.НомерПартии, 21);
				ВозвращаемоеЗначение.Штрихкод = СтрШаблон(
					"(01)%1(10)%2(11)%3",
					НайденныеСтроки[0].GTIN,
					ВнутреннийНомерПартии,
					ДатаПроизводства);
				ВозвращаемоеЗначение.Упаковка = НайденныеСтроки[0].Упаковка;
				Если НайденныеСтроки[0].ТребуетВзвешивания Тогда
					ВозвращаемоеЗначение.Штрихкод = ВозвращаемоеЗначение.Штрихкод + "(3103)0";
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ВозвращаемоеЗначение.Штрихкод = ШтрихкодированиеОбщегоНазначенияИСКлиентСервер.ПартионныйОСУПоНомеруПартии(
			КлючЗаписи.НомерПартии, 0);
		
		Если ЗначениеЗаполнено(ВозвращаемоеЗначение.Номенклатура)
			И ИнтеграцияИС.ПризнакИспользованияУпаковок(ВозвращаемоеЗначение.Номенклатура) Тогда
			
			ШтрихкодыНоменклатуры = ШтрихкодированиеИС.ШтрихкодыНоменклатуры(ВозвращаемоеЗначение);
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ВидУпаковкиИС", Перечисления.ВидыУпаковокИС.Логистическая);
			НайденныеСтроки = ШтрихкодыНоменклатуры.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() Тогда
				ВозвращаемоеЗначение.Упаковка                  = НайденныеСтроки[0].Упаковка;
				ВозвращаемоеЗначение.КоличествоВложенныхЕдиниц = НайденныеСтроки[0].Коэффициент;
			КонецЕсли;
		
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузкаЗарезервированныхНомеровПартийЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытиеФормыРезервированияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
	КоличествоКлючей = Результат.КлючиЗаписей.Количество();
	Если КоличествоКлючей > 0 Тогда
		Элементы.Список.ТекущаяСтрока = Результат.КлючиЗаписей[КоличествоКлючей - 1];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПоПериоду(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.Список,,
		Форма.Период.ДатаНачала,
		ВидСравненияКомпоновкиДанных.БольшеИлиРавно,
		НСтр("ru = 'Дата производства (начало)'"),
		ЗначениеЗаполнено(Форма.Период.ДатаНачала));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.Список,,
		Форма.Период.ДатаОкончания,
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,
		НСтр("ru = 'Дата производства (окончание)'"),
		ЗначениеЗаполнено(Форма.Период.ДатаОкончания));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Характеристика.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Характеристика");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаНеТребуетВниманияГосИС);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>'"));
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Серия.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Серия");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаНеТребуетВниманияГосИС);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<серия не указывается>'"));
	
	//
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Номенклатура.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Элементы.Номенклатура.ПутьКДанным);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаПроблемаГосИС);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<Не сопоставлено>'"));
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормыПриСоздании()
	
	Сутки                             = 60 * 60 * 24;
	Элементы.Характеристика.Видимость = ОбщегоНазначенияИС.ХарактеристикиИспользуются();
	Элементы.Серия.Видимость          = ОбщегоНазначенияИС.СерииИспользуются();
	
	Если РежимВыбора Тогда
		
		Если (ЗначениеЗаполнено(Организация)
			Или ЗначениеЗаполнено(Организации)) Тогда
			Элементы.СтраницыОтборОрганизация.ТолькоПросмотр = Истина;
			Элементы.ОтборОрганизации.КнопкаОчистки = Ложь;
			Элементы.ОтборОрганизация.КнопкаОчистки = Ложь;
		КонецЕсли;
		
		Элементы.Список.РежимВыбора    = Истина;
		Элементы.Список.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
		
		Если ЗначениеЗаполнено(ДатаПроизводства) Тогда
			Элементы.Период.ТолькоПросмотр = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		Период.ДатаНачала = НачалоДня(ТекущаяДатаСеанса() - Сутки);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		Список.Отбор,
		"ДатаПроизводства",
		ВидСравненияКомпоновкиДанных.БольшеИлиРавно,
		Период.ДатаНачала,
		НСтр("ru = 'Дата производства (начало)'"),
		ЗначениеЗаполнено(Период.ДатаНачала));
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
		Список.Отбор,
		"ДатаПроизводства",
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,
		Период.ДатаОкончания,
		НСтр("ru = 'Дата производства (окончание)'"),
		ЗначениеЗаполнено(Период.ДатаОкончания));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьБыстрыйОтборСервер()
	
	СтруктураБыстрогоОтбора = Неопределено;
	Параметры.Свойство("СтруктураБыстрогоОтбора", СтруктураБыстрогоОтбора);
	
	Если СтруктураБыстрогоОтбора <> Неопределено Тогда
		
		СтруктураБыстрогоОтбора.Свойство("Организация", Организация);
		СтруктураБыстрогоОтбора.Свойство("Организации", Организации);
		
		Если ЗначениеЗаполнено(Организации) Тогда
			ОрганизацииПредставление = Строка(Организации);
		Иначе
			ОбщегоНазначенияИСМПКлиентСервер.УстановитьОтборПоОрганизацииИПустомуЗначению(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьСписокВыбораОрганизацииПоСохраненнымНастройкам();
	ОбщегоНазначенияИСКлиентСервер.НастроитьОтборПоОрганизации(
		ЭтотОбъект, Организация, ПрефиксОтборОрганизации(), ПрефиксыОтборОрганизации());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораОрганизацииПоСохраненнымНастройкам()
	
	СобытияФормИСМП.ЗаполнитьСписокВыбораОрганизацииПоСохраненнымНастройкам(ЭтотОбъект, ПрефиксыОтборОрганизации());
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПрефиксыОтборОрганизации()
	
	Префиксы = Новый Массив;
	Префиксы.Добавить("Отбор");
	
	Возврат Префиксы;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПрефиксОтборОрганизации()
	
	Возврат "Отбор";
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ВыборОрганизацииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.СохраненыНастройки Тогда
		ЗаполнитьСписокВыбораОрганизацииПоСохраненнымНастройкам();
	Иначе
		ОбщегоНазначенияИСМПКлиент.ОбработатьВыборОрганизаций(
			ЭтотОбъект, Организации, Истина, ПрефиксОтборОрганизации(), ПрефиксыОтборОрганизации());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПараметрыОткрытияФормы()
	
	ВидПродукции = Параметры.ВидПродукции;
	
	Если Параметры.РежимВыбора Тогда
		АвтоНавигационнаяСсылка = Ложь;
		РежимВыбора = Истина;
		Список.КлючТекущихПользовательскихНастроек = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ДатаПроизводства) Тогда
		Период.ДатаНачала    = Параметры.ДатаПроизводства;
		Период.ДатаОкончания = КонецДня(Параметры.ДатаПроизводства);
		ДатаПроизводства     = Параметры.ДатаПроизводства;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"Номенклатура",
			Параметры.Номенклатура);
		Номенклатура = Параметры.Номенклатура;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Характеристика) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"Характеристика",
			Параметры.Характеристика);
		Характеристика = Параметры.Характеристика;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Серия) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"Серия",
			Параметры.Серия);
		Серия = Параметры.Серия;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.GTIN) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"GTIN",
			Параметры.GTIN);
		GTIN = Параметры.GTIN;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
